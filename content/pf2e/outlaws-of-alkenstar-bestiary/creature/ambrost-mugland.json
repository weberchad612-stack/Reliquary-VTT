    {
      "kind": "ability",
      "name": "Exploit Blunder",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger A creature within 30 feet rolls a critical failure to Strike Mugland\n\n---\n\nEffect With a sneer, Mugland takes advantage of the opening. He makes a ranged dueling pistol or cane pistol Strike against the triggering creature. The creature is Off-Guard to Mugland's attacks (including this one) until the beginning of its next turn. This attack doesn't count toward Mugland's multiple attack penalty, and his multiple attack penalty doesn't apply to this attack."
    },
    {
      "kind": "ability",
      "name": "Slippery Dodge",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger Mugland is hit by a Strike, but wouldn't be hit with a +2 circumstance bonus to AC\n\n---\n\nEffect Mugland gains a +2 circumstance bonus to AC against the triggering attack and the attack misses.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "domain": "ac",
            "key": "RollOption",
            "option": "nimble-dodge",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "circumstance",
          "value": 2,
          "when": [
            "nimble-dodge"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Quick Draw",
      "actions": 1,
      "category": "offensive",
      "text": "Mugland Interacts to draw a weapon, then Strikes with that weapon."
    },
