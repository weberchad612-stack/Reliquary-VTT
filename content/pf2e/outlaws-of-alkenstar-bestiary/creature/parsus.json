    {
      "kind": "ability",
      "name": "Clockwork Necromancy",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "evil",
        "unstable"
      ],
      "text": "Parsus winds their necromechanical innovation (see below) to infuse a corpse-riddled area with necromantic energy. The innovation casts Black Tentacles on a point within 100 feet, causing the dead body parts in a 10-foot burst to briefly animate and scrabble at creatures within the area for 1 round."
    },
    {
      "kind": "ability",
      "name": "Explode",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "manipulate",
        "unstable"
      ],
      "text": "Parsus pushes their necromechanical innovation beyond its normal limits, dealing 10d6 void damage in a 10-foot emanation (DC 31 basic Reflex save). Parsus can choose to include themself in this effect."
    },
    {
      "kind": "ability",
      "name": "Necromantic Winding",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Parsus winds up their necromechanical innovation. They choose an active effect with the necromancy trait that originated from one of their spells or abilities (such as Clockwork Necromancy). The effect's duration extends to the end of Parsus's next turn."
    },
    {
      "kind": "ability",
      "name": "Necromechanical Innovation",
      "category": "offensive",
      "text": "Although a necromancer by training, Parsus recently developed a complex device called a necromechanical innovation. This device allows Parsus to use their Clockwork Necromancy, Explode, and Necromatic Winding abilities. It otherwise functions as an inventor weapon innovation with no modifications."
    }
  ],
