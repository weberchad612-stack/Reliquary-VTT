    {
      "kind": "ability",
      "name": "Deny Advantage",
      "category": "defensive",
      "text": "The gang leader isn't Off-Guard to creatures of 7th level or lower that are Hidden, Undetected, flanking, or using surprise attack.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "override",
            "path": "system.attributes.flanking.offGuardable",
            "value": 7
