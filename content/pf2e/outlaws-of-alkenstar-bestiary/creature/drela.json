    },
    {
      "kind": "ability",
      "name": "Evasion",
      "category": "defensive",
      "text": "When the gang leader rolls a success on a Reflex save, they get a critical success instead.",
      "rules": [
        {
          "key": "note",
          "selector": "reflex",
          "text": "{item|system.description.value}"
        },
        {
          "key": "degree",
          "selector": "reflex",
          "adjust": {
            "success": "one-degree-better"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Nimble Dodge",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger The gang leader is targeted with an attack by an attacker they can see\n\n---\n\nEffect The gang leader gains a +2 circumstance bonus to AC against the triggering attack.",
      "rules": [
        {
          "key": "roll-option",
          "option": "nimble-dodge",
          "domain": "ac",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "circumstance",
          "value": 2,
          "when": [
            "nimble-dodge"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Surprise Attack",
      "category": "defensive",
      "text": "On the first round of combat, if the gang leader rolls Deception or Stealth for initiative, creatures who haven't acted are Off-Guard to the gang leader.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "EphemeralEffect",
            "predicate": [
              "encounter:round:1",
              {
                "lt": [
                  "self:participant:initiative:rank",
                  "target:participant:initiative:rank"
                ]
              },
              {
                "or": [
                  "self:participant:initiative:stat:deception",
                  "self:participant:initiative:stat:stealth"
                ]
              }
            ],
            "selectors": [
              "strike-attack-roll",
              "spell-attack-roll",
              "strike-damage",
              "attack-spell-damage"
            ],
            "uuid": "Compendium.pf2e.conditionitems.Item.Off-Guard"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Brutal Rally",
      "actions": "reaction",
      "category": "offensive",
      "traits": [
        "auditory",
        "emotion",
        "linguistic",
        "mental"
      ],
      "text": "Trigger The gang leader rolls a critical hit against a creature\n\n---\n\nEffect All allies that can see the gang leader gain a +1 circumstance bonus to attack rolls until the start of the gang leader's next turn.\n\nEffect: Brutal Rally"
    },
    {
      "kind": "ability",
      "name": "Gang Up",
      "category": "offensive",
      "text": "Any enemy is Off-Guard against the gang leader's melee attacks due to flanking as long as the enemy is within melee reach of both the gang leader and one of the gang leader's allies.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "add",
            "path": "system.attributes.flanking.canGangUp",
            "value": true
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Quick Draw",
      "actions": 1,
      "category": "offensive",
      "text": "The gang leader Interacts to draw a weapon, then Strikes with that weapon."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The gang leader deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
