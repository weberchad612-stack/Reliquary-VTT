    {
      "kind": "ability",
      "name": "Alter Resistance",
      "actions": "reaction",
      "category": "offensive",
      "text": "Frequency once per hour\n\nTrigger Oriole takes acid, electricity, or sonic damage\n\n---\nEffect Oriole's energy resistance changes to match the triggering damage and immediately applies to the damage.",
      "frequency": {
        "max": 1,
        "per": "PT1H"
      }
    },
    {
      "kind": "ability",
      "name": "Blood Magic",
      "category": "offensive",
      "text": "When Oriole casts Animal Vision, Calm, Charm, Repulsion, Unfettered Pack, Vital Beacon, Wave of Despair, or any of their bloodline spells, their movements are so graceful that they distract foes. This either grants Oriole a +1 status bonus to Diplomacy checks for 1 round or imposes a –1 status penalty on one target's Will saves for 1 round."
    },
    {
      "kind": "ability",
      "name": "Crossblooded Evolution",
      "category": "offensive",
      "text": "While Oriole's sorcerous bloodline comes from a mysterious connection to nymphs in their ancestry, their equally mysterious ancestral connection to proteans influences their spell repertoire such that they can cast Illusory Disguise as well. They can heighten illusory disguise freely."
    },
    {
      "kind": "ability",
      "name": "Legendary Diva",
      "actions": "free",
      "category": "offensive",
      "text": "Frequency once per day\n\nTrigger Oriole succeeds at a Performance check to act, dance, or sing\n\n---\nEffect Oriole critically succeeds at the check instead.",
      "frequency": {
        "max": 1,
        "per": "day"
      }
    },
    {
      "kind": "ability",
      "name": "Many Forms",
      "category": "offensive",
