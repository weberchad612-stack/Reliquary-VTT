      ],
      "text": "Saving Throw DC 25 Fortitude save\n\nMaximum Duration 6 rounds\n\nStage 1 1d4 poison damage and Enfeebled 1 (1 round)\n\nStage 2 2d4 poison damage and enfeebled 1 (1 round)"
    },
