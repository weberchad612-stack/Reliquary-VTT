          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "The sentry designates a single creature they can see and hear, or one they're Tracking, as their prey. The sentry gains a +2 circumstance bonus to Perception checks to Seek the prey and to Survival checks to Track the prey.\n\nThe first time the sentry hits the designated prey in a round, they deal an additional 1d8 precision damage. The sentry also ignores the penalty for making ranged attacks within their second range increment against the prey they're hunting.\n\nThese effects last until the sentry uses Hunt Prey again.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey",
            "option": "hunted-prey",
            "toggleable": true
          }
        },
