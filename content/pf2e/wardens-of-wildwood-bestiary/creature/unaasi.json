      "kind": "ability",
      "name": "Luminant Aura",
      "category": "offensive",
      "traits": [
        "aura",
        "light"
      ],
      "text": "20 feet. The volatile planar energy coursing through a woodblessed's veins fills the area with dim light.",
      "rules": [
