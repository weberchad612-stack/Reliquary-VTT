    },
    {
      "kind": "ability",
      "name": "Reactive Flare",
      "actions": "reaction",
      "category": "offensive",
      "text": "Trigger Unaasi is damaged by a creature within their reach\n\n---\n\nEffect Unaasi temporarily loses control of the planar energy within them. Both they and the triggering creature take 6d6 fire damage (DC 30 basic Reflex save save)."
    },
    {
      "kind": "ability",
      "name": "Scouring Surge",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "fire",
        "primal"
      ],
      "text": "Unaasi unleashes the planar energy coursing through their body for a split-second, dealing 11d6 fire damage (DC 30 basic Reflex save save) to all creatures in their luminant aura. They can't use Scouring Surge again for 1d4 rounds."
    },
    {
      "kind": "ability",
      "name": "Signature Spells",
      "category": "offensive",
      "text": "Unaasi can heighten the following spells freely: Charm, Force Barrage, Resist Energy, Rip the Spirit, Soothe."
    },
    {
      "kind": "ability",
      "name": "Steady Spellcasting",
      "category": "offensive",
      "text": "Unaasi is a confident spellcaster and doesn't easily lose their focus. If a reaction would disrupt their spellcasting action, Unaasi attempts a DC 15 Flat check. If they succeed, their action isn't disrupted."
    },
    {
      "kind": "ability",
      "name": "Tap Planar Gate",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "primal"
      ],
      "text": "Unaasi taps into the planar energy surging through them, using this energy to empower themself or their next attack.\n\n- If their next action is to Stride, Unaasi is launched off the ground and propelled forward. During this Stride, they have a fly Speed equal to their Speed. If they don't end their movement on a solid surface that can support their weight, they fall.\n\n- If their next action is to make a melee or ranged Strike, that Strike deals an additional 3d6 fire damage.\n\n- If their next action is to Cast a Spell, the range of that spell increases by 30 feet, and the area of that spell increases by 10 feet.",
