    {
      "kind": "ability",
      "name": "Dual Soul",
      "category": "offensive",
      "text": "A demon named Xeleria is bound to Metuak's soul. Though the two entities share one body and are a single creature for the purpose of both targeted and area effects, Metuak and Xeleria each have 120 Hit Points. Damage to each is tracked separately. Xeleria's HP is reduced by force, good, and vitality damage, and any damage from a cold iron weapon, a weapon with a ghost touch rune, and any damage originating from the Primordial Flame. All other damage reduces Metuak's HP.\n\nMetuak and Xeleria must both be reduced to 0 HP for Metuak to die and Xeleria to be destroyed. If, at the beginning of Metuak's turn, either Metuak or Xeleria has been reduced to 0 HP but the other hasn't, Metuak and Xeleria each regain 15 healing HP."
    },
    {
      "kind": "ability",
      "name": "Shadow Blend",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "divine",
        "illusion"
      ],
      "text": "Metuak Strides up to twice his Speed. If he ends his movement in an area of dim light, he is Hidden as long as he remains in dim light."
    },
    {
      "kind": "ability",
      "name": "Soul Swipe",
      "actions": 2,
      "category": "offensive",
      "text": "Metuak makes a single hatchet or claw Strike and compares the result to the AC of up to four foes, each of whom must be within his reach. He rolls damage once and applies it to each creature he hits. A Soul Swipe counts as two attacks for his multiple attack penalty. Metuak's hatchet applies its sweep trait against all four targets."
    },
    {
      "kind": "ability",
      "name": "Terrifying Howl",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "auditory"
      ],
      "text": "Metuak unleashes a terrifying howl, attempting to demoralize options=area-effect each creature within 30 feet. These creatures are then immune to Terrifying Howl for 1 minute."
    }
