    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "Pakano designates a single creature he can see and hear, or one he's Tracking, as his prey. He gains a +2 circumstance bonus to Perception checks to Seek his prey and to Survival checks to Track his prey.\n\nThe first time Pakano hits his designated prey in a round, he deals an additional 1d8 precision damage. Pakano also ignores the penalty for making ranged attacks within his second range increment.\n\nThese effects last until Pakano uses Hunt Prey again.",
      "rules": [
        {
          "key": "roll-option",
          "option": "hunted-prey",
          "toggleable": true,
          "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey"
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "survival",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:track",
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "ignore-range-penalty:2",
          "domain": "ranged-attack-roll",
          "when": [
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "first-attack",
          "toggleable": true,
          "label": "PF2E.SpecificRule.Ranger.HuntersEdge.FirstAttack"
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d8",
          "category": "precision",
          "when": [
            "first-attack"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Spear Fighter",
      "category": "offensive",
      "text": "Pakano's spear has the parry weapon trait, and his Strikes with the spear deal an additional 1d6 damage. If he critically hits a creature with a spear, the creature is Clumsy 1 until the start of Pakano's next turn.",
      "rules": [
        {
