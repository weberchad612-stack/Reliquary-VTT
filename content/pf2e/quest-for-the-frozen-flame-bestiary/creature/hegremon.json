    {
      "kind": "ability",
      "name": "Aimed Shot",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "Hegremon makes a single mammoth bow Strike against his prey; he gains a +2 circumstance bonus to the attack roll and ignores his prey's Concealed condition."
    },
    {
      "kind": "ability",
      "name": "Chill Breath",
      "actions": 1,
      "category": "offensive",
      "text": "(cold, evocation, primal) Hegremon breathes out a 15-foot cone of freezing moisture that quickly condenses into ice, dealing 6d6 cold damage. Each creature in the cone must attempt a DC 28 basic Reflex save. A creature that fails its save is also Immobilized and takes 2d6 cold damage at the end of each of its turns until it breaks free (escape dc=28). Hegremon can't use Chill Breath again for 1d4 rounds."
    },
    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "Hegremon designates a single creature he can see and hear, or one he's Tracking, as his prey. Hegremon has a +2 circumstance bonus to Perception checks to Seek his prey and a +2 circumstance bonus to Survival checks to Track his prey. He ignores the penalty to ranged attacks within his second range increment against his prey. The first time Hegremon hits his prey in a round, he inflicts an additional 2d8 precision damage. These effects last until Hegremon uses Hunt Prey again.",
      "rules": [
        {
          "key": "roll-option",
          "option": "hunted-prey",
          "toggleable": true,
          "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey"
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "survival",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:track",
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "ignore-range-penalty:2",
          "domain": "ranged-attack-roll",
          "when": [
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "first-attack",
          "toggleable": true,
          "label": "PF2E.SpecificRule.HuntPrey.FirstHitDamage"
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d8",
          "category": "precision",
          "when": [
            "first-attack"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hunting Shot",
      "actions": 1,
      "category": "offensive",
      "text": "Frequency once per round\n\n---\nEffect Hegremon makes two mammoth bow Strikes against his prey. If both hit, combine their damage for the purposes of resistances and weaknesses. His multiple attack penalty applies to each Strike normally.",
      "frequency": {
        "max": 1,
        "per": "round"
      }
    },
    {
      "kind": "ability",
      "name": "Ice Stride",
      "category": "offensive",
      "text": "Hegremon isn't impeded by difficult terrain caused by snow or ice, nor does he need to attempt Acrobatics checks to keep from falling on slippery ice."
    },
    {
      "kind": "ability",
      "name": "Nature's Edge",
      "category": "offensive",
      "text": "Creatures in natural difficult terrain or on natural uneven ground are Off-Guard to Hegremon."
    },
    {
      "kind": "ability",
      "name": "Penetrating Shot",
      "actions": 2,
      "category": "offensive",
      "text": "Hegremon chooses a target that's giving lesser cover to his prey and makes a mammoth bow Strike against the chosen target and his prey. This attack ignores lesser cover the chosen target provides his prey. Hegremon rolls damage twice and applies it to each creature he hits. A Penetrating Shot counts as two attacks for his multiple attack penalty."
    }
  ]
