  "name": "Effect: Size Up",
  "source": {
    "title": "Pathfinder Lost Omens Hellfire Dispatches",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 1,
  "duration": {
    "value": 1,
    "unit": "days",
    "expiry": "turn-start"
  },
  "text": "Granted by Size Up\n\nYou gain a +2 circumstance bonus to Perception checks when you Sense the Motive of your focus and a +2 circumstance bonus to your Perception DC should your focus attempt to Lie or Feint against you. You gain a +2 circumstance bonus to Deception, Diplomacy, and Intimidation checks against your focus.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "key": "TokenMark",
        "slug": "size-up"
      }
    },
    {
      "key": "modifier",
      "selector": "perception-dc",
      "type": "circumstance",
      "value": 2,
      "when": [
        "origin:mark:size-up",
        {
          "or": [
            "action:feint",
            "action:lie"
          ]
        }
      ]
    },
    {
      "key": "modifier",
      "selector": [
        "deception",
        "diplomacy",
        "intimidation"
      ],
      "type": "circumstance",
      "value": 2,
      "when": [
        "target:mark:size-up"
      ]
    }
  ]
}
