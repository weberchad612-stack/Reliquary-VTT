{
  "kind": "effect",
  "slug": "effect-sanctify-armament",
  "system": "pf2e",
  "name": "Effect: Sanctify Armament",
  "source": {
    "title": "Pathfinder Player Core",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 8,
  "duration": {
    "value": 1,
    "unit": "rounds",
    "expiry": "turn-start"
  },
  "text": "Granted by Sanctify Armament\n\nThe weapon gains the origin's holy or unholy trait. It also deals an additional 2d6 spirit damage to creatures of the opposed trait.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "choices": {
          "ownedItems": true,
          "types": [
            "weapon"
          ]
        },
        "flag": "weapon",
        "key": "ChoiceSet",
        "prompt": "PF2E.SpecificRule.Prompt.Weapon"
      }
    },
    {
      "key": "damage-dice",
      "selector": "{item|flags.system.rulesSelections.weapon}-damage",
      "dice": 2,
      "die": "d6",
      "type": "spirit",
      "when": [
        {
          "or": [
            {
              "and": [
                "parent:origin:trait:holy",
                "target:trait:unholy"
              ]
            },
            {
              "and": [
                "parent:origin:trait:unholy",
                "target:trait:holy"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "strike-trait",
      "mode": "add",
      "traits": [
        "holy"
      ],
      "when": [
        "item:id:{item|flags.system.rulesSelections.weapon}",
        "parent:origin:trait:holy"
      ]
    },
    {
      "key": "strike-trait",
      "mode": "add",
      "traits": [
        "unholy"
      ],
      "when": [
        "item:id:{item|flags.system.rulesSelections.weapon}",
        "parent:origin:trait:unholy"
      ]
    }
  ]
}
