  "text": "Granted by Herald's Weapon\n\nYour chosen weapon or unarmed attack deals spirit damage instead of its regular damage, it gains the sanctified trait, and deals an additional 2d4 spirit damage.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "choices": {
          "attacks": true
        },
        "flag": "weapon",
        "key": "ChoiceSet",
        "prompt": "PF2E.SpecificRule.Prompt.Weapon"
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "DamageAlteration",
        "mode": "override",
        "property": "damage-type",
        "selectors": [
          "{item|flags.system.rulesSelections.weapon}-damage"
        ],
        "slug": "base",
        "value": "spirit"
      }
    },
    {
      "key": "damage-dice",
      "selector": "{item|flags.system.rulesSelections.weapon}-damage",
      "dice": 2,
      "die": "d4",
      "type": "spirit"
    },
    {
      "key": "unsupported",
      "foundry": {
        "itemType": "weapon",
        "key": "ItemAlteration",
        "mode": "add",
        "predicate": [
          "item:slug:{item|flags.system.rulesSelections.weapon}"
        ],
        "property": "traits",
        "value": "sanctified"
      }
    },
    {
      "key": "strike-trait",
      "mode": "add",
      "traits": [
        "holy"
      ],
      "when": [
        "item:slug:{item|flags.system.rulesSelections.weapon}",
        "sanctification:holy"
      ]
    },
    {
      "key": "strike-trait",
      "mode": "add",
      "traits": [
        "unholy"
      ],
      "when": [
        "item:slug:{item|flags.system.rulesSelections.weapon}",
        "sanctification:unholy"
      ]
    }
  ]
