{
  "kind": "effect",
  "slug": "effect-regalia",
  "system": "pf2e",
  "name": "Effect: Regalia",
  "source": {
    "title": "Pathfinder Dark Archive",
    "license": "OGL",
    "from": "foundry-pf2e"
  },
  "level": 1,
  "duration": {
    "unit": "unlimited"
  },
  "text": "Granted by Regalia\n\nYou gain a +1 status bonus to saving throws against fear. If the origin has Regalia as an adept implement, this status bonus applies to mental effects, and you gain a status bonus to damage rolls.\n\nIf the origin has Regalia as a paragon implement, you aren't off-guard from being flanked unless the origin is flanked, and the status penalty you take from being clumsy, enfeebled, frightened, sickened, or stupefied is reduced by 1, unless the origin is affected by the same condition.",
  "rules": [
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "status",
      "value": 1,
      "slug": "regalia-aura",
      "when": [
        {
          "or": [
            "item:trait:fear",
            {
              "and": [
                "item:trait:mental",
                "parent:tag:adept-benefit"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "roll-option",
      "option": "regalia:origin-is-flanked",
      "toggleable": true,
      "label": "PF2E.SpecificRule.Thaumaturge.Implement.Regalia.UnflankableToggle",
      "when": [
        {
          "not": "self:signature:{item|origin.signature}"
        },
        "parent:tag:paragon-benefit"
      ]
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "ActiveEffectLike",
        "mode": "override",
        "path": "system.attributes.flanking.flankable",
        "predicate": [
          {
            "not": "regalia:origin-is-flanked"
          },
          "parent:tag:paragon-benefit"
        ],
        "value": false
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "AdjustModifier",
        "mode": "add",
        "predicate": [
          "parent:tag:paragon-benefit",
          {
            "or": [
              {
                "and": [
                  "penalty:slug:clumsy",
                  "self:condition:clumsy",
                  {
                    "not": "parent:origin:condition:clumsy"
                  }
                ]
              },
              {
                "and": [
                  "penalty:slug:enfeebled",
                  "self:condition:enfeebled",
                  {
                    "not": "parent:origin:condition:enfeebled"
                  }
                ]
              },
              {
                "and": [
                  "penalty:slug:frightened",
                  "self:condition:frightened",
                  {
                    "not": "parent:origin:condition:frightened"
                  }
                ]
              },
              {
                "and": [
                  "penalty:slug:sickened",
                  "self:condition:sickened",
                  {
                    "not": "parent:origin:condition:sickened"
                  }
                ]
              },
              {
                "and": [
                  "penalty:slug:stupefied",
                  "self:condition:stupefied",
                  {
                    "not": "parent:origin:condition:stupefied"
                  }
                ]
              }
            ]
          }
        ],
        "selector": "all",
        "value": 1
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "FlatModifier",
        "predicate": [
          "parent:tag:adept-benefit"
        ],
        "selector": "damage",
        "type": "status",
        "value": "ternary(gte(@item.origin.level,17),4,ternary(gte(@item.origin.level,11),3,2))"
      }
    }
  ]
}
