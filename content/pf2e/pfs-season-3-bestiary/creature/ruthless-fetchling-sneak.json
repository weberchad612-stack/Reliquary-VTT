          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Shadow Slink",
      "actions": 2,
      "category": "offensive",
      "text": "Requirements The fetchling sneak is in an area of dim light or darkness\n\n---\n\nEffect The fetchling sneak sticks to the shadows as it moves to ambush an enemy. The fetchling sneak Strides up to half their Speed and makes a Strike. The sneak's target is Off-Guard against this attack. The fetchling sneak can choose to Stride up to their full speed, but doing causes the sneak to take a -2 penalty to their Strike.",
      "rules": [
        {
          "key": "roll-option",
          "option": "shadow-slink",
          "toggleable": true,
          "label": "Shadow Slink (stride at full speed)"
        },
        {
          "key": "modifier",
          "selector": "attack-roll",
          "type": "untyped",
          "value": -2,
          "when": [
            "shadow-slink"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The ruthless fetchling sneak deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
