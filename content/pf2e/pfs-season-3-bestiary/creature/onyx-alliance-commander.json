    {
      "kind": "ability",
      "name": "Reinforced Loyalty",
      "category": "defensive",
      "text": "The commander is resistant to mind-affecting magics due to their repeated exposure to Marcien Blakros's enchantments. Whenever the commander rolls a success on a Will save against an enchantment or fear effect, they get a critical success instead, unless that effect originated from Marcien. In addition, anytime they gain the Frightened condition, reduce its value by 1.",
      "rules": [
        {
          "key": "note",
          "selector": "will",
          "text": "When you roll a success at a Will save against a fear effect, unless that effect originated from Marcien Blackrose, you get a critical success instead.",
          "when": [
            "fear"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
            "adjustment": {
              "success": "one-degree-better"
            },
            "key": "AdjustDegreeOfSuccess",
            "predicate": [
              "fear"
            ],
            "selector": "will",
            "type": "save"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Shadow Blending",
      "category": "defensive",
      "text": "When the commander is concealed as a result of dim light, the flat check to target them has a DC of 7, not 5."
    },
    {
      "kind": "ability",
      "name": "Shadow Stride",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "illusion",
        "occult",
        "shadow"
      ],
      "text": "Requirements The commander is in dim light\n\n---\n\nEffect The commander Strides. They have a +10-foot status bonus to their Speed during this Stride. The DC from shadow blending increases to DC 11 Flat check during this Stride, and the commander remains Concealed by dim light until the end of the movement, even if they leave dim light during the Stride.",
      "rules": [
