    {
      "kind": "ability",
      "name": "Reinforced Loyalty",
      "category": "defensive",
      "text": "The officer is resistant to mind-affecting magics due to their repeated exposure to Marcien Blakros's enchantments. Whenever the officer rolls a success on a Will save against an enchantment or fear effect, they get a critical success instead, unless that effect originated from Marcien. In addition, anytime they gain the Frightened condition, reduce its value by 1.",
      "rules": [
        {
          "key": "note",
          "selector": "will",
          "text": "When you roll a success at a Will save against a fear effect, unless that effect originated from Marcien Blackrose, you get a critical success instead.",
          "when": [
            "fear"
          ]
        },
        {
          "key": "degree",
          "selector": "will",
          "adjust": {
            "success": "one-degree-better"
          },
          "when": [
            "fear"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Shadow Blending",
      "category": "defensive",
      "text": "When the officer is concealed as a result of dim light, the flat check to target them has a DC of 7, not 5."
    },
    {
      "kind": "ability",
      "name": "Shadow Stride",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "illusion",
        "occult",
        "shadow"
      ],
      "text": "Requirements The officer is in dim light\n\n---\n\nEffect The officer Strides. They have a +10-foot status bonus to their Speed during this Stride. The DC from shadow blending increases to DC 11 Flat check during this Stride, and the officer remains Concealed by dim light until the end of the movement, even if they leave dim light during the Stride.",
      "rules": [
        {
          "key": "roll-option",
          "option": "shadow-stride",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "land-speed",
          "type": "status",
          "value": 10,
          "when": [
            "shadow-stride"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The officer deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    }
