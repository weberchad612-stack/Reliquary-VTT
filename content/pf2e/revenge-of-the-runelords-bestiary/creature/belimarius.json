    {
      "kind": "ability",
      "name": "Immortality",
      "category": "defensive",
      "text": "Belimarius is immortal and immune to the negative effects of aging and disease, and she's resistant to mental damage. Her immortality doesn't prevent her death from other means."
    },
    {
      "kind": "ability",
      "name": "Never Enough",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger A creature within 30 feet casts a spell with the air, earth, fire, metal, water, wood, or void trait that deals damage\n\n---\nEffect Belimarius seethes with jealousy at another spellcaster's magical accomplishments. She regains 25 healing Hit Points, and until the end of her next turn, Belimarius's spell DC increases by 1, and her spell attacks gain a +1 circumstance bonus."
    },
    {
      "kind": "ability",
      "name": "Spell Riposte",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "arcane",
        "concentrate",
        "manipulate"
      ],
      "text": "Trigger Belimarius is the target of a spell she's aware of\n\n---\nEffect Belimarius attempts to counteract the triggering spell with a +35 counteract modifier and a counteract rank of 10. If the triggering spell would be counteracted, it instead continues with the caster as a target instead of Belimarius."
    },
    {
      "kind": "ability",
      "name": "Undying Myth",
      "actions": "free",
      "category": "defensive",
      "text": "Cost all of Belimarius's Mythic Points\n\nTrigger Belimarius would die and has at least 1 Mythic Point\n\n---\nEffect Belimarius remains standing and conscious, and recovers 175 healing Hit Points."
    },
