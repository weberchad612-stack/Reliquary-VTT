    {
      "kind": "ability",
      "name": "Unexpected Parry",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger A creature within Lograsi's reach attempts to Strike Lograsi with a melee weapon\n\n---\nEffect Lograsi attempts a melee Strike against the triggering creature. The triggering creature is Off-Guard to this attack. If the attack is a critical hit, Lograsi disrupts that action. This Strike doesn't count toward his multiple attack penalty, and his multiple attack penalty doesn't apply to this Strike."
    },
    {
      "kind": "ability",
      "name": "Numbing Strike",
      "actions": "free",
      "category": "offensive",
      "traits": [
        "cold",
        "divine"
      ],
      "text": "Trigger Lograsi's Strike hits an Off-Guard creature and deals damage\n\n---\nEffect The target becomes Clumsy 1 and takes a –10 foot status penalty to their Speeds from overwhelming chills that numb their flesh. This lasts until the end of Lograsi's next turn.\n\nEffect: Numbing Strike"
    },
    {
      "kind": "ability",
      "name": "Shadowy Wings",
      "actions": "free",
      "category": "offensive",
      "text": "Trigger Lograsi rolls initiative or Leaps\n\n---\nEffect As one of the favored pawns of the velstrac demagogue Aroggus, Lograsi has been granted a pair of shadowy wings. When he activates his Shadowy Wings, they spring from his back and grant him a 40-foot fly Speed. He can sustain his Shadowy Wings for one round at the start of his turn as a free action. As long as his Shadowy Wings are active, Lograsi gains a +2 status bonus on all Acrobatics and Stealth checks.",
      "rules": [
