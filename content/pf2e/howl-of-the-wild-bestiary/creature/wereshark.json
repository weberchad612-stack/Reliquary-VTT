    {
      "kind": "ability",
      "name": "Curse of the Wereshark",
      "category": "offensive",
      "traits": [
        "curse",
        "primal"
      ],
      "text": "This curse affects only humanoids.\n\n---\n\nSaving Throw DC 18 Fortitude save\n\nOn each full moon, the cursed creature must succeed at another Fortitude save or turn into the same kind of werecreature until dawn.\n\nThe creature is under the GM's control and goes on a rampage for half the night before falling unconscious until dawn.",
      "rules": [
        {
          "key": "note",
          "selector": "jaws-damage",
          "text": "{item|description}"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Fish Fork",
      "actions": 1,
      "category": "offensive",
      "text": "Requirements The wereshark critically hit with a trident Strike on their most recent action this turn\n\n---\nEffect The wereshark digs their trident deep within their target, skewering it before taking a massive bite. The target of the Strike becomes Grabbed (escape dc=18) and takes 1d4 bleed damage, and the wereshark attempts a jaws Strike against it. The wereshark can't use their trident while they have a creature grabbed with it, but they can pull the trident free with a single action that has the manipulate trait.",
