    {
      "kind": "ability",
      "name": "Voice of Nature",
      "category": "interaction",
      "text": "Though the Wardens of the Wild do not speak in words, they can communicate complex concepts flawlessly and wordlessly with any animal, beast, plant, or other creature of the natural world through prolonged eye contact. Sapient creatures with strong ties to the natural world, such as animal instinct barbarians or druids who speak the Wildsong, can somewhat understand a Warden of the Wild, though the meaning can be vague."
    },
    {
      "kind": "ability",
      "name": "Warden's Crown",
      "category": "interaction",
      "text": "A Warden of the Wild's horned crown commands respect from wild creatures. Wild creatures native to a warden's biome automatically improve their attitude toward it by one step (up to friendly) and typically do not take hostile actions towards each other while in the warden's presence."
    },
    {
      "kind": "ability",
      "name": "At-Will Spells",
      "category": "interaction"
    },
    {
      "kind": "ability",
      "name": "Constant Spells",
      "category": "interaction"
    },
    {
      "kind": "ability",
      "name": "+1 To All Saves vs. Primal",
      "category": "defensive",
      "rules": [
        {
          "key": "modifier",
          "selector": "saving-throw",
          "type": "untyped",
          "value": 1,
          "when": [
            "item:trait:primal"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Wild Trickery",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "mental",
        "primal"
      ],
      "text": "Trigger An enemy within 60 feet targets the warden with an attack, spell, or other ability\n\n---\n\nEffect The triggering creature must attempt a DC 45 Will save save. If it fails, the warden redirects the ability to target a different creature in range with a burst of mental laughter; this has no effect if there are no other eligible targets. The triggering creature is then temporarily immune for 24 hours unless it critically failed."
    },
    {
      "kind": "ability",
      "name": "Change Shape",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "polymorph",
        "primal"
      ],
      "text": "---\n\nThe warden transforms his size to Tiny, Small, Medium, or Huge (changing his reach to 0 feet for Tiny, 5 feet for Medium or Large, and 10 feet for Huge). The warden retains his shape but can change his color to any seasonal array.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "option": "change-shape",
            "suboptions": [
              {
                "label": "PF2E.ActorSizeTiny",
                "value": "tiny"
              },
              {
                "label": "PF2E.ActorSizeSmall",
                "value": "small"
              },
              {
                "label": "PF2E.ActorSizeMedium",
                "value": "medium"
              },
              {
                "label": "PF2E.ActorSizeHuge",
                "value": "huge"
              }
            ],
            "toggleable": true
          }
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "CreatureSize",
            "predicate": [
              "change-shape"
            ],
            "value": "{item|flags.system.rulesSelections.changeShape}"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Forest Passage",
      "category": "offensive",
      "text": "The Warden of Forests and Meadows ignores difficult terrain and greater difficult terrain from non-magical foliage."
    },
    {
      "kind": "ability",
      "name": "Fox's Wager",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "mental",
        "primal"
      ],
      "text": "The warden grants a boon to a willing creature he can see other than himself, requesting that the creature promise to use the granted power to destroy or undermine the creations of civilization. The target gains a +1 status bonus to attack rolls and a +5 status bonus to damage against constructs, objects, and structures constructed by humanoids. It also gains a +2 status bonus to Stealth checks against humanoids. The warden can have only one wager granted at a time. The wager ends if the target is captured or dies.\n\nEffect: Fox's Wager"
    },
    {
      "kind": "ability",
      "name": "Idyllic Panorama",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "primal"
      ],
      "text": "Frequency once per hour\n\n---\n\nEffect The warden creates an area of peaceful calm. This is identical to a 5th-rank Mirage depicting a peaceful meadow or forest, except the area is a 200-foot burst.\n\nWhile within the area of an Idyllic Panorama, the warden has significant control over the senses of creatures within the area and can cast Mislead and 2nd-rank Silence at will.",
      "frequency": {
        "max": 1,
        "per": "PT1H"
      }
    },
    {
      "kind": "ability",
      "name": "Magical Pounce",
      "actions": 1,
      "category": "offensive",
      "text": "The warden Strides up to his Speed, Leaps up to his Speed, or casts Translocate; at the end of that movement, the warden Strikes. If the warden began this action Hidden, he remains hidden until after this ability's Strike."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The warden deals an additional 3d6 precision damage to Off-Guard creatures.",
