    {
      "kind": "ability",
      "name": "Ward Contract",
      "category": "defensive",
      "text": "A signed contract carried by Mareshiah (including draped over her horns) is immune to damage from all creatures other than her. Mareshiah is immune to mental effects that would make them destroy, nullify, or alter a contract.",
      "rules": [
        {
          "key": "immunity",
          "type": "custom"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Draft Contract",
      "actions": 3,
      "category": "offensive",
      "traits": [
        "divine",
        "manipulate"
      ],
      "text": "Mareshiah produces an infernal contract for a single living mortal. This contract can grant a wide range of abilities and effects, akin to the power of a wish ritual but fulfilled to the letter by Mareshiah. To receive any of those benefits, the mortal must willingly sign their true name to the contract. At that point, the mortal's soul is bound to Mareshiah and Hell.\n\nWhile the contract is in effect, the victim can't be restored to life except by a wish ritual or similar magic. If the mortal is restored to life by those means, Mareshiah knows which mortal came to life and can locate the creature or creatures who restored the mortal to life for 1 year, gaining the effects of a pinpoint spell. Avoiding the terms of an infernal contract is difficult and often dangerous."
    },
    {
      "kind": "ability",
      "name": "Greater Constrict",
      "actions": 1,
      "category": "offensive",
      "text": "3d6+15 bludgeoning, DC 42 basic Fortitude save\n\nOnly when grabbed by Binding Contract\n\n---"
    },
    {
      "kind": "ability",
      "name": "Infernal Investment",
      "category": "offensive",
      "text": "Mareshiah can cast a 10th-rank innate Scrying spell at will, but only to target a creature with which they have a contract. The target automatically critically fails its save."
    },
    {
      "kind": "ability",
      "name": "Infernal Wound",
      "category": "offensive",
      "traits": [
        "divine"
      ],
      "text": "The wounds from Mareshiah's Strikes resist healing.\n\nA spellcaster or item attempting to use healing magic on a creature damaged by Mareshiah's Strikes must first attempt to counteract infernal wound (DC 42). If it isn't counteracted, the healing has no effect."
    },
