    {
      "kind": "ability",
      "name": "Monologue",
      "actions": "free",
      "category": "offensive",
      "traits": [
        "auditory",
        "concentrate"
      ],
      "text": "Frequency once per round\n\n---\nEffect Grachius ceaselessly expounds upon the ongoing Hellish apocalypse and the futility of his enemies' efforts to stop it. He gains a +1 status bonus to Will saves and a +2 status bonus to damage rolls with his spells. Each time he takes this action again, the bonuses increase by 1 and 2, respectively. The monologue ends (and the bonuses are lost) if Grachius becomes unable to act or speak, or if he ends his turn without having taken this action.",
      "frequency": {
        "max": 1,
        "per": "round"
      }
    },
