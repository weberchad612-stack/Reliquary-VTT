      "kind": "ability",
      "name": "Overwhelming Energy",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "spellshape"
      ],
      "text": "If the next action Grachius uses is to Cast a Spell, the spell ignores 20 resistance to energy damage. This applies to all damage the spell deals, including persistent damage and damage caused by an ongoing effect of the spell. A creature's immunities are unaffected."
