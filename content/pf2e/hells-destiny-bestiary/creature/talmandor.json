    {
      "kind": "ability",
      "name": "Captor's Bane",
      "category": "offensive",
      "traits": [
        "holy"
      ],
      "text": "Talmandor's Strikes deal an additional 2d8 spirit damage against any creature that has hindered another creature—by imposing a penalty to a creature's Speed or imposing the clumsy, Grabbed, Immobilized, Paralyzed, or Restrained conditions (including using an action to extend the duration of a grab) to another creature—since the beginning of Talmandor's last turn. One ally hindered by the target can attempt to break free of one of the hindering effects; they can either attempt a new save against the effect that allows a save or attempt to Escape from the effect as a free action."
    },
    {
      "kind": "ability",
      "name": "Coruscating Charge",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "air",
        "holy",
        "light",
        "spirit"
      ],
      "text": "Talmandor briefly transforms into a luminous cloud, which doubles his resistance to physical damage, grants him immunity to precision damage, and allows him to move through most creatures and tiny cracks. He then Flies his Speed before returning to his solid form.\n\nA burst of searing radiance surrounds Talmandor in a 20-foot burst either before or after he becomes a cloud. Each enemy in the area must succeed at a DC 46 Reflex save save or take 2d8 persistent,spirit damage and be Dazzled until the persistent spirit damage ends. Unholy creatures that fail their save are Blinded for 1 round, after which they're dazzled for the persistent damage's duration.\n\nOnce Talmandor uses this ability, he can't do so again for 1d6 rounds.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "domain": "all",
            "key": "RollOption",
            "option": "coruscating-charge",
            "toggleable": true
          }
        },
        {
          "key": "immunity",
          "type": "precision",
          "when": [
            "coruscating-charge"
          ]
        },
        {
          "key": "resistance",
          "type": "physical",
          "value": 30,
          "when": [
            "coruscating-charge"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Twin-Talon Swipe",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "flourish"
      ],
      "text": "Talmandor makes two claw Strikes, targeting either the same foe or two adjacent targets. Each attack uses Talmandor's current multiple attack penalty. If they both hit the same target, he combines both Strikes' damage and applies resistances and weaknesses only once."
    },
