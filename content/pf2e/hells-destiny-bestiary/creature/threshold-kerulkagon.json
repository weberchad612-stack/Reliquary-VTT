      "kind": "ability",
      "name": "Force an Opening",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate",
        "teleportation"
      ],
      "text": "Frequency once per round\n\n---\nEffect The kerulkagon creates a momentary portal next to a creature within 30 feet and makes a melee Strike through the portal as if the target were within its reach. The target is Off-Guard and gains no cover against the Strike.",
      "frequency": {
        "max": 1,
        "per": "round"
      }
