    {
      "kind": "ability",
      "name": "Mind Worm",
      "category": "offensive",
      "traits": [
        "concentrate",
        "incapacitation",
        "mental",
        "possession"
      ],
      "text": "The bdellavritra spends 10 minutes adjacent to an Unconscious or willing living creature, then attempts to possess its body. This functions as Possession heightened to 9th rank (DC 37 Will save save), except that it has a duration of 1 month. If affected, the host receives new saving throws only at the start of each day. If the host dies, the bdellavritra must attempt a Fortitude save as normal but is only Stunned 2 on a failure (or Stunned 4 on a critical failure)."
    },
    {
      "kind": "ability",
      "name": "Pleasant Voices",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "auditory",
        "concentrate",
        "emotion",
        "mental"
      ],
      "text": "Requirements The bdellavritra isn't possessing a host\n\n---\nEffect One of the bdellavritra's mouths sings to a living creature within 30 feet. Unless the target succeeds at a DC 37 Will save save (with a +4 circumstance bonus if the devil or their allies recently threatened the target), they can't use hostile actions against the bdellavritra for 1 round. The bdellavritra can Sustain this effect for up to 1 hour; each time they do, they can affect an additional target (maximum four targets). Each affected target can attempt a new saving throw to end the effect whenever they can't hear the bdellavritra for 1 round or the devil uses a hostile action against one of them."
    },
    {
      "kind": "ability",
      "name": "Improved Grab",
      "actions": "free",
      "category": "offensive"
    },
    {
      "kind": "spell",
      "name": "Diabolic Pact",
      "rank": 1,
