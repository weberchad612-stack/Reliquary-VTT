    {
      "kind": "ability",
      "name": "Drunken Stumble",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger The drunken Isgeri Slayer is hit with an attack that deals physical damage\n\n---\nEffect The drunken slayer stumbles away from the blow. They gain resistance 2 to the damage of the triggering attack and they can Step. They also take a –1 circumstance penalty to AC for 1 round.\n\nEffect: Drunken Stumble",
      "rules": [
        {
          "key": "roll-option",
          "option": "drunken-stumble",
          "toggleable": true
        },
        {
          "key": "resistance",
          "type": "physical",
          "value": 2,
          "when": [
            "drunken-stumble"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "The Isgeri Slayer designates a single creature they can see and hear, or one they're Tracking, as their prey.\n\nThe slayer gains a +2 circumstance bonus to Perception checks to seek the prey and to Survival checks to track the prey.\n\nThe first time the slayer hits the designated prey in a round, they deal an additional 1d6 precision damage. The slayer also ignores the penalty for making ranged attacks within their second range increment. These effects last until the poacher uses Hunt Prey again.",
      "rules": [
        {
          "key": "roll-option",
          "option": "hunted-prey",
          "toggleable": true,
          "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey"
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "survival",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:track",
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "ignore-range-penalty:2",
          "domain": "ranged-attack-roll",
          "when": [
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "first-attack",
          "toggleable": true,
          "label": "PF2E.SpecificRule.Ranger.HuntersEdge.FirstAttack"
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d6",
          "category": "precision",
          "when": [
            "first-attack"
          ]
        }
      ]
    }
  ],
