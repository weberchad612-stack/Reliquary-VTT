    {
      "kind": "ability",
      "name": "Life to Unlife",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "divine",
        "unholy",
        "void"
      ],
      "text": "Frequency once per minute\n\nTrigger A creature within 30 feet that Illcayna can observe Casts a divine Spell with the healing trait\n\n---\nEffect Illcayna sadistically twists the healing magic against the living. She expends a prepared spell of the same rank as the triggering spell and then attempts to counteract the triggering spell using Religion. If she successfully counteracts the spell, Illcayna consumes the magic and regurgitates it as a 3-action harm spell of the rank of the countered spell.",
      "frequency": {
        "max": 1,
        "per": "PT1M"
      }
    },
    {
      "kind": "ability",
      "name": "Share Blessings",
      "category": "defensive",
      "traits": [
        "disease",
        "divine",
        "unholy"
      ],
      "text": "When Illcayna is destroyed, she explodes in a blast of infectious rot. All creatures in a 10-foot emanation are exposed to pallid plague."
    },
