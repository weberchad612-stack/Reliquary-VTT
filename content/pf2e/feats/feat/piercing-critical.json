{
  "kind": "feat",
  "slug": "piercing-critical",
  "system": "pf2e",
  "name": "Piercing Critical",
  "source": {
    "title": "Pathfinder Guns & Gears",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 18,
  "traits": [
    "gunslinger"
  ],
  "category": "class",
  "text": "Your attacks with your preferred weapons deal especially devastating wounds. When you Strike with a firearm or crossbow for which you have legendary proficiency, you critically succeed if you roll a 19 on the die, as long as that result is a success.",
  "rules": [
    {
      "key": "degree",
      "selector": "strike-attack-roll",
      "adjust": {
        "success": "to-critical-success"
      },
      "when": [
        "check:roll:total:natural:19",
        "item:proficiency:rank:4",
        {
          "or": [
            "item:group:firearm",
            "item:group:crossbow"
          ]
        }
      ]
    }
  ]
}
