{
  "kind": "feat",
  "slug": "woodcraft",
  "system": "pf2e",
  "name": "Woodcraft",
  "source": {
    "title": "Pathfinder Lost Omens Character Guide",
    "license": "OGL",
    "from": "foundry-pf2e"
  },
  "level": 1,
  "traits": [
    "elf"
  ],
  "category": "ancestry",
  "text": "You have a innate familiarity with forested areas. When in a forest or jungle environment, if you roll a critical failure on a Survival skill check to Sense Direction, Subsist, or Cover Tracks, you get a failure instead, and if you roll a success, you get a critical success instead.",
  "rules": [
    {
      "key": "degree",
      "selector": "survival",
      "adjust": {
        "critical-failure": "one-degree-better",
        "success": "one-degree-better"
      },
      "when": [
        {
          "or": [
            "action:sense-direction",
            "action:subsist",
            "action:cover-tracks"
          ]
        },
        {
          "or": [
            "terrain:forest",
            "terrain:jungle"
          ]
        }
      ]
    },
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Elf.Woodcraft.Note",
      "when": [
        {
          "or": [
            "action:sense-direction",
            "action:subsist",
            "action:cover-tracks"
          ]
        }
      ]
    }
  ]
}
