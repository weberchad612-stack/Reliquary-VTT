      "key": "roll-option",
      "option": "enchanting-shot",
      "toggleable": true
    },
    {
      "key": "unsupported",
      "foundry": {
        "damageType": "mental",
        "diceNumber": "max(2,@weapon.system.damage.dice)",
        "dieSize": "d6",
        "key": "DamageDice",
        "predicate": [
          "enchanting-shot",
          {
            "or": [
              "item:group:bow",
              "item:group:crossbow"
            ]
          }
        ],
        "selector": "strike-damage"
      }
    },
