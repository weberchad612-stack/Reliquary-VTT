  "category": "ancestry",
  "text": "Your polite manners and natural ability to comfort others make it easy for you to break down cultural barriers and earn strangers' trust. While you are in a settlement, when you roll a critical failure on a Diplomacy check to Gather Information or Make an Impression, you get a failure instead.",
  "rules": [
    {
      "key": "degree",
      "selector": "diplomacy",
      "adjust": {
        "critical-failure": "one-degree-better"
      },
      "when": [
        "terrain:settlement",
        {
          "or": [
            "action:gather-information",
            "action:make-an-impression"
          ]
        }
      ]
    },
    {
      "key": "note",
      "selector": "diplomacy",
      "text": "PF2E.SpecificRule.Shoony.EsteemedVisitor.Note",
      "when": [
        {
          "or": [
            "action:gather-information",
            "action:make-an-impression"
          ]
        }
      ]
    }
  ]
