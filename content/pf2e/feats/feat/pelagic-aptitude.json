  "category": "ancestry",
  "text": "You've learned special tricks to survive underwater. You gain the trained proficiency rank in Survival.\n\nWhen in an aquatic environment, if you roll a critical failure on a Survival skill check to Sense Direction or Subsist, you get a failure instead.",
  "rules": [
    {
      "key": "note",
      "selector": "survival",
      "text": "When in an aquatic environment, if you roll a critical failure on a Survival skill check to Sense Direction or Subsist, you get a failure instead.",
      "when": [
        "terrain:aquatic",
        {
          "or": [
            "action:sense-direction",
            "action:subsist"
          ]
        }
      ]
    },
    {
      "key": "degree",
      "selector": "survival",
      "adjust": {
        "critical-failure": "one-degree-better"
      },
      "when": [
        "terrain:aquatic",
        {
          "or": [
            "action:sense-direction",
            "action:subsist"
          ]
        }
      ]
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "ActiveEffectLike",
        "mode": "upgrade",
        "path": "system.skills.survival.rank",
        "value": 1
      }
    }
  ]
}
