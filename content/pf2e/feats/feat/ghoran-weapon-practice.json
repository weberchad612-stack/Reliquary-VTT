    {
      "key": "crit-spec",
      "when": [
        {
          "or": [
            "item:trait:ghoran",
            "item:base:glaive",
            "item:base:greatclub",
            "item:base:hatchet",
            "item:base:scythe",
            "item:base:sickle"
          ]
        }
      ]
    }
  ]
