  "text": "You can ignore difficult terrain caused by moving through tight spaces that aren't tight enough to force you to Squeeze. When you roll a critical failure on a check to Squeeze, you get a failure instead, and when you roll a success, you get a critical success instead.",
  "rules": [
    {
      "key": "note",
      "selector": "acrobatics",
      "text": "PF2E.SpecificRule.AdjustDegreeOfSuccess.Squeeze.CriticalFailureSuccessBetter",
      "when": [
        "action:squeeze"
      ]
    },
    {
      "key": "degree",
      "selector": "acrobatics",
      "adjust": {
        "critical-failure": "one-degree-better",
        "success": "one-degree-better"
      },
      "when": [
        "action:squeeze"
      ]
    }
  ]
