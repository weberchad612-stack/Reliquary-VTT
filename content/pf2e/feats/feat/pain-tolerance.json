{
  "kind": "feat",
  "slug": "pain-tolerance",
  "system": "pf2e",
  "name": "Pain Tolerance",
  "source": {
    "title": "Pathfinder #178: Punks in a Powder Keg",
    "license": "OGL",
    "from": "foundry-pf2e"
  },
  "level": 6,
  "rarity": "uncommon",
  "traits": [
    "barbarian",
    "fighter"
  ],
  "category": "class",
  "prerequisites": [
    "expert in Fortitude saves"
  ],
  "text": "Access You're from Alkenstar or the Mana Wastes.\n\n---\n\nYou gain resistance to mental damage equal to half your level and a +1 circumstance bonus to saving throws against effects that would make you Clumsy, Drained, or Enfeebled.",
  "rules": [
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "circumstance",
      "value": 1,
      "when": [
        {
          "or": [
            "inflicts:clumsy",
            "inflicts:drained",
            "inflicts:enfeebled"
          ]
        }
      ]
    },
    {
      "key": "resistance",
      "type": "mental",
      "value": "max(1,floor(@level/2))"
    }
  ]
}
