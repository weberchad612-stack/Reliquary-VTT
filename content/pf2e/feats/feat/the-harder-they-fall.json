  "text": "You make your foes fall painfully when you trip them. When you successfully Trip an Off-Guard foe, your target takes 1d6 bludgeoning damage. On a critical success, the target takes 1d6 bludgeoning damage plus your sneak attack damage.",
  "rules": [
    {
      "key": "roll-option",
      "option": "target:condition:off-guard",
      "toggleable": true,
      "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
    },
    {
      "key": "note",
      "selector": "skill-check",
      "text": "PF2E.SpecificRule.Rogue.TheHarderTheyFall.CriticalSuccess",
      "outcome": [
        "criticalSuccess"
      ],
      "when": [
        "action:trip",
        "target:condition:off-guard"
      ]
    },
    {
      "key": "note",
      "selector": "skill-check",
      "text": "PF2E.SpecificRule.Rogue.TheHarderTheyFall.Success",
      "outcome": [
        "success"
      ],
      "when": [
        "action:trip",
        "target:condition:off-guard"
      ]
    }
  ]
}
