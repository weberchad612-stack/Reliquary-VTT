{
  "kind": "feat",
  "slug": "orc-weapon-familiarity",
  "system": "pf2e",
  "name": "Orc Weapon Familiarity",
  "source": {
    "title": "Pathfinder Player Core",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 1,
  "traits": [
    "orc"
  ],
  "category": "ancestry",
  "text": "In combat, you favor the brutal weapons that are traditional for your orc ancestors. You gain access to all uncommon weapons with the orc trait. You have familiarity with weapons with the orc trait plus the falchion and greataxe—for the purposes of proficiency, you treat any of these that are martial weapons as simple weapons and any that are advanced weapons as martial weapons.\n\nAt 5th level, whenever you get a critical hit with one of these weapons, you get its critical specialization effect.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "definition": [
          {
            "or": [
              {
                "and": [
                  "item:trait:orc",
                  "item:category:martial"
                ]
              },
              "item:base:falchion",
              "item:base:greataxe"
            ]
          }
        ],
        "key": "MartialProficiency",
        "label": "PF2E.SpecificRule.MartialProficiency.MartialOrcWeapons",
        "sameAs": "simple",
        "slug": "martial-orc-weapons"
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "definition": [
          "item:trait:orc",
          "item:category:advanced"
        ],
        "key": "MartialProficiency",
        "label": "PF2E.SpecificRule.MartialProficiency.AdvancedOrcWeapons",
        "sameAs": "martial",
        "slug": "advanced-orc-weapons"
      }
    },
    {
      "key": "crit-spec",
      "when": [
        {
          "gte": [
            "self:level",
            5
          ]
        },
        {
          "or": [
            "item:trait:orc",
            "item:base:falchion",
            "item:base:greataxe"
          ]
        }
      ]
    }
  ]
}
