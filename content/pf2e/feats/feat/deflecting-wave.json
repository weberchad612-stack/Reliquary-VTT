{
  "kind": "feat",
  "slug": "deflecting-wave",
  "system": "pf2e",
  "name": "Deflecting Wave",
  "source": {
    "title": "Pathfinder Rage of Elements",
    "license": "OGL",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 1,
  "traits": [
    "impulse",
    "kineticist",
    "primal",
    "water"
  ],
  "category": "class",
  "actions": "reaction",
  "text": "Trigger You would take acid, bludgeoning, fire, or slashing damage from an enemy's attack, spell, or other hostile effect.\n\nRequirements You're aware of the hostile effect, and you aren't Off-Guard against it.\n\n---\n\nA cascade of water blunts or disperses the incoming attack. You gain resistance to damage from the triggering effect equal to your level if it's bludgeoning or slashing, or double your level if it's acid or fire damage. If the effect deals more than one applicable type of damage, apply the highest resistance, but apply it only once.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "key": "RollOption",
        "option": "deflecting-wave",
        "suboptions": [
          {
            "label": "PF2E.TraitAcid",
            "value": "acid"
          },
          {
            "label": "PF2E.TraitBludgeoning",
            "value": "bludgeoning"
          },
          {
            "label": "PF2E.TraitFire",
            "value": "fire"
          },
          {
            "label": "PF2E.TraitSlashing",
            "value": "slashing"
          }
        ],
        "toggleable": true
      }
    },
    {
      "key": "resistance",
      "type": "{item|flags.system.rulesSelections.deflectingWave}",
      "value": "@level",
      "when": [
        {
          "or": [
            "deflecting-wave:bludgeoning",
            "deflecting-wave:slashing"
          ]
        },
        {
          "not": "self:condition:off-guard"
        }
      ]
    },
    {
      "key": "resistance",
      "type": "{item|flags.system.rulesSelections.deflectingWave}",
      "value": "@level*2",
      "when": [
        {
          "or": [
            "deflecting-wave:acid",
            "deflecting-wave:fire"
          ]
        },
        {
          "not": "self:condition:off-guard"
        }
      ]
    }
  ]
}
