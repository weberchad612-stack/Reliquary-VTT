  "category": "ancestry",
  "text": "You gain access to all uncommon weapons with the kobold trait. You have familiarity with weapons with the kobold trait plus the greatpick, light pick, and pick—for the purposes of proficiency, you treat any of these that are martial weapons as simple weapons and any that are advanced weapons as martial weapons.\n\nAt 5th level, whenever you get a critical hit with one of these weapons, you get its critical specialization effect.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "definition": [
          "item:trait:kobold",
          "item:category:advanced"
        ],
        "key": "MartialProficiency",
        "label": "PF2E.SpecificRule.MartialProficiency.AdvancedKoboldWeapons",
        "sameAs": "martial",
        "slug": "advanced-kobold-weapons"
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "definition": [
          "item:category:martial",
          {
            "or": [
              "item:trait:kobold",
              "item:base:greatpick",
              "item:base:light-pick",
              "item:base:pick"
            ]
          }
        ],
        "key": "MartialProficiency",
        "label": "PF2E.SpecificRule.MartialProficiency.MartialKoboldWeapons",
        "sameAs": "simple",
        "slug": "martial-kobold-weapons"
      }
    },
    {
      "key": "crit-spec",
      "when": [
        {
          "gte": [
            "self:level",
            5
          ]
        },
        {
          "or": [
            "item:trait:kobold",
            "item:base:greatpick",
            "item:base:light-pick",
            "item:base:pick"
          ]
        }
      ]
    }
  ]
