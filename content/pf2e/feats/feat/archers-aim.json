  "text": "You slow down, focus, and take a careful shot. Make a ranged Strike with a weapon in the bow or crossbow weapon group. You gain a +2 circumstance bonus to the attack roll and ignore the target's Concealed condition. If the target is Hidden, reduce the flat check from being hidden from 11 to 5.",
  "rules": [
    {
      "key": "roll-option",
      "option": "archers-aim",
      "toggleable": true
    },
    {
      "key": "modifier",
      "selector": [
        "bow-group-attack-roll",
        "crossbow-group-attack-roll"
      ],
      "type": "circumstance",
      "value": 2,
      "when": [
        "archers-aim",
        "item:ranged"
      ]
    },
    {
      "key": "note",
      "selector": [
        "bow-group-attack-roll",
        "crossbow-group-attack-roll"
      ],
      "text": "PF2E.AttackEffects.IgnoreConcealed",
      "when": [
        "archers-aim",
        "target:condition:concealed"
      ]
    },
    {
      "key": "note",
      "selector": [
        "bow-group-attack-roll",
        "crossbow-group-attack-roll"
      ],
      "text": "PF2E.AttackEffects.ReduceHiddenCheck",
      "when": [
        "archers-aim",
        "target:condition:hidden"
      ]
    }
  ]
}
