          "or": [
            "item:trait:hobgoblin",
            "item:base:composite-longbow",
            "item:base:longbow",
            "item:base:composite-shortbow",
            "item:base:shortbow",
            "item:base:glaive",
            "item:base:longsword"
          ]
        }
      ]
    }
  ]
