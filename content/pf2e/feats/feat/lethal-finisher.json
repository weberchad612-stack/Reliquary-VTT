  ],
  "text": "You stab your foe in a vital organ, possibly killing them outright. Make a Strike. On a success, you forego your Precise Strike damage from the finisher.\n\nInstead, your target takes additional precision damage based on a Fortitude save save against your class DC. If your Strike was a critical hit, the target's saving throw outcome is one degree worse.\n\n---\nCritical Success You deal 6 precision damage.\n\nSuccess You deal 6d6 precision damage.\n\nFailure You deal 12d6 precision damage.\n\nCritical Failure You deal 18d6 precision damage.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "disabledIf": [
          {
            "not": "self:effect:panache"
          }
        ],
        "disabledValue": false,
        "key": "RollOption",
        "label": "PF2E.SpecificRule.Swashbuckler.Finisher.Label",
        "mergeable": true,
        "option": "finisher",
        "suboptions": [
          {
            "label": "PF2E.SpecificRule.Swashbuckler.Finisher.Lethal",
            "value": "lethal"
          }
        ],
        "toggleable": true
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "alwaysActive": true,
        "key": "RollOption",
        "label": "PF2E.SpecificRule.Swashbuckler.Finisher.LethalDamage",
        "option": "lethal-result",
        "predicate": [
          "finisher:lethal"
        ],
        "suboptions": [
          {
            "label": "PF2E.Check.Result.Degree.Check.criticalSuccess",
            "value": "critical-success"
          },
          {
            "label": "PF2E.Check.Result.Degree.Check.success",
            "value": "success"
          },
          {
            "label": "PF2E.Check.Result.Degree.Check.failure",
            "value": "failure"
          },
          {
            "label": "PF2E.Check.Result.Degree.Check.criticalFailure",
            "value": "critical-failure"
          }
        ],
        "toggleable": true
      }
    },
    {
