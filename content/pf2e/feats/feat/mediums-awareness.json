{
  "kind": "feat",
  "slug": "mediums-awareness",
  "system": "pf2e",
  "name": "Medium's Awareness",
  "source": {
    "title": "Pathfinder War of Immortals",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 6,
  "traits": [
    "animist",
    "apparition",
    "divine",
    "wandering"
  ],
  "category": "class",
  "text": "Your apparitions watch over you. You gain a +2 status bonus to Perception checks made to Seek and when using Perception for your initiative roll. At 12th level, this status bonus increases to +3, and at 20th level, to +4.",
  "rules": [
    {
      "key": "modifier",
      "selector": "perception",
      "type": "status",
      "value": "ternary(gte(@level,20),4,ternary(gte(@level,12),3,2))",
      "when": [
        {
          "or": [
            "action:seek",
            "check:type:initiative"
          ]
        }
      ]
    }
  ]
}
