      "option": "fiendish-brand",
      "toggleable": true
    },
    {
      "key": "damage-dice",
      "selector": "melee-strike-damage",
      "dice": 1,
      "die": "d6",
      "type": "bleed",
      "when": [
        "fiendish-brand",
        {
          "or": [
            "item:damage:type:slashing",
            "item:damage:type:piercing"
          ]
        }
