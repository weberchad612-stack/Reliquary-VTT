{
  "kind": "feat",
  "slug": "fey-tracker",
  "system": "pf2e",
  "name": "Fey Tracker",
  "source": {
    "title": "Pathfinder Lost Omens Impossible Lands",
    "license": "OGL",
    "from": "foundry-pf2e"
  },
  "level": 6,
  "rarity": "rare",
  "traits": [
    "gunslinger",
    "investigator",
    "ranger"
  ],
  "category": "class",
  "prerequisites": [
    "Greenwatch Initiate"
  ],
  "text": "You are exceptionally skilled at noticing the subtle techniques fey use to avoid notice. You gain a +2 circumstance bonus to Survival checks to Track fey creatures, to Perception checks to Seek for Hidden fey, and to your Perception DC to resist a fey creature's attempt to Create a Diversion.",
  "rules": [
    {
      "key": "modifier",
      "selector": [
        "survival",
        "perception"
      ],
      "type": "circumstance",
      "value": 2,
      "when": [
        "target:trait:fey",
        {
          "or": [
            "action:track",
            {
              "and": [
                "action:seek",
                "target:condition:hidden"
              ]
            },
            "action:create-a-diversion"
          ]
        }
      ]
    }
  ]
}
