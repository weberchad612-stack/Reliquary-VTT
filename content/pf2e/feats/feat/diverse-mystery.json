                      }
                    ]
                  },
                  {
                    "and": [
                      "self:condition:cursebound:3",
                      {
                        "not": "feature:extreme-curse"
                      }
                    ]
                  },
                  "self:condition:cursebound:4"
                ]
              }
            ],
            "text": "PF2E.SpecificRule.Oracle.Cursebound.MaximumNote"
          }
        ]
      }
    },
