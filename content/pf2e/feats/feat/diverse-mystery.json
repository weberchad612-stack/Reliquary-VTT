    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 16,
  "traits": [
    "oracle"
  ],
  "category": "class",
  "prerequisites": [
    "Advanced Revelation"
  ],
  "text": "You have broadened your understanding of the divine and can tap into the wonders of a different mystery. Select one revelation spell from a mystery other than your own. You can choose only an initial revelation spell or an advanced revelation spell.\n\nThis spell gains the cursebound trait for you, and when you cast it, you gain the Cursebound 1 effects of its mystery in addition to your normal curse effects. Any ability that lets you use a cursebound ability without increasing the severity of your curse also prevents you from gaining this additional curse effect.\n\nYou can't cast your chosen revelation spell if any of the following conditions are true:\n- its mystery's curse effects directly conflict with or negate the effects of your own mystery's curse,\n\n- the curse would have no effect on you (for example, removing an ability from your original mystery that you lack),\n\n- or if either of these criteria would be met once you finish Casting the Spell",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "adjustName": false,
        "choices": {
          "filter": [
            "item:trait:focus",
            "item:trait:oracle",
            {
              "lte": [
                "item:rank",
                3
              ]
            }
          ],
          "itemType": "spell",
          "slugsAsValues": true
        },
        "flag": "diverseMystery",
        "key": "ChoiceSet",
        "prompt": "PF2E.SpecificRule.Prompt.Spell",
        "rollOption": "diverse-mystery"
      }
    },
    {
      "key": "roll-option",
      "option": "used-diverse-mystery",
      "toggleable": true,
      "label": "PF2E.SpecificRule.Oracle.DiverseMystery.Toggle"
    },
    {
      "key": "unsupported",
      "foundry": {
        "itemType": "spell",
        "key": "ItemAlteration",
        "mode": "add",
        "predicate": [
          "item:slug:{item|flags.system.rulesSelections.diverseMystery}"
        ],
        "property": "traits",
        "value": "cursebound"
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "itemType": "spell",
        "key": "ItemAlteration",
        "mode": "add",
        "predicate": [
          "item:slug:{item|flags.system.rulesSelections.diverseMystery}"
        ],
