{
  "kind": "feat",
  "slug": "vicious-fangs",
  "system": "pf2e",
  "name": "Vicious Fangs",
  "source": {
    "title": "Pathfinder Book of the Dead",
    "license": "OGL",
    "from": "foundry-pf2e"
  },
  "level": 8,
  "traits": [
    "archetype"
  ],
  "category": "class",
  "prerequisites": [
    "Vampire Dedication"
  ],
  "text": "You aim for your victim's prominent arteries. Your fangs Strike deals an additional 1d6 persistent bleed damage on a critical hit. At 14th level, the persistent bleed damage increases to 2d6, and at 20th level, the persistent bleed damage increases to 3d6.",
  "rules": [
    {
      "key": "damage-dice",
      "selector": "fangs-damage",
      "dice": "ternary(gte(@level,20),3,ternary(gte(@level,14),2,1))",
      "die": "d6",
      "type": "bleed",
      "critical": true
    },
    {
      "key": "note",
      "selector": "fangs-damage",
      "text": "PF2E.SpecificRule.Vampire.ViciousFangs.Note.Base",
      "outcome": [
        "criticalSuccess"
      ],
      "when": [
        {
          "lte": [
            "self:level",
            13
          ]
        }
      ]
    },
    {
      "key": "note",
      "selector": "fangs-damage",
      "text": "PF2E.SpecificRule.Vampire.ViciousFangs.Note.FourteenthLevel",
      "outcome": [
        "criticalSuccess"
      ],
      "when": [
        {
          "gte": [
            "self:level",
            14
          ]
        },
        {
          "not": {
            "gte": [
              "self:level",
              20
            ]
          }
        }
      ]
    },
    {
      "key": "note",
      "selector": "fangs-damage",
      "text": "PF2E.SpecificRule.Vampire.ViciousFangs.Note.TwentiethLevel",
      "outcome": [
        "criticalSuccess"
      ],
      "when": [
        {
          "gte": [
            "self:level",
            20
          ]
        }
      ]
    }
  ]
