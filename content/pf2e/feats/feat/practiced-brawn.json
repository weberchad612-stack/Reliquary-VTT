{
  "kind": "feat",
  "slug": "practiced-brawn",
  "system": "pf2e",
  "name": "Practiced Brawn",
  "source": {
    "title": "Pathfinder Howl of the Wild",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 1,
  "traits": [
    "centaur"
  ],
  "category": "ancestry",
  "text": "You're accustomed to long days filled with hard physical labor. You gain a +1 circumstance bonus to Athletics checks to Force Open and Shove, and to Fortitude saving throws to resist becoming Fatigued. When you roll a success on an Athletics check to Shove, you get a critical success instead.",
  "rules": [
    {
      "key": "modifier",
      "selector": "athletics",
      "type": "circumstance",
      "value": 1,
      "when": [
        {
          "or": [
            "action:shove",
            "action:force-open"
          ]
        }
      ]
    },
    {
      "key": "modifier",
      "selector": "fortitude",
      "type": "circumstance",
      "value": 1,
      "when": [
        "inflicts:fatigued"
      ]
    },
    {
      "key": "degree",
      "selector": "athletics",
      "adjust": {
        "success": "one-degree-better"
      },
      "when": [
        "action:shove"
      ]
    }
  ]
}
