{
  "kind": "feat",
  "slug": "disillusionment",
  "system": "pf2e",
  "name": "Disillusionment",
  "source": {
    "title": "Pathfinder Lost Omens Hellfire Dispatches",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 0,
  "category": "bonus",
  "prerequisites": [
    "Order of the Rack"
  ],
  "text": "Dreams are pointless illusions you seek to quash. If you roll a success on a saving throw against an illusion or dream effect or a Perception check to disbelieve an illusion, you get a critical success instead. If you roll a critical failure on any of those checks, you get a failure instead.",
  "rules": [
    {
      "key": "degree",
      "selector": "saving-throw",
      "adjust": {
        "critical-failure": "one-degree-better",
        "success": "one-degree-better"
      },
      "when": [
        {
          "or": [
            "item:trait:dream",
            "item:trait:illusion"
          ]
        }
      ]
    },
    {
      "key": "degree",
      "selector": "perception",
      "adjust": {
        "critical-failure": "one-degree-better",
        "success": "one-degree-better"
      },
      "when": [
        "action:disbelieve"
      ]
    }
  ]
}
