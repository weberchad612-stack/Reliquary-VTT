  "text": "You can breathe even in hazardous or sparse air. You can hold your breath for 25 times as long as usual before suffocating. You gain a +1 circumstance bonus to saving throws against inhaled threats, such as inhaled poisons, and if you roll a success on such a saving throw, you get a critical success instead.",
  "rules": [
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "circumstance",
      "value": 1,
      "when": [
        "item:trait:inhaled"
      ]
    },
    {
      "key": "degree",
      "selector": "saving-throw",
      "adjust": {
        "success": "one-degree-better"
      },
      "when": [
        "item:trait:inhaled"
      ]
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "ActiveEffectLike",
        "mode": "upgrade",
        "path": "flags.system.remainingAir.rounds",
        "value": "25 * (5 + @actor.abilities.con.mod)"
      }
    }
  ]
