  "category": "ancestry",
  "maxTakable": "unlimited",
  "text": "You gain one of the following senses available to your inherent animal: darkvision, low-light vision, or scent (imprecise) 30 feet. You must have low-light vision before you can gain darkvision with this feat. If your inherent animal doesn't typically have a specific type of sense, you can't gain that sense with this feat.\n\n---\n\nSpecial You can select this feat multiple times, choosing a different sense each time.",
  "rules": [
    {
      "key": "sense",
      "type": "darkvision",
      "when": [
        "beastkin-senses:darkvision"
      ]
    },
    {
      "key": "sense",
      "type": "low-light-vision",
      "when": [
        "beastkin-senses:low-light-vision"
      ]
    },
    {
      "key": "sense",
      "type": "scent",
      "range": 30,
      "acuity": "imprecise",
      "when": [
        "beastkin-senses:scent"
      ]
    },
    {
      "key": "unsupported",
      "foundry": {
        "choices": [
          {
