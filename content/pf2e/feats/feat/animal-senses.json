            "value": "darkvision"
          },
          {
            "label": "PF2E.Actor.Creature.Sense.Type.LowLightVision",
            "value": "low-light-vision"
          },
          {
            "label": "PF2E.SpecificRule.Beastkin.Senses.Scent",
            "value": "scent"
          }
        ],
        "flag": "animalSenses",
        "key": "ChoiceSet",
        "prompt": "PF2E.SpecificRule.Beastkin.AnimalSenses.Prompt",
