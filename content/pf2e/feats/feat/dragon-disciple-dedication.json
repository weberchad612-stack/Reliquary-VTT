{
  "kind": "feat",
  "slug": "dragon-disciple-dedication",
  "system": "pf2e",
  "name": "Dragon Disciple Dedication",
  "source": {
    "title": "Pathfinder Advanced Player's Guide",
    "license": "OGL",
