  "text": "You aim for your prey's weak spots, making your shot more challenging but dealing more damage if you hit. Make a ranged Strike against your hunted prey at a –2 penalty. You gain a +4 circumstance bonus to damage on that Strike. This bonus increases to +6 at 11th level and +8 at 15th level.",
  "rules": [
    {
      "key": "roll-option",
      "option": "deadly-aim",
      "toggleable": true
    },
    {
      "key": "modifier",
      "selector": "attack-roll",
      "type": "circumstance",
      "value": -2,
      "when": [
        "deadly-aim"
      ]
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "FlatModifier",
        "predicate": [
          "deadly-aim"
        ],
        "selector": "strike-damage",
        "type": "circumstance",
        "value": "match(when(btwn(@actor.level, 8, 10), 4), when(btwn(@actor.level, 11, 14), 6), when(gte(@actor.level, 15), 8))"
      }
    }
  ]
