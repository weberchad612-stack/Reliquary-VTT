  "prerequisites": [
    "Verduran Shadow Dedication",
    "trained in Athletics"
  ],
  "text": "You are as at home in the treetops as you are beneath their branches. You gain a climb Speed of 15 feet when moving through trees, vines, and other foliage. Whenever you succeed at an Athletics check to Climb a tree or an Acrobatics check to Balance on a branch, you get a critical success instead. You aren't Off-Guard while Climbing or Balancing on a tree.",
  "rules": [
    {
      "key": "roll-option",
      "option": "canopy-predator",
      "toggleable": true
    },
    {
      "key": "degree",
      "selector": "athletics",
      "adjust": {
        "success": "to-critical-success"
      },
      "when": [
        "action:climb",
        "canopy-predator"
      ]
    },
    {
      "key": "degree",
      "selector": "acrobatics",
      "adjust": {
        "success": "to-critical-success"
      },
      "when": [
        "action:balance",
        "canopy-predator"
      ]
    },
    {
      "key": "speed",
      "type": "climb",
      "value": 15,
      "when": [
        {
          "or": [
            "canopy-predator",
            "terrain:foliage"
          ]
        }
      ]
    }
  ]
}
