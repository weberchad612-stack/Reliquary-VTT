  "text": "Access You're from Alkenstar or the Mana Wastes.\n\n---\n\nYou've developed control over how your body processes alchemical poisons and drugs. Each of your successful saving throws against an alchemical poison, a drug, or an addiction reduces the stage by 2, or by 1 for a virulent alchemical poison, drug, or addiction. Each critical success reduces the stage by 3, or by 2 for a virulent alchemical poison, drug, or addiction.",
  "rules": [
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Barbarian.InuredToAlchemy.Success",
      "outcome": [
        "success"
      ],
      "when": [
        {
          "or": [
            "drug",
            "addiction",
            {
              "and": [
                "alchemical",
                "poison"
              ]
            }
          ]
        },
        {
          "not": "virulent"
        }
      ]
    },
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Barbarian.InuredToAlchemy.SuccessVirulent",
      "outcome": [
        "success"
      ],
      "when": [
        "virulent",
        {
          "or": [
            "drug",
            "addiction",
            {
              "and": [
                "alchemical",
                "poison"
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Barbarian.InuredToAlchemy.CriticalSuccess",
      "outcome": [
        "criticalSuccess"
      ],
      "when": [
        {
          "or": [
            "drug",
            "addiction",
            {
              "and": [
                "alchemical",
                "poison"
              ]
            }
          ]
        },
        {
          "not": "virulent"
        }
      ]
    },
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Barbarian.InuredToAlchemy.CriticalSuccessVirulent",
      "outcome": [
        "criticalSuccess"
      ],
      "when": [
        "virulent",
        {
          "or": [
            "drug",
            "addiction",
            {
              "and": [
                "alchemical",
                "poison"
              ]
            }
          ]
        }
      ]
    }
  ]
