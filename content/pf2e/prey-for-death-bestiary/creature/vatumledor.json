          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Rushed Transformation",
      "actions": 3,
      "category": "offensive",
      "traits": [
        "concentrate",
        "manipulate",
        "occult",
        "polymorph"
      ],
      "text": "Frequency once per hour\n\n---\nEffect Vatumledor quickly reshapes his body into the form of a generic humanoid figure. This has the effects of humanoid form except that it only lasts 1 minute, and he doesn't gain the +4 status bonus to Deception as the transformation makes use of his own scales and plating to crudely mimic a humanoid form. Vatumledor can Dismiss the effect. Whenever the effect ends, Vatumledor leaves behind scraps of magically conjured flesh, which could give away his presence.",
      "frequency": {
        "max": 1,
        "per": "PT1H"
      }
    },
    {
      "kind": "ability",
      "name": "Smoke Breath",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "occult",
        "poison"
      ],
      "text": "Vatumledor unleashes a 60-foot cone of smoke that deals 16d6 poison damage (DC 39 basic Fortitude save save). The smoke remains for 1 minute, obscuring sight with the effects of mist in the cone's area. He can't use Smoke Breath again for 1d4 rounds."
    },
