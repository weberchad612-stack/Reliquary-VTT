    {
      "kind": "ability",
      "name": "Gummy Hands",
      "category": "defensive",
      "text": "Candies' residue gives Aezar an especially strong grip on her greataxe, which grants her a +2 circumstance bonus to her Reflex DC against attempts to Disarm her.",
      "rules": [
        {
          "key": "modifier",
          "selector": "reflex-dc",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:disarm"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Tooth Decay",
      "category": "defensive",
      "text": "Frequent candy consumption has worsened Aezar's already poor dental health. If she takes 10 or more bludgeoning damage from a single attack or effect, she must attempt a DC 25 Fortitude save save.\n\n---\nSuccess Aezar yells in pain but is otherwise unaffected.\n\nFailure Several of Aezar's teeth break. She takes a –2 penalty to damage with her jaws Strike as well as to Athletics checks made as part of her Grab and Swallow Whole abilities. These penalties last until Aezar is restored to her Hit Point maximum.\n\nCritical Failure As failure, but so many of Aezar's teeth break that the penalty increases to –3 and she takes 1d6-2 persistent,bleed damage.",
      "rules": [
        {
          "key": "roll-option",
          "option": "tooth-decay",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "jaws-damage",
          "type": "untyped",
          "value": -2,
          "when": [
            "tooth-decay"
          ]
        },
        {
          "key": "modifier",
          "selector": "athletics",
          "type": "untyped",
          "value": -2,
          "when": [
            "tooth-decay",
            {
              "or": [
                "action:swallow-whole",
                "action:grapple"
              ]
            }
          ]
        },
        {
          "key": "note",
          "selector": [
            "damage-received"
          ],
          "text": "{item|description}",
          "when": [
            "item:damage:type:bludgeoning"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Glutton's Feast",
      "category": "offensive",
      "text": "If Aezar damages a living creature with her jaws Strike, she gains 1d6 temporary Hit Points for 1 minute\n\nEffect: Glutton's Feast (Aezar)",
      "rules": [
        {
          "key": "note",
          "selector": "jaws-damage",
          "text": "{item|description}"
        },
