    {
      "kind": "ability",
      "name": "Curse of the Werebat",
      "category": "offensive",
      "traits": [
        "curse",
        "primal"
      ],
      "text": "This curse affects only humanoids.\n\n---\nSaving Throw DC 18 Fortitude save\n\nOn each full moon, the cursed creature must succeed at another Fortitude save or turn into the same kind of werecreature until dawn.\n\nThe creature is under the GM's control and goes on a rampage for half the night before falling unconscious until dawn.",
      "rules": [
        {
          "key": "note",
          "selector": "fangs-attack",
          "text": "{item|description}"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Deny Advantage",
      "category": "offensive",
      "text": "Romi isn't Off-Guard to Hidden, Undetected, or flanking creatures of his level or lower, or creatures of his level or lower using surprise attack.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "override",
