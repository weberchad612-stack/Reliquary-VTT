      ]
    },
    {
      "kind": "ability",
      "name": "Moon Frenzy",
      "category": "offensive",
      "traits": [
        "polymorph",
        "primal"
      ],
      "text": "When a full moon appears in the night sky, the werecreature must enter hybrid form, can't Change Shape thereafter, becomes one size larger, increases its reach by 5 feet, and increases the damage of its jaws by 2.\n\nWhen the moon sets or the sun rises, the werecreature returns to humanoid form and is Fatigued for 2d4 hours.\n\nEffect: Moon Frenzy"
    },
