      "kind": "ability",
      "name": "Calculated Bloodletting",
      "actions": "free",
      "category": "offensive",
      "traits": [
        "spellshape"
      ],
      "text": "If your next action is to cast Harm, any living creature that fails its save against that spell is dealt 1d6 persistent,bleed damage. In addition, if that version of harm has an area, you can designate up to 5 living creatures in the area; they're not affected by that casting of harm."
    },
    {
      "kind": "ability",
      "name": "Channel Cataclysm",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "stance"
      ],
      "text": "Tokainen screams in rage, channeling the cataclysmic fury of Scal into her own body as she Interacts to draw a weapon. While she is in this stance, Tokainen gains fast healing 5, immunity to fire, her melee Strikes deal an additional 2d8 fire damage, and she gains access to her Spiral Swing ability. While Tokainen is in this stance, she can't cast spells.",
      "rules": [
        {
          "key": "roll-option",
          "option": "channel-cataclysm",
          "toggleable": true
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "FastHealing",
            "predicate": [
