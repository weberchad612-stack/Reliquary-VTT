    {
      "kind": "ability",
      "name": "Blood Nourishment",
      "actions": 1,
      "category": "offensive",
      "text": "The ugothol uses its three-pronged tongue to drink the blood of an adjacent Restrained or Unconscious creature. The creature gains Drained 1"
    },
    {
      "kind": "ability",
      "name": "Compression",
      "category": "offensive",
      "text": "When the ugothol successfully Squeezes, it moves through the tight space at full speed. Narrow confines are not difficult terrain for an ugothol."
    },
    {
      "kind": "ability",
      "name": "Distracting Illusion",
      "actions": 1,
      "category": "offensive",
      "text": "If Danva's next action is to Cast a Spell, the spell gains the subtle trait. As part of using Distracting Spell, Danva can choose to Create a Diversion, Demoralize, or Feint. If she does so, the spell she casts must have the illusion trait in order to gain the subtle trait."
    },
    {
      "kind": "ability",
      "name": "Revert Form",
      "actions": "free",
      "category": "offensive",
      "text": "Requirements The ugothol is in an assumed form\n\n---\n\nEffect The ugothol resumes its true form. Until the start of its next turn, it gains a +2 status bonus to attack rolls, damage rolls, saving throws, and skill checks.\n\nEffect: Revert Form"
    },
