    {
      "kind": "ability",
      "name": "Clutching Armor",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "arcane"
      ],
      "text": "Trigger A creature attempts to move away from the graveknight\n\n---\nEffect The graveknight's armor animates and attempts to Grab the triggering creature. It makes an Athletics check to Grapple using the graveknight's Athletics modifier – 2.\n\nThe armor can continue to Grapple the creature normally. Since the armor is grappling the creature, the graveknight doesn't need a free hand to do so.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "option": "clutching-armor",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "athletics",
          "type": "untyped",
          "value": -2,
          "when": [
            "action:grapple",
            "clutching-armor"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Reactive Strike",
      "actions": "reaction",
      "category": "defensive"
    },
