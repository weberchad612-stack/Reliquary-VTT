            "value": "{item|flags.system.rulesSelections.idleTransmutation}"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Metal Blink",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "move"
      ],
      "text": "Requirements The assault alloy is adjacent to metal of at least 1 bulk\n\n---\nEffect An assault alloy can liquefy the metals of their body and travel up to their Speed through spaces with contiguous metal, even if it's not uniformly connected (as in a scrap heap or a pile of treasure). This movement doesn't trigger reactions."
