    {
      "kind": "ability",
      "name": "Unerring Location",
      "category": "defensive",
      "text": "The dragon automatically attempts to counteract any teleportation effect that targets them (counteract rank 7th, counteract modifier +25). The dragon can choose to be affected normally instead. Other creatures targeted by the same effect remain affected normally."
    },
    {
      "kind": "ability",
      "name": "Dislocating Breath",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "arcane",
        "teleportation"
      ],
      "text": "The dragon exhales a swirl of energy that pulls creatures apart, dealing 12d6 force damage in a 40-foot cone (DC 33 basic Reflex save save). The dragon can teleport any creature that fails its save, teleporting that creature up to 40 feet (or twice as far on a critical failure) in any direction. The destination must be on the ground and in a space with no hazards. The dragon can't use Dislocating Breath again for 1d4 rounds."
    },
