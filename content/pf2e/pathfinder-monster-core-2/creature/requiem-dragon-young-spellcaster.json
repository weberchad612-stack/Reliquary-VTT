      "kind": "ability",
      "name": "Withhold Death",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "divine"
      ],
      "text": "Trigger The dragon is critically hit by an attack\n\n---\nEffect The dragon resists the loosening of its own soul, preventing some of the damage. The dragon gains resistance 10 to all damage against the triggering attack.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
