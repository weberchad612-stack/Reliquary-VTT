    {
      "kind": "ability",
      "name": "Soul Anchor",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "divine"
      ],
      "text": "A creature within 60 feet would drop to 0 Hit Points\n\n---\nEffect The dragon anchors the triggering creature's soul to its body. The creature remains at 1 Hit Point, becomes Doomed 2, and gains fast healing equal to the dragon's level for 1 minute. The creature becomes temporarily immune to further Soul Anchor usages for 24 hours.\n\nEffect: Soul Anchor"
    },
