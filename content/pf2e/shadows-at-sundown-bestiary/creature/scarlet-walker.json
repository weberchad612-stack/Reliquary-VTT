    {
      "kind": "ability",
      "name": "Eerie Flexibility",
      "category": "offensive",
      "text": "The scarlet walker can fit through tight spaces as if it were a Medium creature. While Squeezing, it can move at its full Speed."
    },
    {
      "kind": "ability",
      "name": "Paralysis",
      "category": "offensive",
      "traits": [
        "incapacitation",
        "occult"
      ],
      "text": "Any living, non-scarlet walker creature hit by a scarlet walker's tentacle Strike must attempt a DC 29 Fortitude save save.\n\n---\n\nCritical Success The creature is unaffected.\n\nSuccess The creature is Slowed 1 for 1 round.\n\nFailure The creature is Paralyzed for 1 round, and is then slowed 1 for 1 round after recovering.\n\nCritical Failure As failure, but the paralysis doesn't automatically end after 1 round. The creature can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save.\n\n---\n\nNote: A DC was not provided for this ability by Paizo. The DC present here is a moderate DC for the creature level according to the Gamemastery Guide creature building Tables."
    }
