          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hungry Rage",
      "actions": "reaction",
      "category": "offensive",
      "traits": [
        "concentrate",
        "emotion",
        "mental"
      ],
      "text": "Trigger Hymmir damages a living creature with his jaws Strike\n\n---\nEffect The taste of flesh and blood throws Hymmir into a violent rage. He gains 9 temporary Hit Points, deals an additional 2 damage with melee Strikes, and takes a -1 penalty to AC for 1 minute.",
      "rules": [
        {
          "key": "modifier",
