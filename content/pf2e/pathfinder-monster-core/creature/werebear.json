            ],
            "selector": "strike-damage"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Mauler",
      "category": "offensive",
      "text": "The werebear gains a +2 circumstance bonus to damage rolls against creatures it has Grabbed.",
