    {
      "kind": "ability",
      "name": "Elemental Resistance",
      "category": "defensive",
      "text": "The jann's elemental resistance applies to cold, electricity, and fire damage, as well as all damage from elemental sources (including environmental damage from the elemental planes and damage from anything with the air, earth, fire, metal, water, or wood trait)."
    },
    {
      "kind": "ability",
      "name": "All Made One",
      "actions": 1,
      "category": "offensive",
      "text": "The jann calls upon all of the elements that make up their being to gain an additional arcane spell they can cast at will and empower their Strikes with the element, dealing an extra 1d4 damage of the listed type. These benefits last until the jann uses this ability again.\n\n- Air Tailwind, 1d4 electricity;\n\n- Earth Pummeling Rubble, 1d4 bludgeoning;\n\n- Fire Breathe Fire, 1d4 fire;\n\n- Metal Thunderstrike, 1d4 electricity;\n\n- Water Hydraulic Push, 1d4 bludgeoning;\n\n- Wood Summon Plant or Fungus, 1d4 piercing.",
