    {
      "kind": "ability",
      "name": "Consume Flesh",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements Augrael is adjacent to the corpse of an undead creature that was destroyed within the last hour.\n\n---\n\nEffect Augrael devours a chunk of the destroyed undead creature and regains 2d6 healing Hit Points.\n\nHe can regain Hit Points from any given corpse only once."
    },
    {
      "kind": "ability",
      "name": "Ghoul Fever",
      "category": "offensive",
      "traits": [
        "disease"
      ],
      "text": "Saving Throw DC 20 Fortitude save\n\n---\n\nStage 1 carrier with no ill effect (1 day)\n\nStage 2 2d6 void damage and regains half as many Hit Points from all healing (1 day)\n\nStage 3 as stage 2 (1 day)\n\nStage 4 2d6 void damage and gains no benefit from healing (1 day)\n\nStage 5 as stage 4 (1 day)\n\nStage 6 dead, and rises as a Ghoul the next midnight."
    },
    {
      "kind": "ability",
      "name": "Paralysis",
      "category": "offensive",
      "traits": [
        "incapacitation",
        "occult"
      ],
      "text": "Any living, non-elf creature hit by Augrael's attack must succeed at a DC 20 Fortitude save save or become Paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "Augrael deals an extra 1d6 precision damage to Off-Guard creatures.",
