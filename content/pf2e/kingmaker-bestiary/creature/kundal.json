    {
      "kind": "ability",
      "name": "Curse of the Werewolf",
      "category": "offensive",
      "traits": [
        "curse",
        "primal"
      ],
      "text": "This curse affects only humanoids.\n\nSaving Throw DC 25 Fortitude save\n\n---\n\nOn each full moon, the cursed creature must succeed at another Fortitude save or turn into a werewolf until dawn.\n\nThe creature is under the GM's control and goes on a rampage for half the night before falling unconscious until dawn.",
      "rules": [
        {
          "key": "note",
          "selector": "jaws-damage",
          "text": "{item|description}"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Moon Frenzy",
      "category": "offensive",
      "traits": [
        "polymorph",
        "primal"
      ],
      "text": "Kundal's moon frenzy functions a bit differently than for typical werecreatures: he doesn't become Large sized, but he does grow much more swift and powerful. His speed increases to 35 feet during moon frenzy and increases the damage of his jaws by +2. In addition, while in moon frenzy, at the start of his turn, Kundal gains an additional reaction that can be used only to make an Attack of Opportunity.",
      "rules": [
        {
          "key": "roll-option",
          "option": "moon-frenzy",
          "toggleable": true,
          "default": true
        },
        {
          "key": "modifier",
          "selector": "jaws-damage",
          "type": "untyped",
          "value": 2,
          "when": [
            "moon-frenzy"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Rip and Drag",
      "actions": 1,
      "category": "offensive",
      "text": "Requirement Kundal damaged a target with his jaws Strike with a previous action this round.\n\n---\nEffect Kundal chews the bitten creature as he attempts to overwhelm them by attempting an Athletics check check against the bitten creature's Fortitude DC.\n\n---\nCritical Success Kundal inflicts 5d6 piercing damage on the target, exposes them to the curse of the werewolf, and can Stride up to half his speed. If his target is Medium or smaller, he drags the target with him into a new adjacent square.\n\nSuccess Kundal inflicts 5d6 piercing damage on the target and exposes them to the curse of the werewolf. He can reposition the target up to five feet into an adjacent square.\n\nFailure As success, except only 2d6 piercing damage.\n\nCritical Failure Kundal fails to inflict any damage."
    },
    {
