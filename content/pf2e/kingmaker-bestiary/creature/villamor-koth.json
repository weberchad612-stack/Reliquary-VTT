    {
      "kind": "ability",
      "name": "Furious Finish",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "rage"
      ],
      "text": "Desperate to finish the fight, Villamor Koth pours all his rage into one final blow. He makes a Strike. If it hits, he gains a circumstance bonus to damage equal to the number of rounds remaining in his Rage (maximum 10). After this Strike, his Rage immediately ends and he is Fatigued until he rests for at least 10 minutes."
    },
    {
      "kind": "ability",
      "name": "Giant's Lunge",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "rage"
      ],
      "text": "Villamor Koth extends his body and prepares to attack foes outside his normal reach. Until his rage ends, all his melee weapons and unarmed attacks gain reach 10. This doesn't increase the reach of any weapon or unarmed attack that already has the reach trait, but it does combine with abilities that increase his reach due to increased size.",
      "rules": [
