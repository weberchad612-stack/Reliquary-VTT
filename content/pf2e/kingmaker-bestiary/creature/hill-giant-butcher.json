          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "menace-prey",
            "action:seek"
          ]
        },
        {
          "key": "modifier",
          "selector": "intimidation",
          "type": "circumstance",
          "value": 2,
          "when": [
            "menace-prey",
            "action:demoralize"
          ]
        }
      ]
    },
