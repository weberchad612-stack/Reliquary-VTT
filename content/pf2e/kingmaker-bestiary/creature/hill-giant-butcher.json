    {
      "kind": "ability",
      "name": "Menace Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "The hill giant butcher designates up to two creatures they can see and hear, or one they're Tracking, as their prey. The hill giant butcher gains a +2 circumstance bonus to Perception checks to Seek the prey and to Intimidation checks to Demoralize the prey. This effect lasts until the hill giant butcher uses Menace Prey again.",
