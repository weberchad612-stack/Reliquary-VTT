    },
    {
      "kind": "ability",
      "name": "Reminder of Doom",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "auditory",
        "concentrate",
        "emotion",
        "linguistic",
        "mental"
      ],
      "text": "The mystic reminds their allies of the punishments awaiting those who fail Yog-Sothoth. The mystic and their allies within 60 feet gain a +2 status bonus to attack rolls and damage rolls until the end of the mystic's next turn.\n\nEffect: Reminder of Doom"
    },
    {
