    },
    {
      "kind": "ability",
      "name": "Outside of Time",
      "category": "defensive",
      "text": "The Thresholder Disciple exists outside of time; they don't age, don't need food or drink to survive, and can't be Quickened or Slowed unless they choose to be."
    },
    {
      "kind": "ability",
      "name": "Flurry of Blows",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "flourish"
      ],
      "text": "Frequency Once per turn\n\n---\n\nEffect The disciple makes two unarmed Strikes. If both hit the same creature, combine their damages for the purposes of resistances and weaknesses. The disciple's multiple attack penalty applies normally to these Strikes.",
      "frequency": {
        "max": 1,
        "per": "turn"
      }
    },
    {
      "kind": "ability",
      "name": "Lurker Stance",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "stance"
      ],
      "text": "The disciple takes the stance of the Lurker at the Threshold, full of menace and danger. The disciple can make lurker claw unarmed attacks. These deal 1d12 slashing damage; are in the brawling group; and have the parry, forceful, and unarmed traits. While in this stance, if the disciple succeeds or critically succeeds at a check to demoralize a target, the target must succeed at a DC 34 Will save saving throw or be Stupefied 1 (Stupefied 3 on a critical failure) for 1 minute.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "option": "lurker-stance",
            "toggleable": true
          }
        },
        {
          "key": "unsupported",
          "foundry": {
            "attackModifier": 29,
            "category": "unarmed",
            "damage": {
              "base": {
                "damageType": "slashing",
                "dice": 2,
                "die": "d12",
                "modifier": 11
              }
            },
            "key": "Strike",
            "label": "PF2E.BattleForm.Attack.LurkerClaw",
            "predicate": [
              "lurker-stance"
            ],
            "slug": "lurker-claw",
            "traits": [
              "forceful",
              "magical",
              "parry",
              "unarmed"
            ]
          }
        },
        {
          "key": "note",
