    {
      "kind": "ability",
      "name": "Curse of the Wererat",
      "category": "offensive",
      "traits": [
        "curse",
        "primal"
      ],
      "text": "This curse affects only humanoids.\n\nSaving Throw DC 34 Fortitude save\n\n---\n\nOn each full moon, the cursed creature must succeed at another Fortitude save or turn into a wererat until dawn.\n\nThe creature is under the GM's control and goes on a rampage for half the night before falling unconscious until dawn.",
