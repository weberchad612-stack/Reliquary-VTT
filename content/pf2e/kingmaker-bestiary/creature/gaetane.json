          "text": "{item|description}"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Deadly Aim",
      "actions": 1,
      "category": "offensive",
      "text": "Requirements Gaetane hasn't attempted a Strike during his turn yet\n\n---\n\nEffect Gaetane makes a ranged Strike against his target at a –2 penalty. He gains a +6 circumstance bonus to damage on that Strike.",
