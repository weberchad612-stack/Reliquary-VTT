            "key": "RollOption",
            "label": "PF2E.SpecificRule.TOTMToggle.OffGuard",
            "option": "target:condition:off-guard",
            "toggleable": "totm"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Trackless Step",
      "category": "offensive",
      "text": "The hateful hermit always gains the benefits of Cover Tracks in natural surroundings, even when moving at full speed."
