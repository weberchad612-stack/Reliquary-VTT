    {
      "kind": "ability",
      "name": "Critical Debilitating Strike",
      "actions": "free",
      "category": "offensive",
      "text": "Trigger Alasen's Strike hits an Off-Guard creature and deals damage.\n\n---\n\nEffect The target becomes Enfeebled 1 or takes a –10-foot status penalty to its Speeds, as chosen by Alasen. On a critical hit, the target must also attempt a DC 34 Fortitude save save.\n\n---\n\nCritical Success The target is unaffected.\n\nSuccess The target is Slowed 1 until the end of Alasen's next turn.\n\nFailure The target is Slowed 2 until the end of Alasen's next turn.\n\nCritical Failure The target is Paralyzed until the end of Alasen's next turn."
    },
    {
      "kind": "ability",
      "name": "Curse of the Weretiger",
      "category": "offensive",
      "traits": [
        "curse",
        "primal"
      ],
      "text": "This curse affects only humanoids.\n\n---\n\nSaving Throw DC 34 Fortitude save\n\nOn each full moon, the cursed creature must succeed at another Fortitude save or turn into the same kind of werecreature until dawn.\n\nThe creature is under the GM's control and goes on a rampage for half the night before falling unconscious until dawn.",
      "rules": [
        {
          "key": "note",
          "selector": "jaws-damage",
          "text": "{item|description}"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Mobility",
      "category": "offensive",
      "text": "When Alasen takes a Stride action to move half her Speed or less, that movement does not trigger reactions."
    },
    {
      "kind": "ability",
      "name": "Moon Frenzy",
      "category": "offensive",
      "traits": [
        "polymorph",
        "primal"
      ],
      "text": "When a full moon appears in the night sky, the werecreature must enter hybrid form, can't Change Shape thereafter, becomes one size larger, increases its reach by 5 feet, and increases the damage of its jaws Strike (or a similar Strike) by 2.\n\nWhen the moon sets or the sun rises, the werecreature returns to humanoid form and is Fatigued for 2d4 hours.\n\nEffect: Moon Frenzy"
    },
