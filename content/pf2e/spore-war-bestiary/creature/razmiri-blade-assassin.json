      "kind": "ability",
      "name": "Nimble Dodge",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger The blade assassin is targeted with a melee or ranged attack by an attacker they can see\n\n---\nEffect The blade assassin gains a +2 circumstance bonus to AC against the triggering attack",
      "rules": [
        {
          "key": "roll-option",
          "option": "nimble-dodge",
          "domain": "ac",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "circumstance",
          "value": 2,
          "when": [
            "nimble-dodge"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Otherworldly Will",
      "category": "defensive",
      "text": "The blade assassin is driven forward by a singular, otherworldly will, guiding their actions. Whenever the blade assassin attempts a Will saving throw against a mental effect that would control or dictate their actions, the blade assassin treats the result of the saving throw as one category better.",
      "rules": [
        {
          "key": "degree",
          "selector": "will",
          "adjust": {
            "all": "one-degree-better"
          },
          "when": [
            {
              "or": [
                "inflicts:controlled",
                "item:slug:command",
                "item:slug:suggestion",
                "item:slug:dominate"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Unexplained Demise",
      "actions": "free",
      "category": "defensive",
      "traits": [
        "divine",
        "emotion",
        "fear",
        "mental"
      ],
      "text": "Trigger The assassin is captured alive\n\n---\nEffect Blood pours from the assassin's ears and nose, and they drop dead on the spot. An adjacent PC who witnesses this unexplained death must succeed at a DC 22 Will save save or become Frightened 1."
    },
    {
      "kind": "ability",
      "name": "Poison Weapon",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements The blade assassin is wielding a piercing or slashing weapon and has a free hand\n\n---\nEffect The blade assassin applies a poison to the weapon."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The blade assassin deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Surprise Attack",
      "category": "offensive",
      "text": "On the first round of combat, creatures that haven't acted yet are Off-Guard to the blade assassin.",
      "rules": [
        {
          "key": "unsupported",
