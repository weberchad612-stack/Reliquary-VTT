      "kind": "ability",
      "name": "Quickened Casting",
      "actions": "free",
      "category": "offensive",
      "traits": [
        "concentrate",
        "spellshape"
      ],
      "text": "Frequency once per day\n\n---\nEffect Alzarius can cast a spell more efficiently. If his next action is to cast a cantrip or a spell up to 4th-rank, he reduces the number of actions it takes to cast it by 1 (minimum 1 action).",
      "frequency": {
        "max": 1,
        "per": "day"
      }
    },
    {
      "kind": "ability",
      "name": "Signature Spells",
      "category": "offensive",
      "text": "Alzarius can cast Aqueous Orb, Cleanse Affliction, Heal, Howling Blizzard, and Ice Storm at a higher rank by spending a spell slot of that rank."
    },
    {
      "kind": "ability",
      "name": "Snowcaster's Legacy",
      "category": "offensive",
      "text": "When Alzarius inflicts damage with a Strike, he deals an additional 2d6 cold damage as shards of ice and blasts of frozen wind slash and buffet the creature struck.",
