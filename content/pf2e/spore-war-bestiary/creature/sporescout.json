    {
      "kind": "ability",
      "name": "Cloak of Subversion",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "divine",
        "mental"
      ],
      "text": "Frequency once per day\n\n---\nEffect The sporescout exudes a sticky layer of subversive spores onto their body. For 1 minute, any creature that touches the sporescout or damages them with an unarmed attack or melee weapon without the reach trait takes 3d6 mental damage as the spores infuse their thoughts with painful and subversive desires to offer servitude to Treerazer.",
      "frequency": {
        "max": 1,
        "per": "day"
      }
    },
    {
      "kind": "ability",
      "name": "Focus Spores",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "divine",
        "incapacitation",
        "mental"
      ],
      "text": "Frequency once per round\n\n---\nEffect The sporescout expels its infectious spores at a creature they can see within 20 feet. The target must immediately attempt a DC 31 Will save save against the sporescout's infectious devotion. If the creature was already stupefied by infectious devotion, they instead become Controlled by the sporescout until the start of the sporescout's next turn.",
      "frequency": {
        "max": 1,
        "per": "round"
      }
    },
