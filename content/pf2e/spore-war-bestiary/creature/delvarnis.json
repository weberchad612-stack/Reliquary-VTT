    {
      "kind": "ability",
      "name": "Counterspell",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger A creature Casts a Spell that Delvarnis knows\n\n---\nEffect Delvarnis expends a spell slot of the same level and then attempts to counteract the triggering spell with a +18 bonus on the check."
    },
    {
      "kind": "ability",
      "name": "Otherworldly Will",
      "category": "defensive",
      "text": "Delvarnis is driven forward by a singular, otherworldly will, guiding their actions. Whenever Delvarnis attempts a Will saving throw against a mental effect that would control or dictate their actions, Delvarnis treats the result of the saving throw as one category better.",
      "rules": [
        {
          "key": "degree",
          "selector": "will",
          "adjust": {
            "all": "one-degree-better"
          },
          "when": [
            {
              "or": [
                "inflicts:controlled",
                "item:slug:command",
                "item:slug:suggestion",
                "item:slug:dominate"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Unexplained Demise",
      "actions": "free",
      "category": "defensive",
      "traits": [
        "divine",
        "emotion",
        "fear",
        "mental"
      ],
      "text": "Trigger Delvarnis is captured alive\n\n---\nEffect Blood pours from Delvarnis' ears and nose, and they drop dead on the spot. An adjacent PC who witnesses this unexplained death must succeed at a DC 27 Will save save or become Frightened 1."
    },
    {
      "kind": "ability",
      "name": "Razmir's Disappointment",
      "category": "offensive",
      "traits": [
        "emotion",
        "fear",
        "mental",
        "occult"
      ],
      "text": "Delvarnis inflicts an additional 4d6 mental damage with melee Strikes made while he wears a mask. On a critical hit with such a Strike, the creature struck becomes Frightened 1.",
