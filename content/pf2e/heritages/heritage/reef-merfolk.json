{
  "kind": "heritage",
  "slug": "reef-merfolk",
  "system": "pf2e",
  "name": "Reef Merfolk",
  "source": {
    "title": "Pathfinder Howl of the Wild",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "ancestry": {
    "name": "Merfolk",
    "ref": "ancestries:ancestry/merfolk"
  },
  "text": "You were raised amid colorful corals and schools of tropical fish. Compared to most merfolk, your body is vividly hued with stripes, spots, and patterns like a clownfish or angelfish. You're used to the occasionally toxic denizens of your home and are bothered little by stings or petty poisons. You gain poison resistance equal to half your level (minimum 1), and each of your successful saving throws against a poison affliction reduces its stage by 2, or by 1 for a virulent poison. Each critical success against an ongoing poison reduces its stage by 3, or by 2 for a virulent poison.",
  "rules": [
    {
      "key": "resistance",
      "type": "poison",
      "value": "max(1,floor(@level/2))"
    },
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Merfolk.ReefMerfolk.SuccessNote",
      "outcome": [
        "success"
      ],
      "when": [
        "item:trait:poison",
        {
          "not": "item:trait:virulent"
        }
      ]
    },
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Merfolk.ReefMerfolk.CriticalSuccessNote",
      "outcome": [
        "criticalSuccess"
      ],
      "when": [
        "item:trait:poison",
        {
          "not": "item:trait:virulent"
        }
      ]
    },
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Merfolk.ReefMerfolk.VirulentSuccessNote",
      "outcome": [
        "success"
      ],
      "when": [
        "item:trait:poison",
        "item:trait:virulent"
      ]
    },
    {
      "key": "note",
      "selector": "saving-throw",
      "text": "PF2E.SpecificRule.Merfolk.ReefMerfolk.VirulentCriticalSuccessNote",
      "outcome": [
        "criticalSuccess"
      ],
      "when": [
        "item:trait:poison",
        "item:trait:virulent"
      ]
    }
  ]
}
