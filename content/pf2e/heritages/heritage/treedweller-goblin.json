  "text": "You have adapted particularly well to living in forested environments. As long as you are in a forest or jungle, you gain a +2 circumstance bonus to Stealth checks to Hide and Sneak, Survival checks to Subsist, and your Survival DC to Cover Tracks.",
  "rules": [
    {
      "key": "modifier",
      "selector": "survival",
      "type": "circumstance",
      "value": 2,
      "when": [
        "action:subsist"
      ]
    },
    {
      "key": "modifier",
      "selector": "stealth",
      "type": "circumstance",
      "value": 2,
      "when": [
        {
          "or": [
            "action:hide",
            "action:sneak"
          ]
        }
      ]
    }
  ]
