    {
      "kind": "ability",
      "name": "Whispers of Weakness",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "cursebound"
      ],
      "text": "Spirits guide Caydserris. He increases his Cursebound value by 1, then targets one creature within 60 feet and gains knowledge of their weaknesses, which of their saving throw modifiers is lowest, and a +2 status bonus to his next attack roll against that foe before the end of his turn; the target is then temporarily immune for 1 day."
