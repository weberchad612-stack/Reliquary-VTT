    {
      "kind": "ability",
      "name": "Florin's Revenge",
      "category": "defensive",
      "text": "On the start of each of Caydserris's turns, after he's gained Charg's final gift, Florin's vengeful soul deals 6d6 spirit damage to him (DC 35 basic Will save save)."
    },
    {
      "kind": "ability",
      "name": "Charg's Blessing",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "curse",
        "cursebound",
        "divine",
        "morph"
      ],
      "text": "Caydserris increases his Cursebound condition's value by 1, then targets a creature he can see within 60 feet. That creature's body distorts and partially transforms, changing limbs into monstrous appendages that are difficult to control. The target must attempt a DC 36 Fortitude save save with the following results; regardless of the save, the target is temporarily immune to Charg's Blessing for 24 hours.\n\n---\nCritical Success The target recovers their body's shape immediately and is unaffected; Caydserris's cursebound condition value increases by 2 instead of 1 for using this ability.\n\nSuccess The target becomes Clumsy 1 for 1 round.\n\nFailure The target becomes clumsy 1 with an unlimited duration.\n\nCritical Failure The target becomes Clumsy 2 with an unlimited duration."
    },
    {
      "kind": "ability",
      "name": "Curse of Ancestral Meddling",
      "category": "offensive",
      "text": "When Caydserris has the Cursebound condition, he becomes Clumsy with a value equal to his cursebound value as Arudora spirits—particularly that of Florin Kindler—vie for control of his mind and hinder his movements.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "allowDuplicate": false,
            "alterations": [
              {
                "mode": "override",
                "property": "badge-value",
                "value": "@actor.conditions.cursebound.value"
              }
            ],
            "inMemoryOnly": true,
            "key": "GrantItem",
            "onDeleteActions": {
              "grantee": "restrict"
            },
            "predicate": [
              "self:condition:cursebound"
            ],
            "reevaluateOnUpdate": true,
            "uuid": "Compendium.pf2e.conditionitems.Item.Clumsy"
          }
        }
      ]
    },
