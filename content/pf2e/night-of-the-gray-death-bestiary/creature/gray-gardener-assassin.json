    {
      "kind": "ability",
      "name": "Anonymity",
      "category": "defensive",
      "text": "The Gray Gardener assassin has a +2 circumstance bonus to Deception checks and saving throws to conceal their identity and a +2 circumstance bonus to their Deception DC against effects that ferret out information about the Gray Gardener's identity."
    },
    {
      "kind": "ability",
      "name": "Gardener's Resolve",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger The Gray Gardener assassin rolls a failure (but not a critical failure) on a Will save against an effect with the mental or fear trait\n\nRequirements The Gray Gardener assassin's features are obscured by a mask or hood\n\n---\n\nEffect The Gray Gardener assassin takes 3d8 mental damage, and the saving throw is a success.",
      "rules": [
        {
          "key": "note",
          "selector": "will",
          "text": "{item|system.description.value}",
          "outcome": [
            "failure"
          ],
          "when": [
            {
              "or": [
                "fear",
                "mental"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Instant Opening",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "The Gray Gardener assassin distracts a creature within 30 feet, using a few choice words or gestures. The creature is Off-Guard against the assassin's attacks until the end of the assassin's next turn. Depending on the distraction, this action gains either the auditory or the visual trait."
    },
    {
      "kind": "ability",
      "name": "Mark for Death",
      "actions": 3,
      "category": "offensive",
      "text": "The Gray Gardener assassin designates a single creature they can see and hear as their mark. This effect lasts until the mark dies or the assassin uses Mark for Death again. The assassin gains a +2 circumstance bonus to Perception checks to Seek the mark and on Deception checks to Feint against the mark. The assassin's melee and ranged Strikes gain the deadly d8 weapon traits when attacking the mark.",
      "rules": [
        {
          "key": "roll-option",
          "option": "mark-for-death",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "mark-for-death"
          ]
        },
        {
          "key": "modifier",
          "selector": "deception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:feint",
            "mark-for-death"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
            "itemType": "melee",
            "key": "ItemAlteration",
            "mode": "add",
            "predicate": [
              "mark-for-death"
            ],
            "property": "traits",
            "value": "deadly-d8"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Poison Weapon",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements The Gray Gardener assassin is wielding a piercing or slashing weapon and has a free hand\n\n---\nEffect The assassin applies a poison to the weapon."
    },
    {
      "kind": "ability",
      "name": "Quick Draw",
      "actions": 1,
      "category": "offensive",
