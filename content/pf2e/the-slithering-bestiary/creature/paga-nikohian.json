    {
      "kind": "ability",
      "name": "Keen Eyes",
      "category": "interaction",
      "text": "Paga gains a +2 circumstance bonus when using the Seek action to find Hidden or Undetected creatures within 30 feet of her.\n\nWhen she targets an opponent that is Concealed from her or hidden, she reduces the DC of the flat check to DC 3 Flat check for a concealed target or DC 9 Flat check for a hidden one.",
      "rules": [
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "target:within-30-feet",
            {
              "or": [
                "target:condition:hidden",
                "target:condition:undetected"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Halfling Luck",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger Paga fails or critically fails a skill check or a saving throw\n\nFrequency once per day\n\n---\n\nEffect Paga rerolls the saving throw and must take the new result.",
      "frequency": {
        "max": 1,
        "per": "day"
      },
      "rules": [
        {
          "key": "note",
          "selector": [
            "saving-throw",
            "skill-check"
          ],
          "text": "{item|system.description.value}",
          "outcome": [
            "criticalFailure",
            "failure"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Feign Harmlessness",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "emotion",
        "occult",
        "visual"
      ],
      "text": "Paga cringes and cowers before a creature within 10 feet that can see her. The target must attempt a DC 28 Will save save.\n\nThe target is then temporarily immune for 1 hour.\n\n---\nCritical Success No effect.\n\nSuccess The creature is Fascinated by Paga until the end of its next turn.\n\nFailure The creature is fascinated by Paga and can't use hostile actions against her until the end of its next turn.\n\nCritical Failure As failure, and the creature isn't temporarily immune to Feign Harmlessness."
    },
    {
      "kind": "ability",
      "name": "Unbreakable Concentration",
      "category": "offensive",
      "text": "Paga's spells are disrupted by reactions only if she is critically hit."
    }
