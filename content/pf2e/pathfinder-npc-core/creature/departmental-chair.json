              "inline-damage"
            ],
            "value": "slashing"
          }
        },
        {
          "key": "damage-dice",
          "selector": [
            "spell-damage",
            "inline-damage"
          ],
          "dice": 1,
          "die": "d6",
          "type": "bleed",
          "when": [
            "paper-pusher",
            "item:damage:category:energy",
            "item:type:spell"
          ]
        }
      ]
    }
  ],
  "text": "All the departmental chair really wants is a chance to quietly do their research. Instead, they've been roped into dealing with every emergency—political, supernatural, or emotional—in the university. They are not thrilled about this.\n\n---\nTrue power comes from knowledge—the power to shape the growth of kingdoms by mere whispers, stay three steps ahead of adversaries, or even know which flora is best for creating untraceable poisons."
