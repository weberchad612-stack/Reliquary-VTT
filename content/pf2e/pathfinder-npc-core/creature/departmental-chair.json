    {
      "kind": "ability",
      "name": "Paper Pusher",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "arcane",
        "concentrate",
        "spellshape"
      ],
      "text": "The departmental chair has spent so much time dealing with bureaucracy recently that papers and forms have worked their way into the chair's spellcasting. If the departmental chair's next action is to Cast a Spell that deals energy damage, the spell conjures a burst of sharp-edged paper instead. Change the damage type to slashing, and the spell deals an additional 1d6 persistent bleed damage.",
      "rules": [
        {
