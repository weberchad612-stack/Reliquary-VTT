    {
      "kind": "ability",
      "name": "Gaming Arsenal",
      "category": "interaction",
      "text": "The high roller treats all game tools—such as cards (used in the stat block's Strike entries), dice, coins, and gambling tokens—as melee weapons with a d4 damage die and the agile, finesse and thrown 20 feet traits. The high roller gets a +1 item bonus to attack rolls with them and deals two damage dice. The damage type depends on the item and is determined by the GM."
    },
    {
      "kind": "ability",
      "name": "+4 to Sense Motive",
      "category": "defensive",
      "rules": [
        {
          "key": "modifier",
          "selector": "perception",
          "type": "untyped",
          "value": 4,
          "when": [
            "action:sense-motive"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Tip the Scales",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "divine",
        "fortune"
      ],
      "text": "Trigger A creature the high roller is observing critically fails a check\n\n---\nEffect The high roller picks up on luck that others dropped. They roll twice on their next d20 roll before the end of their next turn and take the better result."
    },
    {
      "kind": "ability",
      "name": "Lucky Momentum",
      "actions": 1,
      "category": "offensive",
      "text": "Requirements The high roller's last action was a critical success\n\n---\nEffect The high roller either Strides twice or attempts a Strike that deals an additional 4d6 precision damage and deals half damage on a failure (but not a critical failure).",
      "rules": [
        {
          "key": "roll-option",
          "option": "lucky-momentum",
          "domain": "damage",
          "toggleable": true
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 4,
          "die": "d6",
          "category": "precision",
          "when": [
            "lucky-momentum"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Royal Flush Flurry",
      "actions": 2,
      "category": "offensive",
      "text": "Frequency once per hour\n\nRequirements The high roller has at least 16 cards in one hand\n\n---\nEffect The high roller unleashes the cards in a 30-foot cone, dealing 16d4 slashing damage to all creatures in the area with a DC 30 basic Reflex save save. This ability expends the full deck of cards held.",
      "frequency": {
        "max": 1,
        "per": "PT1H"
      }
    }
  ],
  "text": "Those with a particular mastery over luck can make a living through games of chance as professional gamblers.\n\n---\nThese lone wolves have an aura of mystery, bravado, and swagger."
