    {
      "kind": "ability",
      "name": "Noble's Ally",
      "category": "interaction",
      "text": "The spy has positioned themself to seem a trusted ally, gaining a +2 circumstance bonus to gather-information options=nobles-ally or to make-an-impression options=nobles-ally among the nobles of that court.",
      "rules": [
        {
          "key": "modifier",
          "selector": "skill-check",
          "type": "circumstance",
          "value": 2,
          "when": [
            "nobles-ally",
            {
              "or": [
                "action:gather-information",
                "action:make-an-impression"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hidden Blade",
      "actions": 1,
      "category": "offensive",
      "text": "Frequency once per round\n\n---\n\nEffect The spy draws a weapon and then Strikes with it. The target of the strike is Off-Guard against the attack.",
      "frequency": {
        "max": 1,
        "per": "round"
      },
      "rules": [
        {
          "key": "roll-option",
          "option": "hidden-blade",
          "toggleable": true
        },
        {
          "key": "ephemeral",
          "selector": [
            "strike-attack-roll",
            "strike-damage"
          ],
          "affects": "target",
          "condition": "off-guard",
          "when": [
            "hidden-blade"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The spy deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    }
  ],
  "text": "Any number of nobles could be spies—a beloved confidante of the queen or even the court jester. Spies use their skills to subtly manipulate courtiers, turn enemies against one another, and collect valuable information.\n\n---\nThe denizens of a noble court are the most powerful people in a civilization, primed with wealth, station, and authority above the common people."
