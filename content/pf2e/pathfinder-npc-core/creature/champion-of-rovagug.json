        }
      ]
    },
    {
      "kind": "ability",
      "name": "Axe Swipe",
      "actions": 2,
      "category": "offensive",
      "text": "The champion makes a melee Strike with a +1 circumstance bonus to the attack roll and compares the roll to the AC of up to two foes that are in reach and adjacent to each other. The champion rolls damage only once and applies it to each creature they hit. This counts as two attacks toward their multiple attack penalty.",
