    {
      "kind": "ability",
      "name": "Blood and Fear",
      "actions": 2,
      "category": "offensive",
      "text": "The interrogator Strikes with a slashing melee weapon. If they hit and deal damage, the target takes an additional 1d4 persistent bleed damage and is Frightened 1 (or 2d4 persistent bleed damage and Frightened 2 on a critical hit).\n\nEach of the interrogator's other enemies in a 30-foot emanation around the target that witnesses the bloodshed must succeed at a DC 19 Will save save or be frightened 1. The frightened part of this ability is an emotion, fear, mental, and visual effect.",
      "rules": [
        {
          "key": "roll-option",
          "option": "blood-and-fear",
          "toggleable": true
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d4",
          "type": "bleed",
          "when": [
            "blood-and-fear",
            "item:damage:type:slashing"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "DamageAlteration",
            "mode": "upgrade",
            "predicate": [
              "check:outcome:critical-success"
            ],
            "property": "dice-number",
            "selectors": [
              "strike-damage"
            ],
            "slug": "blood-and-fear",
            "value": 2
          }
        },
        {
          "key": "note",
          "selector": "strike-damage",
          "text": "{item|description}",
          "outcome": [
            "criticalSuccess"
          ],
          "when": [
            "blood-and-fear",
            "item:damage:type:slashing"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hobble",
      "actions": 1,
      "category": "offensive",
      "text": "Requirements A creature is Grabbed or Restrained by the interrogator\n\n---\nEffect One creature grabbed or restrained by the interrogator takes 2d6 bludgeoning damage with a DC 23 basic Fortitude save save. If the creature fails its save, it also gains a condition of the interrogator's choice: Clumsy 2 for 1 minute, Enfeebled 2 for 1 minute, or Drained 1."
    },
    {
      "kind": "ability",
      "name": "Torment",
      "category": "offensive",
      "text": "The interrogator's Strikes deal an additional 1d8 mental damage to Frightened creatures.",
      "rules": [
        {
          "key": "roll-option",
          "option": "target:condition:frightened",
