    {
      "kind": "ability",
      "name": "Doctor's Hand",
      "category": "interaction",
      "text": "When the peerless healer rolls a critical failure on a check to Treat Disease, Treat Poison, or Treat Wounds, they get a failure instead.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "adjustment": {
              "criticalFailure": "one-degree-better"
            },
            "key": "AdjustDegreeOfSuccess",
            "predicate": [
              {
                "or": [
                  "action:treat-wounds",
                  "action:treat-disease",
                  "action:treat-poison"
                ]
              }
            ],
            "selector": "medicine"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Healing Echo",
      "actions": "free",
      "category": "interaction",
      "traits": [
        "manipulate",
        "vitality"
      ],
      "text": "Trigger The peerless healer restores Hit Points to an ally using Heal\n\n---\nEffect One willing creature within 30 feet who didn't benefit from the triggering spell regains Hit Points equal to half the healing granted. The peerless healer can't use Healing Echo again for 1d4 rounds."
    },
    {
      "kind": "ability",
      "name": "Medical Specialist",
      "category": "interaction",
      "text": "The peerless healer is a 17th-level challenge for contests of medicine."
    },
    {
      "kind": "ability",
      "name": "+2 Status vs. Poison and Disease",
      "category": "defensive",
      "rules": [
