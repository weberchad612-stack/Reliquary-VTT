      "kind": "ability",
      "name": "Stance Shift",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "stance"
      ],
      "text": "The mixed martial artist enters a stance of their choice, gaining the listed circumstance bonus and Strike but losing the ability to make other Strikes.\n- Elbow Knockout Stance +2 to Athletics checks to shove or trip; Melee 1 cross elbow +16 (nonlethal, trip, unarmed) Damage 2d6+8 bludgeoning\n- Secure Grapple Stance +2 to Athletics checks to grapple; Melee 1 grappling limb +16 (grapple, nonlethal, unarmed) Damage 2d4+8 bludgeoning\n- Thrashing Barrage Stance +2 to damage against Off-Guard opponents; Melee 1 thrashing fist +16 (forceful, nonlethal, unarmed) Damage 2d8+8 bludgeoning",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "mergeable": true,
            "option": "stance-shift",
            "suboptions": [
              {
                "label": "PF2E.NPCAbility.MixedMartialArtist.StanceShift.ElbowKnockoutStance",
                "value": "elbow-knockout-stance"
              },
              {
                "label": "PF2E.NPCAbility.MixedMartialArtist.StanceShift.SecureGrappleStance",
                "value": "secure-grapple-stance"
              },
              {
                "label": "PF2E.NPCAbility.MixedMartialArtist.StanceShift.ThrashingBarrageStance",
                "value": "thrashing-barrage-stance"
              }
            ],
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "athletics",
          "type": "untyped",
          "value": 2,
          "slug": "elbow-knockout-athletics",
          "when": [
            "stance-shift:elbow-knockout-stance",
            {
              "or": [
                "action:shove",
                "action:trip"
              ]
            }
          ]
        },
        {
          "key": "modifier",
          "selector": "athletics",
          "type": "untyped",
          "value": 2,
          "slug": "secure-grapple-athletics",
          "when": [
            "stance-shift:secure-grapple-stance",
            "action:grapple"
          ]
        },
        {
          "key": "modifier",
          "selector": "damage",
          "type": "untyped",
          "value": 2,
          "when": [
            "stance-shift:thrashing-barrage-stance",
            "target:condition:off-guard"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
