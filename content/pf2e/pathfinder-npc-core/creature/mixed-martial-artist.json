    {
      "kind": "ability",
      "name": "Takedown Fluidity",
      "actions": "reaction",
      "category": "offensive",
      "text": "Trigger The mixed martial artist's last action was a successful Grapple, Shove, or Trip.\n\n---\nEffect The mixed martial artist uses Stance Shift."
