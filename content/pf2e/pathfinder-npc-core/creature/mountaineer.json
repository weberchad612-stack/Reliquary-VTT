        }
      ]
    },
    {
      "kind": "ability",
      "name": "Lost My Footing",
      "actions": "reaction",
      "category": "interaction",
      "text": "Frequency once per day\n\nTrigger The mountaineer critically fails a check to Balance or Climb\n\n---\nEffect Training kicks in, and the mountaineer catches themself, improving the check from a critical failure to a failure.",
      "frequency": {
        "max": 1,
        "per": "day"
      }
    },
    {
      "kind": "ability",
      "name": "Professional Climber",
      "category": "interaction",
      "text": "While climbing, the mountaineer can have up to five allies Following the Expert and grants a +3 circumstance bonus to Athletics checks to Climb."
    },
    {
      "kind": "ability",
      "name": "Team Awareness",
      "actions": 1,
      "category": "interaction",
      "text": "Requirements A creature is undetected by one or more of the mountaineer's allies but is observed by the mountaineer\n\n---\nEffect The mountaineer Points Out an enemy and makes a Strike against them."
    },
    {
      "kind": "ability",
      "name": "Tuck and Roll",
      "category": "defensive",
      "text": "During an avalanche, the mountaineer gains a +2 circumstance bonus to their Reflex save against bludgeoning damage and natural disasters.",
      "rules": [
        {
          "key": "modifier",
          "selector": "reflex",
          "type": "untyped",
          "value": 2,
          "when": [
            "bludgeoning-damage",
            "natural-disasters"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Arctic Passage",
      "category": "offensive",
      "text": "The mountaineer ignores difficult terrain caused by ice or snow."
    },
    {
      "kind": "ability",
      "name": "Quick Draw",
      "actions": 1,
      "category": "offensive",
      "text": "The mountaineer Interacts to draw their hatchet or pick, then Strikes with the weapon."
