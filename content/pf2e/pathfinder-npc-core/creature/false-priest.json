    {
      "kind": "ability",
      "name": "Deceiver's Surprise",
      "category": "offensive",
      "text": "On the first round of combat, if the false priest rolls Deception or Performance for initiative, creatures that haven't acted yet are Off-Guard to the false priest.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "EphemeralEffect",
            "predicate": [
              "encounter:round:1",
              {
                "lt": [
                  "self:participant:initiative:rank",
                  "target:participant:initiative:rank"
                ]
              },
              {
                "or": [
                  "self:participant:initiative:stat:deception",
                  "self:participant:initiative:stat:performance"
                ]
              }
            ],
            "selectors": [
              "strike-attack-roll",
              "spell-attack-roll",
              "strike-damage",
              "attack-spell-damage"
            ],
            "uuid": "Compendium.pf2e.conditionitems.Item.Off-Guard"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Fickle Prophecy",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "emotion",
        "mental"
      ],
      "text": "The false priest convinces someone of their omnipotence by attempting a Deception check check compared to the creature's Will DC.\n\nIf successful, the target gains 1d8+4 temporary Hit Points that last for 1 hour or until the false priest removes them by rebuking the target, whichever occurs first.\n\nEffect: Fickle Prophecy"
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The false priest deals an extra 1d6 precision damage to Off-Guard creatures. This increases to 2d6 precision damage against creatures off-guard due to the false priest's Feint or deceiver's surprise.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.NPCAbility.FalsePriest.SneakAttack.DeceiversSurprise",
            "option": "deceivers-surprise",
            "toggleable": true
          }
        },
        {
          "key": "unsupported",
          "foundry": {
