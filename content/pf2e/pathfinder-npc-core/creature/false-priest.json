    },
    {
      "kind": "ability",
      "name": "The Jig Is Up",
      "actions": "reaction",
      "category": "offensive",
      "text": "Frequency once per hour\n\nTrigger The false priest critically fails a Deception or Performance check\n\n---\n\nEffect The false priest Strides.",
