    },
    {
      "kind": "ability",
      "name": "Resolve",
      "category": "defensive",
      "text": "When the maestro rolls a success on a Will save, they get a critical success instead.",
      "rules": [
        {
          "key": "degree",
          "selector": "will",
          "adjust": {
            "success": "one-degree-better"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Resonating Weaponry",
      "category": "offensive",
      "text": "The maestro funnels musical energy from their compositions into attacks, dealing additional 1d6 sonic damage with their weapon Strikes on any turn they cast a composition spell.",
      "rules": [
        {
          "key": "roll-option",
          "option": "resonating-weaponry",
          "toggleable": true
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d6",
          "type": "sonic",
          "when": [
            "resonating-weaponry",
            {
              "not": "item:category:unarmed"
            }
          ]
        }
      ]
    }
  ],
  "text": "A maestro is a performer who has achieved true excellence. These virtuosos can inspire those around them to greater heights or strike fear in their enemies' hearts.\n\n---\nPerformances come in a wide variety of forms, from musical methods like singing and instruments to physical dancing and juggling to simple orating and conversing."
