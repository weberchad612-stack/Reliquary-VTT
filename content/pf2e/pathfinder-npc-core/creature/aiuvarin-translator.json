    {
      "kind": "ability",
      "name": "Linguistic Mastery",
      "category": "interaction",
      "text": "The translator gains a +5 circumstance bonus to skill checks involving translating or deciphering languages. If the translator rolls a critical failure on a check to Decipher Writing, they get a failure instead.",
      "rules": [
        {
          "key": "modifier",
          "selector": "skill-check",
          "type": "circumstance",
          "value": 5,
          "when": [
            {
              "or": [
                "action:decipher-language",
                "action:translate"
              ]
            }
          ]
        },
        {
          "key": "degree",
          "selector": "skill-check",
          "adjust": {
            "critical-failure": "one-degree-better"
          },
          "when": [
            "action:decipher-writing"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Translation Specialist",
      "category": "interaction",
      "text": "For encounters involving translating or deciphering languages, the translator is a 4th-level challenge."
    },
    {
      "kind": "ability",
      "name": "Crosstalk",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "auditory",
        "concentrate",
        "linguistic",
        "mental"
      ],
      "text": "Trigger A creature within 20 feet of the translator would be targeted by or in the area of an ability with the linguistic trait\n\n---\nEffect The translator attempts a Performance check check with a +5 circumstance bonus against the Will DC of the creature. On a success, the creature is unaffected by the linguistic effect, and the translator can choose to make the creature Confused until the end of the creature's next turn.",
      "rules": [
        {
          "key": "modifier",
          "selector": "performance",
          "type": "circumstance",
          "value": 5,
          "when": [
            "crosstalk"
          ]
        }
      ]
    }
  ],
  "text": "Many societies recognize aiuvarins' skills as adept translators.\n\n---\nElves' long lives give them centuries to delve into studies, artistry, or exploration."
