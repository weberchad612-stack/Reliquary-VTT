    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "The bounty hunter designates a single creature they can see and hear, or one they're Tracking or Gathering Information about, as their prey. The bounty hunter gains a +2 circumstance bonus to Perception checks to Seek the prey, to Survival checks to Track the prey, and to Diplomacy checks to Gather Information about the prey. This effect lasts until they use Hunt Prey again.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey",
            "option": "hunted-prey",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "survival",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:track",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "diplomacy",
          "type": "circumstance",
          "value": 2,
          "slug": "hunt-prey-gather-information",
          "when": [
            "action:gather-information",
            "hunted-prey"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Posse's Edge",
      "category": "offensive",
      "text": "The bounty hunter and their allies gain a +1 circumstance bonus on initiative rolls if the opposing side includes their hunted prey.\n\nEffect: Posse's Edge"
    },
    {
      "kind": "ability",
      "name": "Precision Edge",
      "category": "offensive",
      "text": "The first time the bounty hunter hits their hunted prey in a round, they deal an additional 1d8 precision damage.",
