            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "stealth",
          "type": "circumstance",
          "value": 2,
          "when": [
            {
              "or": [
                "action:hide",
                "action:sneak"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Spectacular Attack",
      "category": "offensive",
      "text": "All the flamboyant thief's Strikes deal an additional 3d6 precision damage or 6d6 if the target is Fascinated with the thief. After the thief Strikes a creature, that creature becomes fascinated with the thief until the end of the thief's next turn.",
      "rules": [
