    {
      "kind": "ability",
      "name": "Fence's Eye",
      "category": "interaction",
      "text": "Fences can use Underworld-lore check to identify an item's value and Identify Magic on an item. They gain a +2 circumstance bonus to Underworld Lore checks when doing so, and to all Underworld Lore checks related to stolen items.",
      "rules": [
        {
          "key": "modifier",
          "selector": "underworld-lore",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:identify-magic"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Fence's Feint",
      "actions": 1,
      "category": "offensive",
      "text": "The fence Feints, then can Step. If the feint succeeds, the target is Off-Guard against the fence's melee attacks until the end of the fence's next turn (or to all melee attacks on a critical success)."
    },
    {
      "kind": "ability",
      "name": "Quick Rummage",
      "actions": 1,
      "category": "offensive",
      "text": "The fence always has a few items close at hand. The fence Interacts to draw a weapon or an item that takes a single action to activate, and then Strikes with the weapon or Activates the Item."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The fence deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "category": "precision",
            "diceNumber": 2,
            "dieSize": "d6",
            "key": "DamageDice",
            "predicate": [
              "target:condition:off-guard"
            ],
            "selector": "strike-damage"
          }
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.TOTMToggle.OffGuard",
            "option": "target:condition:off-guard",
            "toggleable": "totm"
          }
        }
      ]
    }
  ],
  "text": "Fences make themselves indispensable to the underworld by paying for stolen goods only to resell them later, whether through a seemingly legitimate business or to a closed group of elite buyers.\n\n---\nIn the underbelly of society, the lawless reign supreme."
