    },
    {
      "kind": "ability",
      "name": "Reactive Strike",
      "actions": "reaction",
      "category": "defensive"
    },
    {
      "kind": "ability",
      "name": "You'll Pay for That",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "auditory",
        "concentrate",
        "emotion",
        "linguistic",
        "mental"
      ],
      "text": "Trigger An enemy damages the kingpin\n\n---\nEffect The kingpin issues a vendetta against the enemy. Each of the kingpin's allies who hears the command gains a +5 status bonus to their next damage roll against that enemy.\n\n---\nEffect: You'll Pay for That"
    },
    {
      "kind": "ability",
      "name": "Fencing Brawl",
      "actions": 2,
      "category": "offensive",
      "text": "The kingpin attempts a rapier Strike followed by a disarm or grapple attempt against the same enemy. These count as one attack for the kingpin's multiple attack penalty, and the penalty doesn't increase until after both attacks."
    },
    {
      "kind": "ability",
      "name": "Kick Away",
      "actions": "reaction",
      "category": "offensive",
      "text": "Trigger The kingpin knocks an item out of a creature's grasp using Disarm\n\n---\nEffect The kingpin kicks the weapon up to 20 feet in any direction. If the kingpin kicks the weapon into an ally's square, that ally can catch the weapon as a free action, Releasing anything else they're holding if necessary.",
      "rules": [
        {
          "key": "note",
          "selector": "athletics",
          "text": "{item|description}",
          "outcome": [
            "criticalSuccess"
          ],
          "when": [
            "action:disarm"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Kingpin's Command",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "auditory",
        "concentrate",
        "linguistic",
        "mental"
      ],
      "text": "The crime kingpin shouts a command to an ally of their choice. That ally can spend a reaction to Stride and Strike. The ally becomes immune to Kingpin's Command for 24 hours."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The crime kingpin deals an additional 3d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "category": "precision",
            "diceNumber": 3,
            "dieSize": "d6",
            "key": "DamageDice",
            "predicate": [
              "target:condition:off-guard"
            ],
            "selector": "strike-damage"
          }
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.TOTMToggle.OffGuard",
            "option": "target:condition:off-guard",
            "toggleable": "totm"
          }
        }
      ]
    }
  ],
  "text": "Kingpins build empires from the shadows, ruling their territory ruthlessly and keeping their business private. Most forge connections with the rich and powerful, doing dirty work for politicians and minor nobles in return for influence and favors that can be called in at any time.\n\n---\nIn the underbelly of society, the lawless reign supreme."
