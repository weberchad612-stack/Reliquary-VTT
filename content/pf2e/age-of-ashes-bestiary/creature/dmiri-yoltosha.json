    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "text": "Dmiri designates a single creature as her prey and focuses her attacks against that creature. Dmiri must be able to see or hear the prey, or she must be tracking the prey during exploration.\n\nDmiri gains a +2 circumstance bonus to Perception checks when she Seeks her prey and a +2 circumstance bonus to Survival checks when she Tracks her prey. Dmiri also ignores the penalty for making ranged attacks within her second range increment against the prey she is hunting.\n\nDmiri can have only one creature designated as prey at a time. If she uses Hunt Prey against a creature when she already has a creature designated, the prior creature loses the designation and the new prey gains the designation. Dmiri's designation lasts until her next daily preparations.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey",
            "option": "hunted-prey",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "survival",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:track",
            "hunted-prey"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
            "domain": "ranged-attack-roll",
            "key": "RollOption",
            "option": "ignore-range-penalty:2",
            "predicate": [
              "hunted-prey"
            ]
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hunter's Aim",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "concentrate",
        "ranger"
      ],
      "text": "When Dmiri focuses on aiming, her attack becomes particularly accurate. Make a ranged weapon Strike against her hunted prey. On this Strike, Dmiri gains a +2 circumstance bonus to the attack roll and ignores her prey's Concealed condition.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "domain": "attack-roll",
            "key": "RollOption",
            "option": "hunters-aim",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "attack-roll",
          "type": "circumstance",
          "value": 2,
          "when": [
            "hunters-aim",
            "hunted-prey",
            {
              "not": "melee"
            }
          ]
        },
        {
          "key": "note",
          "selector": "attack",
          "text": "Ignore your prey's Concealed condition.",
          "when": [
