    {
      "kind": "ability",
      "name": "Efficient Capture",
      "actions": 3,
      "category": "offensive",
      "traits": [
        "attack",
        "manipulate"
      ],
      "text": "Requirements The Scarlet Triad agent has manacles in hand and is adjacent to a creature.\n\n---\n\nEffect The Scarlet Triad agent attempts to bind the creature's wrists or ankles with the manacles. If they succeed at an attack roll with a +24 modifier against the target's AC, they apply the manacles.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "SpecialStatistic",
            "slug": "efficient-capture",
            "type": "attack-roll"
          }
        },
        {
          "key": "modifier",
          "selector": "efficient-capture-attack-roll",
          "type": "untyped",
          "value": 24
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Precise Debilitations",
      "actions": "free",
      "category": "offensive",
      "text": "Trigger The Scarlet Triad agent's Strike hits an off-guard creature and deals damage.\n\n---\n\nEffect The Scarlet Triad agent applies one of the following debilitations to the creature, which lasts until the end of their next turn.\n\n- Brow Gash The target becomes Off-Guard.\n\n- Deep Cut The target takes an additional 2d6 precision damage from the Scarlet Triad agent's attacks.\n\n- Hamstring The target takes a –10-foot status penalty to its Speeds.\n\n- Low Blow The target becomes Enfeebled 1.\n\nEffect: Hamstring",
      "rules": [
        {
          "key": "note",
          "selector": "strike-damage",
          "text": "f The Scarlet Triad agent applies one of the following debilitations to the creature, which lasts until the end of their next turn.",
          "when": [
            "target:condition:off-guard"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The scarlet triad agent deals an extra 3d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 3,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Weapon Trick",
      "category": "offensive",
