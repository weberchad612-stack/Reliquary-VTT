            "path": "system.attributes.flanking.offGuardable",
            "value": 3
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Nimble Dodge",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger A creature targets Calmont with an attack and he can see the attacker.\n\nRequirements Calmont is not Encumbered\n\nCalmont deftly dodges out of the way, gaining a +2 circumstance bonus to AC against the triggering attack.",
      "rules": [
