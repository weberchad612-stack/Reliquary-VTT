          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Quick Draw",
      "actions": 1,
      "category": "offensive",
      "text": "Calmont draws his weapon and attacks with the same motion. He Interacts to draw a weapon, then Strikes with that weapon."
    },
