      "actions": 2,
      "category": "offensive",
      "text": "Mengkare makes two claw Strikes and one horns Strike in any order"
    },
    {
      "kind": "ability",
      "name": "Draconic Momentum",
      "category": "offensive",
      "text": "When Mengkare scores a critical hit with a strike, he recharges his Breath Weapon.",
