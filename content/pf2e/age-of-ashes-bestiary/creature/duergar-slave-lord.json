    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "text": "The slave lord designates as its prey a single creature that they can see or hear or that they are Tracking. They gain a +2 circumstance bonus to Perception checks when they Seek their prey and a +2 circumstance bonus to Track their prey. They also ignore the penalty for making ranged attacks within their second range increment against their prey.\n\nThe first time a slave lord hits their hunted prey in a round, they deal 2d8 additional precision damage. A slave lord can have only one prey designated at a time.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey",
            "option": "hunted-prey",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "survival",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:track",
            "hunted-prey"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
            "domain": "ranged-attack-roll",
            "key": "RollOption",
            "option": "ignore-range-penalty:2",
            "predicate": [
              "hunted-prey"
            ]
          }
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.HuntPrey.FirstHitDamage",
            "option": "first-attack",
            "toggleable": true
          }
        },
        {
          "key": "unsupported",
