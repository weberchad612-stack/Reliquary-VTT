    {
      "kind": "ability",
      "name": "Quick Alchemy",
      "actions": 1,
      "category": "offensive",
      "text": "Zuferian creates a single alchemical item from her formula book. This item has the infused trait, but it remains potent only until the start of her next turn. With her typical preparations, she can use this ability 7 times per day."
    },
    {
      "kind": "ability",
      "name": "Quick Bomber",
      "actions": 1,
      "category": "offensive",
      "text": "Zuferian Interacts to draw a bomb, then Strikes with it."
    },
    {
      "kind": "ability",
      "name": "True Debilitating Bomb",
      "category": "offensive",
      "text": "When Zuferian uses Debilitating Bomb, add the following to the list of effects Zuferian can choose from:\n\n- Enfeebled 2\n\n- Stupefied 2\n\n- a –15-foot status penalty to Speeds.\n\nIf Zuferian instead applies one of the effects listed in Debilitating Bomb, the target avoids the effect only if the result of its saving throw is a critical success."
    },
    {
      "kind": "ability",
      "name": "Uncanny Bombs",
      "category": "offensive",
      "text": "When Zuferian throws an alchemical item with the bomb trait, its range increment increases to 60 feet, Zuferian reduces any circumstance bonus to the target's AC from cover by 1, and Zuferian automatically succeeds at the flat check when targeting a concealed creature."
