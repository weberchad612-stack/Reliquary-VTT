    {
      "kind": "ability",
      "name": "+2 Status to All Saves vs. Effects Created by Constructs",
      "category": "defensive",
      "rules": [
        {
          "key": "modifier",
          "selector": "saving-throw",
          "type": "status",
          "value": 2,
          "when": [
