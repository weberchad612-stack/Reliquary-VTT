    {
      "kind": "ability",
      "name": "Regent's Glower",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "emotion",
        "fear",
        "mental",
        "primal"
      ],
      "text": "Trigger The dragon is critically hit with a melee attack\n\n---\nEffect The dragon focuses their weighty gaze upon their assailant, filling their foe with dread. The triggering creature takes 4d6 mental damage with a DC 26 basic Will save save. Any creature who fails the save also becomes Frightened 1 (Frightened 2 on a critical failure)."
    },
    {
      "kind": "ability",
      "name": "Benthic Bite",
      "category": "offensive",
      "traits": [
        "primal"
      ],
      "text": "A creature who takes damage from a brine dragon's jaws Strike must succeed at a DC 26 Fortitude save save or be Enfeebled 1 for 1 round."
    },
    {
      "kind": "ability",
      "name": "Crushing Breath",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "primal"
      ],
      "text": "The dragon spews a 50-foot line of pressurized water that deals 8d6 bludgeoning damage with a DC 26 basic Reflex save save. A creature that fails the save is also Clumsy 1 (Clumsy 2 on a critical failure) for 1 minute. The dragon can't use Crushing Breath again for 1d4 rounds."
    },
    {
      "kind": "ability",
      "name": "Draconic Frenzy",
      "actions": 2,
      "category": "offensive",
      "text": "The dragon makes two claw Strikes and one tail Strike in any order."
    },
    {
      "kind": "ability",
      "name": "Draconic Momentum",
      "category": "offensive",
      "text": "When the dragon scores a critical hit with a Strike, they recharge Crushing Breath.",
      "rules": [
        {
          "key": "note",
          "selector": "strike-attack-roll",
          "text": "{item|description}",
          "outcome": [
            "criticalSuccess"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Pressurized Pool",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "primal"
      ],
      "text": "The dragon expels a 10-foot burst of pressurized water within 120 feet that lasts for 1 minute. A creature other than a brine dragon that enters or begins their turn within a burst must succeed at a DC 26 Fortitude save save or become Encumbered until the beginning of their next turn."
    }
  ]
