        {
          "key": "note",
          "selector": "initiative",
          "text": "{item|description}"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Distracting Whisper",
      "actions": "reaction",
      "category": "defensive",
      "traits": [
        "mental",
        "occult"
      ],
      "text": "Trigger The dragon is targeted with an attack\n\n---\nEffect A mysterious voice whispers something disconcerting in the triggering creature's ear, inflicting a –2 circumstance penalty to the triggering attack."
    },
    {
      "kind": "ability",
      "name": "Cogitation Breath",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "mental",
        "occult"
      ],
      "text": "The dragon unleashes a befuddling miasma, dealing 19d6 mental damage in an 80-foot cone (DC 42 basic Will save save). A creature that fails its save is Stupefied 1 (Stupefied 2 on a critical failure) for 1 minute. The dragon can't use Cogitation Breath again for 1d4 rounds."
    },
    {
      "kind": "ability",
      "name": "Steal Knowledge",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "mental",
        "occult"
      ],
      "text": "The dragon plucks a fragment of knowledge from the mind of a creature within 60 feet, choosing a skill to affect. The creature must attempt a DC 42 Will save save.\n\nSuccess The creature is unaffected.\n\nFailure For the next minute, the creature takes a –1 status penalty to checks using that skill, and the dragon gets a +1 status bonus to using that skill.\n\nCritical Failure As failure, but the penalty is –2 and the bonus is +2."
    },
    {
      "kind": "ability",
      "name": "Thought Whispers",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "mental",
        "occult"
      ],
      "text": "Frequency once per minute\n\n---\nEffect The dragon sends their mind out to seek others' thoughts, affecting all creatures within 80 feet with mind reading (DC 42 Will save).",
      "frequency": {
        "max": 1,
        "per": "PT1M"
      }
    },
    {
      "kind": "ability",
      "name": "Unveil Secret",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "fear",
        "mental",
        "occult"
      ],
      "text": "The dragon delves into the mind of a creature within 60 feet, learning something they'd find embarrassing or shameful unless they succeed at a DC 42 Will save save. The target becomes Frightened 1 and cannot reduce their frightened condition for 1 minute or until the dragon reveals the secret. As a reaction when the affected creature attempts a check, the dragon can reveal their secret to discomfit them, requiring them to roll twice and take the lower result; this is a misfortune effect."
    }
  ],
  "text": "Whisper dragons are keen collectors of rumors and secrets who spend centuries honing their information networks and relationships. They generally do so not out of an intent to hold the information over others or to use for their own machinations, but simply because the process of learning and gathering information is fulfilling. Their hoards are sparse compared to those of other dragons, as they hold their true treasures—secrets—in their minds."
