    {
      "kind": "ability",
      "name": "Communal Knowledge",
      "actions": 3,
      "category": "interaction",
      "traits": [
        "concentrate",
        "occult",
        "scrying"
      ],
      "text": "The dragon mentally communes with all their current active informants simultaneously. They learn the present state of all the informants, as status, and any new information the informants have learned since they were last in communication. Fragments of extraneous information briefly remain after using Communal Knowledge; for the next hour, the dragon can attempt Recall Knowledge checks for any skill with a modifier of +36."
    },
