    {
      "kind": "ability",
      "name": "Great Despair",
      "category": "defensive",
      "traits": [
        "aura",
        "divine",
        "emotion",
        "fear",
        "incapacitation",
        "mental"
      ],
      "text": "30 feet. Living creatures are Frightened 1 while in an mummy prophet's great despair aura. They can't naturally recover from this fear while in the area but recover instantly once they leave it. When a creature first enters the area, it must succeed at a DC 31 Will save save (after taking the penalty from being frightened) or be Paralyzed for 1d4 rounds. The creature is then temporarily immune for 24 hours.\n\nEffect: Despair",
      "rules": [
