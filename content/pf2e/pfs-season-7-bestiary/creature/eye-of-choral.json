    {
      "kind": "ability",
      "name": "Shadow Construct",
      "category": "defensive",
      "traits": [
        "illusion"
      ],
      "text": "The Eye of Choral is only semi-real. The first time each round a PC is hit by one of the Eye's Strikes, the creature makes a DC 23 Will save save to realize the creature's attacks aren't wholly real. The result applies to the damage of that Strike and lasts until the start of the creature's next turn.\n\n---\nCritical Success The creature gains resistance to damage from the Eye's Strikes equal to its level.\n\nSuccess The creature gains resistance to damage from the Eye's Strikes equal to half its level.\n\nFailure The creature is affected by the Eye's Strikes as normal.",
      "rules": [
        {
          "key": "immunity",
          "type": "doomed"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Draconic Frenzy",
      "actions": 2,
      "category": "offensive",
      "text": "The Eye makes two claw Strikes and one wing Strike in any order"
    },
    {
      "kind": "ability",
      "name": "Draconic Momentum",
      "category": "offensive",
      "text": "The Eye recharges their Pyre Breath whenever they score a critical hit with a Strike.",
      "rules": [
        {
          "key": "note",
          "selector": "strike-attack-roll",
