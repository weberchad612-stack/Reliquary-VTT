      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "Shaldar Falls-Far designates a single creature she can see and hear, or one that she's Tracking, as her prey. She gains a +2 circumstance bonus to Perception checks to Seek the prey and to Survival checks to Track the prey. The first time she hits the designated prey in a round, she deals an additional 1d8 precision damage. She also ignores the penalty for making ranged attacks within her second range increment. These effects last until Shaldar Falls-Far uses Hunt Prey again.",
      "rules": [
        {
          "key": "roll-option",
          "option": "hunted-prey",
          "toggleable": true,
          "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey"
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "survival",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:track",
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "first-attack",
          "toggleable": true,
          "label": "PF2E.SpecificRule.Ranger.HuntersEdge.FirstAttack",
          "when": [
            "hunted-prey"
          ]
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d8",
          "category": "precision",
          "when": [
            "first-attack"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hunter's Aim",
      "actions": 2,
