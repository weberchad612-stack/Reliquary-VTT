    {
      "kind": "ability",
      "name": "Rejuvenation",
      "category": "defensive",
      "traits": [
        "divine"
      ],
      "text": "When the Prince of Wolves dies, his soul immediately travels to the crystalline shadow stele in his Den. His body rejuvenates over 24 hours, emerging fully formed from the shadow stele. He can be permanently slain only if the shadow stele is destroyed."
    },
    {
      "kind": "ability",
      "name": "Change Shape",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "polymorph"
      ],
      "text": "The Prince changes into his humanoid shape, hybrid shape, or wolf shape. While in hybrid shape, he gains a jaws Strike. While in animal shape, he gains the effects of a 5th-rank casting of Animal Form to become a canine. He prefers fighting in hybrid shape.\n\n---"
    },
    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "The Prince designates one or two targets he can see or hear as his prey. He gains a +2 circumstance bonus to Perception checks to Seek and Track his prey. If he uses Hunt Prey against a third creature when he already has two designated, a prior creature of his choice loses the designation. His designation lasts until his next daily preparations.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey",
            "option": "hunted-prey",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            {
              "or": [
                "action:seek",
                "action:track"
              ]
            },
            "hunted-prey"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Pack Tactics",
      "category": "offensive",
      "text": "If an enemy is within reach of the Prince and at least two of his allies, that enemy is Off-Guard against him.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "add",
            "path": "system.attributes.flanking.canGangUp",
            "value": 2
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Skirmish Strike",
      "actions": 1,
      "category": "offensive",
      "text": "The Prince either Steps and then Strikes, or Strikes and then Steps."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The Prince deals an extra 4d6 precision damage to Off-Guard creatures.",
