          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Tear Fate",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "curse",
        "mental",
        "misfortune",
        "occult"
      ],
      "text": "Requirements The Prince of Wolves' previous action was a successful melee Strike\n\n---\n\nEffect The Prince of Wolves twists his weapon in the wounds inflicted on the creature he just struck, then rips the weapon free. As he does so, he tears free fragments of that creature's fate, leaving them with ill fortune. The creature takes 12d6 mental damage (DC 38 basic Will save save); on a failure, the creature also becomes Doomed 1 (Doomed 2 on a critical failure). The creature is thereafter immune to Tear Fate."
    },
    {
      "kind": "ability",
      "name": "Twin Parry",
      "actions": 1,
      "category": "offensive",
      "text": "Requirements The Prince is wielding two melee weapons, each in a different hand\n\n---\n\nEffect The Prince gains a +1 circumstance bonus to AC until the start of his next turn, as long as he continues to meet this ability's requirement.\n\nEffect: Twin Parry"
    },
    {
      "kind": "ability",
      "name": "Twin Takedown",
      "actions": 1,
      "category": "offensive",
      "text": "Frequency once per round\n\nRequirements The Prince is wielding two melee weapons, each in a different hand\n\n---\n\nEffect The Prince makes two Strikes against his hunted prey, one with each of the required weapons. If both hit the same hunted prey, combine their damage for the purpose of its resistances and weaknesses. Apply his multiple attack penalty to each Strike normally.",
      "frequency": {
        "max": 1,
        "per": "round"
      }
    }
