    {
      "kind": "ability",
      "name": "Fence's Eye",
      "category": "interaction",
      "text": "Fences live by their ability to recognize a viable trade. They can use Underworld Lore to identify an item's value and Identify Magic on an item. They gain a +2 circumstance bonus to Underworld Lore checks when doing so, and to Underworld Lore checks to determine whether an item was stolen, whether a stolen item would be too recognizable to easily move, and who would be interested in purchasing such an item.",
      "rules": [
        {
          "key": "modifier",
          "selector": "underworld-lore",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:identify-magic"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Quick Rummage",
      "actions": 1,
      "category": "offensive",
      "text": "The fence always has a few items close at hand. The fence Interacts to draw a weapon or item that takes a single action to activate, and then Strikes with the weapon or activates the item."
    },
    {
      "kind": "ability",
      "name": "Scoundrel's Feint",
      "category": "offensive",
      "text": "When the fence successfully Feints, their target is Off-Guard against the fence's attacks until the end of the fence's next turn. On a critical success, the target is Off-Guard against all attacks until the end of the fence's next turn."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The fence deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    }
  ],
  "text": "The longer criminals hold on to stolen loot, the greater the chance they will get caught. Fences make themselves indispensable in the underworld by paying for stolen goods in order to resell them later, whether through a seemingly legitimate business or to a closed group of elite buyers.\n\n---\n\nSome criminals are the desperate who have no option but to break the law to survive, while others choose a life of crime for thrills, forming gangs or underworld guilds that specialize in certain illegal ventures.",
  "blurb": "Male elf fence"
