          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Shackle",
      "actions": "reaction",
      "category": "offensive",
      "text": "Trigger A creature within 60 feet is damaged by the vincuvicar's animated manacles Strike\n\n---\n\nEffect The creature must attempt a DC 40 Reflex save save.\n\n---\n\nCritical Success The creature avoids being manacled.\n\nSuccess The manacles distract the creature, causing it to become Off-Guard until the end of its next turn.\n\nFailure The manacles fuse in place and bind the creature's legs and arms until it Escapes or the manacles are destroyed.\n\nCritical Failure As failure, but the creature is also Restrained."
    },
    {
      "kind": "spell",
