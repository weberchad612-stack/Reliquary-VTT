  "text": "Roll 1d6 to determine a suit. The harrowkin gains the effects of the suit for 1 minute. If the suit matches the harrowkin's suit, the value is doubled.\n\nHammers The harrowkin gains a +2 status bonus to damage rolls.\n\nKeys The harrowkin gains a +1 status bonus to AC.\n\nShields The harrowkin gains fast healing 5.\n\nBooks The harrowkin gains a +1 status bonus to skill checks.\n\nStars The harrowkin gains a +1 status bonus to saving throws.\n\nCrown The harrowkin can reroll 1 check within the next minute and take the higher result. This is a fortune effect.",
  "rules": [
    {
      "key": "modifier",
      "selector": "damage",
      "type": "status",
      "value": 2,
      "when": [
        "harrow-suit:hammers"
      ]
    },
    {
      "key": "modifier",
      "selector": "ac",
      "type": "status",
      "value": 1,
      "when": [
        "harrow-suit:keys"
      ]
    },
    {
      "key": "modifier",
      "selector": "skill-check",
      "type": "status",
      "value": 1,
      "when": [
        "harrow-suit:books"
      ]
    },
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "status",
      "value": 1,
      "when": [
        "harrow-suit:stars"
      ]
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "FastHealing",
        "predicate": [
          "harrow-suit:shields",
          {
            "not": "self:effect:read-the-cards:3"
          }
        ],
        "type": "fast-healing",
        "value": 5
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "FastHealing",
        "predicate": [
          "harrow-suit:shields",
          "self:effect:read-the-cards:3"
        ],
