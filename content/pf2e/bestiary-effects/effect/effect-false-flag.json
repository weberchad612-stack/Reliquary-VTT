  "text": "Hellbreakers in the area take a –1 circumstance penalty to saving throws and DCs vs. effects that give the frightened or confused condition.",
  "rules": [
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "circumstance",
      "value": -1,
      "when": [
        {
          "or": [
            "inflicts:confused",
            "inflicts:frightened"
          ]
        }
      ]
    }
  ]
}
