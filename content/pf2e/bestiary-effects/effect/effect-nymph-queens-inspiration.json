      "key": "modifier",
      "selector": [
        "crafting",
        "performance",
        "will"
      ],
      "type": "status",
      "value": 1,
      "slug": "inspiration-performance"
    },
    {
      "key": "modifier",
      "selector": "skill-check",
      "type": "status",
      "value": 4,
      "slug": "inspiration-polymath",
      "when": [
        "proficiency:untrained",
        "feature:polymath"
      ]
    },
    {
      "key": "modifier",
      "selector": "performance",
      "type": "status",
      "value": 2,
      "slug": "inspiration-maestro",
