    {
      "key": "roll-option",
      "option": "mireclock-darkness",
      "toggleable": true,
      "label": "PF2E.SkillVariant.DimLightOrDarkness"
    },
    {
      "key": "modifier",
      "selector": "ac",
      "type": "status",
      "value": 1,
      "when": [
        {
          "or": [
            "mirecloak-darkness",
            "lighting:dim-light",
            "lighting:darkness"
          ]
        }
      ]
    },
    {
      "key": "modifier",
      "selector": "stealth",
      "type": "status",
      "value": 2,
      "when": [
        {
          "or": [
            "mirecloak-darkness",
            "lighting:dim-light",
            "lighting:darkness"
          ]
        }
      ]
    }
  ]
