  "text": "Granted by Ancestral Memories\n\nYou either gain a status bonus to the next spell attack roll you attempt, or an enemy takes a status penalty to the next saving throw they attempt against a spell you cast.",
  "rules": [
    {
      "key": "modifier",
      "selector": "spell-attack-roll",
      "type": "status",
      "value": "ternary(gte(@itemLevel,8),3,ternary(gte(@itemLevel,5),2,1))",
      "slug": "ancestral-memories-bonus",
      "when": [
        "self:signature:{item|origin.signature}"
      ]
    },
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "status",
      "value": "ternary(gte(@itemLevel,8),-3,ternary(gte(@itemLevel,5),-2,-1))",
      "slug": "ancestral-memories-penalty",
      "when": [
        {
          "not": "self:signature:{item|origin.signature}"
        },
        "item:type:spell",
        "origin:signature:{item|origin.signature}"
      ]
    }
  ]
