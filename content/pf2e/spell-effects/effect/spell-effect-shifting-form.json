            "value": "climb"
          },
          {
            "label": "PF2E.Actor.Speed.Type.Swim",
            "value": "swim"
          },
          {
            "label": "PF2E.Actor.Creature.Sense.Type.Darkvision",
            "value": "darkvision"
          },
