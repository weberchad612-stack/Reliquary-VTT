            "value": "claw"
          },
          {
            "label": "PF2E.Actor.Creature.Sense.Type.Scent",
            "value": "scent"
          }
        ],
        "flag": "shiftingForm",
        "key": "ChoiceSet",
        "prompt": "PF2E.SpecificRule.Prompt.Form",
        "rollOption": "shifting-form"
      }
    },
    {
