            "value": "might"
          },
          {
            "label": "PF2E.SpecificRule.SpellEffectSpiritOfTheBeast.AspectOfSwiftness",
            "value": "swiftness"
          },
          {
            "label": "PF2E.SpecificRule.SpellEffectSpiritOfTheBeast.AspectOfInsight",
            "value": "insight"
          }
        ],
        "key": "ChoiceSet",
        "rollOption": "spirit-of-the-beast"
      }
    },
    {
      "key": "modifier",
      "selector": [
        "athletics",
        "fortitude"
      ],
      "type": "status",
