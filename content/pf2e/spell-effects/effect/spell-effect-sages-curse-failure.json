  "text": "Granted by Sage's Curse\n\nThe target must roll twice and use the worse result whenever attempting an Arcana, Lore, Occultism, or Society check. On a critical failure, the target treats the outcomes of all checks to Recall Knowledge as one degree of success worse than the result rolled.",
  "rules": [
    {
      "key": "roll-twice",
      "selector": [
        "arcana",
        "occultism",
        "society",
        "lore-skill-check"
      ],
      "keep": "lower"
    },
    {
      "key": "unsupported",
      "foundry": {
        "choices": [
          {
            "label": "PF2E.Check.Result.Degree.Check.failure",
            "value": "failure"
          },
          {
            "label": "PF2E.Check.Result.Degree.Check.criticalFailure",
            "value": "critical-failure"
          }
        ],
        "key": "ChoiceSet",
        "rollOption": "sages-curse-result"
      }
    },
    {
      "key": "degree",
      "selector": "skill-check",
      "adjust": {
        "all": "one-degree-worse"
      },
      "when": [
        "action:recall-knowledge",
        "sages-curse-result:critical-failure"
      ]
    }
  ]
}
