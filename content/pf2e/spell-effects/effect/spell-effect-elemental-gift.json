{
  "kind": "effect",
  "slug": "spell-effect-elemental-gift",
  "system": "pf2e",
  "name": "Spell Effect: Elemental Gift",
  "source": {
    "title": "Pathfinder Impossible Magic",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 4,
  "duration": {
    "value": 1,
    "unit": "minutes",
    "expiry": "turn-start"
  },
  "text": "Granted by Elemental Gift\n\nChoose an element when you Cast the Spell. The target gains the benefit of that element as described below, and this spell gains that trait's element.\n- Air The target gains a +30-foot status bonus to its land Speed and gains a fly Speed equal to its land Speed without the status bonus.\n- Earth While on the ground, the target gets a +2 status bonus to Fortitude and Reflex saves against effects that would Shove or Trip it, and to saves against effects that would attempt to knock it prone.\n- Fire The target's melee unarmed Strikes and melee weapon Strikes deal 1d6 persistent fire damage on a hit.\n- Metal The target's Strikes using a metal weapon or an unarmed attack deal an additional 1d4 electricity damage on a hit and get a +1 status bonus to the attack roll if the target is made of metal or wearing metal armor.\n- Water The target takes on a watery sheen, gaining resistance 5 to fire and a swim Speed equal to its land Speed.\n- Wood The target gains a number of temporary Hit Points equal to the spell's rank, then gains half that number of temporary HP at the start of each of its turns.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "choices": [
          {
            "label": "PF2E.TraitAir",
            "value": "air"
          },
          {
            "label": "PF2E.TraitEarth",
            "value": "earth"
          },
          {
            "label": "PF2E.TraitFire",
            "value": "fire"
          },
          {
            "label": "PF2E.TraitMetal",
            "value": "metal"
          },
          {
            "label": "PF2E.TraitWater",
            "value": "water"
          },
          {
            "label": "PF2E.TraitWood",
            "value": "wood"
          }
        ],
        "flag": "elementalGift",
        "key": "ChoiceSet",
        "prompt": "PF2E.SpecificRule.Prompt.Element",
        "rollOption": "elemental-gift"
      }
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "BaseSpeed",
        "predicate": [
          "elemental-gift:air"
        ],
        "selector": "fly-speed",
        "value": "@actor.system.movement.speeds.land.value"
      }
    },
    {
      "key": "modifier",
      "selector": "land-speed",
      "type": "status",
      "value": 30,
      "when": [
        "elemental-gift:air"
      ]
    },
    {
      "key": "modifier",
      "selector": [
        "fortitude",
        "reflex"
      ],
      "type": "status",
      "value": 2,
      "when": [
        "elemental-gift:earth",
        {
          "or": [
            "action:shove",
            "action:trip"
          ]
        }
      ]
    },
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "status",
      "value": 2,
      "slug": "earth-prone",
      "when": [
        "elemental-gift:earth",
        "inflicts:prone"
      ]
    },
    {
      "key": "damage-dice",
      "selector": "melee-strike-damage",
      "dice": 1,
      "die": "d6",
      "type": "fire",
      "category": "persistent",
      "when": [
        "elemental-gift:fire"
      ]
    },
    {
      "key": "roll-option",
      "option": "metal-weapon",
      "toggleable": true,
      "label": "PF2E.SpecificRule.Weapon.Metal",
      "when": [
        "elemental-gift:metal"
      ]
    },
    {
      "key": "roll-option",
      "option": "target:metal",
      "domain": "attack-roll",
      "toggleable": true,
      "label": "PF2E.SpecificRule.Target.Metal",
      "when": [
        "elemental-gift:metal"
      ]
    },
    {
      "key": "damage-dice",
      "selector": "strike-damage",
      "dice": 1,
      "die": "d4",
      "type": "electricity",
      "when": [
        "elemental-gift:metal",
        {
          "or": [
            "metal-weapon",
            "unarmed"
          ]
        }
      ]
    },
    {
      "key": "modifier",
      "selector": "strike-attack-roll",
      "type": "status",
      "value": 1,
      "when": [
        "elemental-gift:metal",
        "target:metal",
        {
          "or": [
            "metal-weapon",
            "unarmed"
          ]
        }
      ]
    },
    {
      "key": "unsupported",
      "foundry": {
        "key": "BaseSpeed",
        "predicate": [
          "elemental-gift:water"
        ],
        "selector": "swim-speed",
        "value": "@actor.system.movement.speeds.land.value"
      }
    },
    {
      "key": "resistance",
      "type": "fire",
      "value": 5,
      "when": [
        "elemental-gift:water"
      ]
    },
    {
      "key": "temp-hp",
      "value": "@itemLevel"
    },
    {
      "key": "temp-hp",
      "value": "floor(@itemLevel/2)",
      "onTurnStart": true
    }
  ]
}
