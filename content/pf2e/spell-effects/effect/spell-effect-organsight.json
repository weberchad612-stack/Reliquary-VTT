{
  "kind": "effect",
  "slug": "spell-effect-organsight",
  "system": "pf2e",
  "name": "Spell Effect: Organsight",
  "source": {
    "title": "Pathfinder Secrets of Magic",
    "license": "OGL",
    "from": "foundry-pf2e"
  },
  "level": 3,
  "duration": {
    "value": 1,
    "unit": "minutes",
    "expiry": "turn-start"
  },
  "text": "Granted by Organsight\n\nYou gain a +2 circumstance bonus on Medicine checks against the target that depend on its organs, but a -2 circumstance penalty on Medicine checks depending on seeing its skin.\n\nIf you succeed the Recall Knowledge check, the next time you deal piercing or slashing damage to the target with a Strike or spell, you deal additional precision damage.",
  "rules": [
    {
      "key": "modifier",
      "selector": "medicine",
      "type": "circumstance",
      "value": 2,
      "slug": "organsight-med-bonus",
      "when": [
        "organ-dependent"
      ]
    },
    {
      "key": "modifier",
      "selector": "medicine",
      "type": "circumstance",
      "value": -2,
      "slug": "organsight-med-penalty",
      "when": [
        "skin-dependent"
      ]
    },
    {
      "key": "damage-dice",
      "selector": [
        "strike-damage",
        "spell-damage"
      ],
      "dice": "1 + @itemLevel",
      "die": "d6",
      "category": "precision",
      "when": [
        "organsight",
        {
          "or": [
            "item:damage:type:piercing",
            "item:damage:type:slashing"
          ]
        }
      ]
    },
    {
      "key": "roll-option",
      "option": "organsight",
      "domain": "damage",
      "toggleable": true,
      "label": "PF2E.SpecificRule.Organsight.Success"
    }
  ]
}
