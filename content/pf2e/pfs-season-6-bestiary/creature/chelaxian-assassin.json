    {
      "kind": "ability",
      "name": "Unnoticeable Guile",
      "category": "interaction",
      "text": "The Chelaxian assassin is an expert at maintaining perfect stillness and blending into their surroundings. Each non-ally creature who has not been targeted by or subject to an attack or effect made by the Chelaxian assassin must, at the start of their turn, succeed at a DC 27 Will save save (DC 28 Will save in dungeon environments while the Chelaxian assassin is wearing their camouflage suit) or the Chelaxian assassin becomes Hidden to them. This effect ends if the Chelaxian assassin moves without Sneaking or takes any hostile action against the non-ally creature. This does not prevent a creature from making Perception checks to Seek, making the assassin Observed as normal on a success."
    },
    {
      "kind": "ability",
      "name": "+2 to Perception to Detect Snares and Hazards",
      "category": "defensive",
      "rules": [
        {
          "key": "modifier",
          "selector": "perception",
          "type": "untyped",
          "value": 2,
          "when": [
            {
              "or": [
                "origin:trait:hazard",
                "item:trait:snare"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Devilish Feint",
      "category": "offensive",
      "text": "When the Chelaxian assassin successfully Feints, the target is Off-Guard against the Chelaxian assassin's weapon attacks until the end of the Chelaxian assassin's next turn. On a critical success, the target is off-guard against all weapon attacks for that time, not just the Chelaxian assassin's."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The Chelaxian assassin deals an additional 3d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "category": "precision",
            "diceNumber": 3,
            "dieSize": "d6",
            "key": "DamageDice",
            "predicate": [
