    {
      "kind": "ability",
      "name": "Voice of the Nessari",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "auditory",
        "concentrate",
        "emotion",
        "mental"
      ],
      "text": "Through his Nahyndrian-warshard concoction, Yollen voice becomes infused with the menacing weight of a tyrant devil. All non-allied creatures within 20 feet who can hear Yollen must attempt a DC 26 Fortitude save save against 7d10 spirit damage.\n\n---\nCritical Success The creature is unaffected.\n\nSuccess The creature takes half damage.\n\nFailure The creature takes full damage and is Enfeebled 2 for 1 minute. The creature must also attempt a DC 26 Will save save or be Slowed 2.\n\nCritical Failure The creature takes double damage and is enfeebled 2 for 1 minute. The creature must also attempt a DC 26 Will save save or be Paralyzed for 1 round."
