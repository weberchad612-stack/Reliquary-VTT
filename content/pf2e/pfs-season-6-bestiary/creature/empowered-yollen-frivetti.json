      "kind": "ability",
      "name": "Hellish Spellstrike",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "arcane",
        "magical"
      ],
      "text": "Yollen's signature spellstrike channels the ill will of Hell. He casts ignition, then makes a melee attack strike with his greataxe. If he successfully hits, he deals an additional 3d6 damage (6d6 on a critical hit) on top of the damage from ignition and the greataxe. This counts as two attacks for the purposes of multiple attack penalty, but the penalty does not apply until after Yollen completes this ability. Yollen cannot use Hellish Spellstrike again until he has recharge it using a single action with the concentrate trait, or cast his conflux spell.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "option": "hellish-spellstrike",
            "toggleable": true
          }
        },
        {
          "key": "unsupported",
          "foundry": {
            "diceNumber": 3,
            "dieSize": "d6",
            "key": "DamageDice",
            "predicate": [
