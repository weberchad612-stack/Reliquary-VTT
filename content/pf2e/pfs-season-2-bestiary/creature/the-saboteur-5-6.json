    {
      "kind": "ability",
      "name": "Sythi: Nervous Retreat",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger An ally ends a move action adjacent to Sythi.\n\n---\n\nEffect Sythi hides behind his ally. He Steps to another square adjacent to the triggering ally and gains a +2 circumstance bonus to his AC against the next attack that targets him. (Sythi only.)",
      "rules": [
        {
          "key": "roll-option",
          "option": "nervous-retreat",
          "domain": "ac",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "circumstance",
          "value": 2,
          "when": [
            "nervous-retreat"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Blood Frenzy",
      "actions": "free",
      "category": "offensive",
      "traits": [
        "rage"
      ],
      "text": "Requirements The sea devil is not Fatigued or already in a frenzy\n\nTrigger The sea devil deals bleed damage to a living creature.\n\n---\nEffect The sea devil flies into a frenzy that lasts 1 minute. While frenzied, the sea devil gains a +1 status bonus to attack rolls with its claws and jaws, gains a +4 status bonus to damage rolls with its claws and jaws, gains 15 temporary HP until the end of the frenzy, and takes a -2 status penalty to AC. The sea devil can't voluntarily stop its frenzy. After its frenzy, the sea devil is Fatigued.",
      "rules": [
        {
          "key": "modifier",
          "selector": "claw-attack",
          "type": "status",
          "value": 1,
          "when": [
            "self:effect:blood-frenzy"
          ]
        },
        {
          "key": "modifier",
          "selector": "jaws-attack",
          "type": "status",
          "value": 1,
          "when": [
            "self:effect:blood-frenzy"
          ]
        },
        {
          "key": "modifier",
          "selector": "claw-damage",
          "type": "status",
          "value": 4,
          "when": [
            "self:effect:blood-frenzy"
          ]
        },
        {
          "key": "modifier",
          "selector": "jaws-damage",
          "type": "status",
          "value": 4,
          "when": [
            "self:effect:blood-frenzy"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "add",
            "path": "flags.system.frenzyMod",
            "value": 10
          }
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "status",
          "value": -2,
          "when": [
            "self:effect:blood-frenzy"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Bloodletting",
      "category": "offensive",
      "text": "When the sea devil deals piercing or slashing damage, it also deals 1d4 bleed if the target was Off-Guard or if the attack was a critical hit.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "damage",
          "dice": 1,
          "die": "d4",
          "type": "bleed",
          "when": [
            "target:condition:off-guard",
            {
              "or": [
                "item:damage:type:piercing",
                "item:damage:type:slashing"
              ]
            }
          ]
        },
        {
          "key": "damage-dice",
          "selector": "damage",
          "dice": 1,
          "die": "d4",
          "type": "bleed",
          "critical": true,
          "when": [
            {
              "not": "target:condition:off-guard"
            },
            {
              "or": [
                "item:damage:type:piercing",
                "item:damage:type:slashing"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Rahla: Applied Anesthesia",
      "category": "offensive",
      "text": "Rahla's scalpel is coated with a disorienting agent. The first creature she successfully hits with a scalpel strike must succeed on a DC 24 Fortitude save save or be Sickened 1; this is a poison effect. (Rahla only.)"
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The saboteur deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Surprise Attack",
      "category": "offensive",
      "text": "On the first round of combat, if the saboteur rolls Deception or Stealth for initiative, creatures that haven't acted are Off-Guard to them.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "EphemeralEffect",
            "predicate": [
              "encounter:round:1",
              {
                "lt": [
                  "self:participant:initiative:rank",
                  "target:participant:initiative:rank"
                ]
              },
              {
                "or": [
                  "self:participant:initiative:stat:deception",
                  "self:participant:initiative:stat:stealth"
                ]
              }
            ],
            "selectors": [
              "strike-attack-roll",
              "spell-attack-roll",
              "strike-damage",
              "attack-spell-damage"
            ],
            "uuid": "Compendium.pf2e.conditionitems.Item.Off-Guard"
          }
        }
      ]
