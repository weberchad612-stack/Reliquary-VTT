    {
      "kind": "ability",
      "name": "Recoil from Wasted Opportunities",
      "category": "defensive",
      "text": "Vermleks cannot stand the sight of a good meal presented and then swiftly taken away. Whenever a Dying creature within sight of the vermlek has its dying condition removed, the vermlek takes 1d6 mental damage."
    },
    {
      "kind": "ability",
      "name": "Abandon Body",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements The vermlek is Inhabiting a Centaur Body\n\n---\n\nEffect The vermlek crawls out of the body it is inhabiting, devouring much of the body's remaining flesh and regaining 15 healing Hit Points in the process. The corpse it leaves behind is little more than a husk."
    },
    {
      "kind": "ability",
      "name": "Inhabit Centaur Body",
      "actions": 3,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "While most vermleks inhabit Medium humanoids, Urxehl has granted this demon the ability to inhabit centaurs instead.\n\nThe vermlek crawls into the body of an adjacent dead centaur, consuming the bulk of the victim's skeleton and internal organs as it does so and cramming itself into the cavity.\n\nThe vermlek can wield weapons and use the centaur's Speed, hoof attack, and Trample ability. It also gains a +3 circumstance bonus to AC. While Inhabiting a Centaur body, a vermlek can't burrow.\n\nIt can't use this ability if it's already Inhabiting a Centaur Body.",
      "rules": [
        {
          "key": "roll-option",
          "option": "inhabit-centaur",
          "toggleable": true,
          "default": true
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "untyped",
          "value": 3,
          "when": [
            "inhabit-centaur"
          ]
        },
        {
          "key": "speed",
          "type": "land",
          "value": 40,
          "when": [
            "inhabit-centaur"
          ]
        },
        {
          "key": "speed",
          "type": "burrow",
          "value": 15,
          "when": [
            {
              "not": "inhabit-centaur"
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Trample",
      "actions": 3,
      "category": "offensive",
      "text": "Medium or Smaller; Hoof; DC 21 basic Reflex save\n\n---"
    },
    {
      "kind": "ability",
      "name": "Unsettling Movement",
      "category": "offensive",
      "traits": [
        "emotion",
        "fear",
        "mental",
        "visual"
      ],
      "text": "Whenever the vermlek Abandons a Body or Inhabits a Body, all creatures within 30 feet who can see the vermlek must succeed at a DC 20 Will save save or become Frightened 1. On a critical failure, the creature is frightened 1 and Sickened 1.\n\nRegardless of the result, creatures are immune to the same vermlek's unsettling movement for 24 hours."
    }
