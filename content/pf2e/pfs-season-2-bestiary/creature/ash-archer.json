    {
      "kind": "ability",
      "name": "Hunt Prey",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate"
      ],
      "text": "The ash archer designates a single creature they can see and hear, or one they're Tracking, as their prey. The archer gains a +2 circumstance bonus to Perception checks to Seek the prey and to Survival checks to Track the prey.\n\nThe first time the archer hits the designated prey in a round, they deal an additional 1d8 precision damage. The archer also ignores the penalty for making ranged attacks within their second range increment.\n\nThese effects last until the archer uses Hunt Prey again.",
      "rules": [
        {
          "key": "roll-option",
          "option": "hunted-prey",
          "toggleable": true,
          "label": "PF2E.SpecificRule.HuntPrey.TargetHuntedPrey"
        },
        {
          "key": "modifier",
          "selector": "perception",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:seek",
            "hunted-prey"
          ]
        },
        {
          "key": "modifier",
          "selector": "survival",
          "type": "circumstance",
          "value": 2,
          "when": [
            "action:track",
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "ignore-range-penalty:2",
          "domain": "ranged-attack-roll",
          "when": [
            "hunted-prey"
          ]
        },
        {
          "key": "roll-option",
          "option": "first-attack",
          "toggleable": true,
          "label": "PF2E.SpecificRule.Ranger.HuntersEdge.FirstAttack"
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d8",
          "category": "precision",
          "when": [
            "first-attack"
          ]
        }
      ]
    }
  ]
