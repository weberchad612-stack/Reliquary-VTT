          "selector": "ac",
          "type": "status",
          "value": -2,
          "when": [
            "self:effect:blood-frenzy"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Bloodletting",
      "category": "offensive",
      "text": "When the sea devil deals piercing or slashing damage, it also deals 1d4 bleed if the target was Off-Guard or if the attack was a critical hit.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "damage",
          "dice": 1,
