  "level": 0,
  "category": "ancestryfeature",
  "text": "Darkvision: You gain darkvision if you don't already have it.\n\nGreater Disease and Poison Protection: Your bonus against disease and poison increases to +2. You gain poison resistance equal to half your level.\n\nParalysis and Sleep Protection: You gain a +1 circumstance bonus to saving throws (or any other defense) against effects that would make you Paralyzed or have the sleep trait.",
  "rules": [
    {
      "key": "sense",
      "type": "darkvision"
    },
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "circumstance",
      "value": 2,
      "slug": "advanced-undead-disease-poison",
      "when": [
        {
          "or": [
            "disease",
            "poison"
          ]
        }
      ]
    },
    {
      "key": "modifier",
      "selector": "saving-throw",
      "type": "circumstance",
      "value": 1,
      "slug": "advanced-undead-paralyzed-sleep",
      "when": [
        {
          "or": [
            "inflicts:paralyzed",
            "sleep"
          ]
        }
      ]
    },
    {
      "key": "resistance",
      "type": "poison",
      "value": "floor(@level/2)"
    }
  ]
}
