    {
      "kind": "ability",
      "name": "Spines",
      "category": "defensive",
      "text": "Any creature that makes a melee attack against a taiga linnorm is stabbed by the taiga linnorm's spines and takes 1d6 piercing damage per attack. A melee weapon with reach protects the user against these spines."
