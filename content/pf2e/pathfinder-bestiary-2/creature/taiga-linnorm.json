    {
      "kind": "ability",
      "name": "Breath Weapon",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "electricity",
        "primal"
      ],
      "text": "The taiga linnorm breathes a 60-foot cone of electrified vapor, dealing 20d6 electricity damage to creatures in the area (DC 41 basic Reflex save save). The electrified mist persists for 1d4 rounds, dealing 6d6 electricity damage (DC 41 basic Reflex save save) to each creature that ends its turn in the mist.\n\nThe taiga linnorm can't use Breath Weapon again for 1d4 rounds."
    },
