    {
      "kind": "ability",
      "name": "Mercy Vulnerability",
      "category": "defensive",
      "traits": [
        "mental"
      ],
      "text": "Babaus revel in gore, and when wounds are healed, they recoil in pain. When a creature heals from damage that the babau dealt on their last turn with Grievous Strike, sneak attack, or a critical hit, the demon takes 4d6 mental damage. The babau can take this mental damage only once per round."
    },
    {
      "kind": "ability",
      "name": "Reactive Slime",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger A creature within the babau's reach successfully hits the babau with a Strike\n\n---\n\nEffect The babau excretes a gout of acidic, bloodlike slime against the attacker and its weapon. The attacker must attempt a DC 24 Reflex save save.\n\n---\n\nCritical Success The attacker is unaffected.\n\nSuccess The attacker takes 1d6 acid damage.\n\nFailure The attacker takes 2d6 acid damage.\n\nCritical Failure As failure, except the weapon used to Strike the babau becomes Broken, unless the weapon is made of a material that is immune to acid."
    },
    {
      "kind": "ability",
      "name": "Grievous Strike",
      "actions": 2,
      "category": "offensive",
      "text": "The babau attacks with the intent of creating a particularly horrific and gory wound. The babau makes a melee Strike. This counts as two attacks when calculating the demon's multiple attack penalty. If this Strike hits, the babau deals an additional 2d6 damage of the same damage type, and the creature struck is Frightened 2.",
      "rules": [
        {
          "key": "roll-option",
          "option": "grievous-strike",
          "domain": "damage",
          "toggleable": true
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "when": [
            "grievous-strike"
          ]
        },
        {
          "key": "note",
          "selector": "strike-damage",
          "text": "{item|system.description.value}",
          "when": [
            "grievous-strike"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The babau's Strikes deal an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    },
    {
      "kind": "spell",
      "name": "Abyssal Pact",
      "rank": 1,
      "ref": "spells:spell/demonic-pact"
    }
  ],
  "text": "The babau is an assassin, a murderer, and a sadist-certainly not unusual traits, yet their penchant for stealth and surprise sets them apart from their kin. Babaus form from mortal souls of lone killers-those who took pleasure in more personal murders, and particularly those with grisly patterns to their killings."
