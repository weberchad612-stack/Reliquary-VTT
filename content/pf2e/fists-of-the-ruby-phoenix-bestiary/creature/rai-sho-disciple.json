    {
      "kind": "ability",
      "name": "Falling Sal Stance",
      "actions": 1,
      "category": "interaction",
      "traits": [
        "stance"
      ],
      "text": "The disciple joins their palms together in the shape of a sal flower, evoking the truth that all things eventually decay. In this stance, they can make sal blossom Strikes (see Strikes) and are Quickened, and can use the extra action only to cast wholeness of body."
