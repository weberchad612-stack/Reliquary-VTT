    {
      "kind": "ability",
      "name": "+3 status to all saves vs. conjuration",
      "category": "defensive",
      "rules": [
        {
          "key": "modifier",
          "selector": "saving-throw",
          "type": "status",
          "value": 3,
          "when": [
