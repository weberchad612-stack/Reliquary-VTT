{
  "kind": "feat",
  "slug": "tsukiyo-moderate-curse",
  "system": "pf2e",
  "name": "Tsukiyo - Moderate Curse",
  "source": {
    "title": "Pathfinder Lost Omens Gods & Magic",
    "license": "OGL",
    "from": "foundry-pf2e"
  },
  "level": 0,
  "category": "curse",
  "text": "If Tsukiyo is particularly offended by someone, they may find themselves lost in delusions of moonlight. When attempting to navigate or find something at night, if you roll a success or critical success on your Perception check, Survival check, or other check to do so, you get a failure instead.",
  "rules": [
    {
      "key": "degree",
      "selector": "perception-check",
      "adjust": {
        "critical-success": "to-failure",
        "success": "to-failure"
      },
      "when": [
        "environment:night",
        {
          "or": [
            "action:find-something",
            "action:navigate",
            "action:search"
          ]
        }
      ]
    },
    {
      "key": "degree",
      "selector": "skill-check",
      "adjust": {
        "critical-success": "to-failure",
        "success": "to-failure"
      },
      "when": [
        "environment:night",
        {
          "or": [
            "action:find-something",
            "action:navigate",
            "action:search"
          ]
        }
      ]
    }
  ]
}
