    {
      "kind": "ability",
      "name": "Shadow's Displeasure",
      "category": "defensive",
      "text": "When Okoro has fewer than 150 Hit Points, his shadow pulls at his essence to show the Vesicant Egg's displeasure. He looks pained and confused, and he becomes Clumsy 1 and Stupefied 1 until healed to 150 Hit Points or more. These conditions increase to 2 when below 100 Hit Points. When below 50 Hit Points, he falls Unconscious."
    },
    {
      "kind": "ability",
      "name": "Vesicated Shadow",
      "category": "defensive",
      "text": "Okoro's shadow has become corrupted via the power of the Vesicant Egg. His shredded shadow grants him some control over acid and shadows. He gains a +4 status bonus to resist acid and shadow effects.",
      "rules": [
        {
          "key": "modifier",
          "selector": "saving-throw",
          "type": "status",
          "value": 4,
          "when": [
            {
              "or": [
                "item:trait:acid",
                "item:trait:shadow"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Observe Weakness",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "fortune",
        "occult"
      ],
      "text": "Okoro studies a creature within 30 feet to find an opening to attack. On his next attack roll against the creature this turn, he rolls twice and uses the higher result, and his attack gains the fortune trait. The target becomes temporarily immune for 1d4 rounds.",
      "rules": [
        {
          "key": "roll-option",
          "option": "observe-weakness",
          "toggleable": true
        },
        {
          "key": "roll-twice",
          "selector": "attack-roll",
          "keep": "higher",
          "when": [
            "observe-weakness"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Rupture Shadow",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "acid",
        "occult",
        "shadow"
      ],
      "text": "Okoro can create immense blisters on a creature's shadow, which immediately burst, dealing 20d6 acid damage. He targets a creature within 60 feet that is casting a shadow, which must attempt a DC 37 Will save save. Okoro can't use Rupture Shadow again for 1d4 rounds.\n\n---\n\nCritical Success The target is unaffected and becomes temporarily immune for 1 day.\n\nSuccess The target takes half damage. The bursting shadow deals 5 acid splash damage to all creatures within 5 feet of the target.\n\nFailure The target takes full damage, and the bursting shadow deals 10 acid splash damage.\n\nCritical Failure The target takes double damage, the bursting shadow deals 20 acid splash damage, and the target also takes 4d6 persistent,acid damage."
    },
    {
      "kind": "ability",
      "name": "Push My Luck",
      "actions": "reaction",
      "category": "offensive",
      "text": "Trigger Okoro targets a creature with an attack\n\nRequirements The triggering creature was the target of Observe Weakness this turn\n\n---\nEffect Okoro draws upon his future luck to guarantee his attack. When he makes his attack roll, if he rolls lower than 10 on the die, he treats that attack roll as a 10 instead. This is in addition to rolling twice and taking the higher result from Observe Weakness. Afterward, Okoro's luck is temporarily spent, and he must roll twice and use the lower result of his next 3 checks; this is a misfortune effect. He can't use Push My Luck again until he's completed these 3 checks.\n\nEffect: Push My Luck (Misfortune)"
    }
  ]
