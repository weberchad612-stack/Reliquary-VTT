      "name": "Deny Fate",
      "category": "defensive",
      "traits": [
        "misfortune"
      ],
      "text": "When Tatterthread rolls initiative, enemies she can see within 120 feet that are also rolling initiative automatically roll a 1.\n\nEffect: Deny Fate",
      "rules": [
        {
          "key": "note",
          "selector": "initiative",
