    {
      "kind": "ability",
      "name": "Flash of History",
      "actions": "free",
      "category": "defensive",
      "traits": [
        "fortune",
        "occult"
      ],
      "text": "Frequency three times per day\n\nTrigger Halbrux is about to attempt a skill check\n\n---\n\nEffect Halbrux peers into lore of the past and increases the level of success by one step (for example, a success becomes a critical success).",
      "frequency": {
        "max": 3,
        "per": "day"
      }
    },
    {
      "kind": "ability",
      "name": "Resolve",
      "category": "defensive",
      "text": "When Halbrux rolls a success on a Will save, she gets a critical success instead.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "adjustment": {
              "success": "one-degree-better"
            },
            "key": "AdjustDegreeOfSuccess",
            "selector": "will"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Curse of Torrential Knowledge",
      "category": "offensive",
      "text": "When halbrux uses her revelation spells, her mind fills with a flood of disorienting information.\n\nThe first time Halbrux casts one of her revelation spells in a day, she takes a -4 penalty to initiative rolls until the next time she makes her daily preparations.\n\nThe second time Halbrux casts one of her revelation spells in a day, she is also Off-Guard until the next time she makes her daily preparations.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "Curse of Torrential Knowledge - Initiative Demerit",
            "option": "curse-torrential-knowledge",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": "initiative",
          "type": "untyped",
          "value": -4,
          "when": [
            "curse-torrential-knowledge"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Predictive Blows",
      "actions": "free",
      "category": "offensive",
      "traits": [
        "concentrate",
        "occult",
        "visual"
      ],
      "text": "Trigger Halbrux's turn begins\n\n---\n\nEffect Halbrux identifies the immediate movements of a creature she can see and attempts a Fortune-Telling Lore check against that creature's Reflex DC.\n\nOn a success, Halbrux's melee Strikes deal an additional 4d6 precision damage (6d6 precision damage on a critical success) to the creature until the end of Halbrux's turn.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "domain": "damage",
            "key": "RollOption",
            "option": "predictive-blows",
            "suboptions": [
              {
                "label": "PF2E.Check.Result.Degree.Check.success",
                "value": "4"
              },
              {
                "label": "PF2E.Check.Result.Degree.Check.criticalSuccess",
                "value": "6"
              }
            ],
            "toggleable": true
          }
        },
        {
          "key": "unsupported",
          "foundry": {
            "category": "precision",
            "diceNumber": "@item.flags.system.rulesSelections.predictiveBlows",
            "dieSize": "d6",
            "key": "DamageDice",
            "predicate": [
              "predictive-blows"
            ],
            "selector": "strike-damage"
          }
        }
      ]
    },
