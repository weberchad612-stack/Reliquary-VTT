    {
      "kind": "ability",
      "name": "Bone-Shattering Cry",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "divine",
        "sonic"
      ],
      "text": "Tollvych cries out in pain as his body twists and grinds into horrific, distorted shapes. All creatures within a 30-foot emanation take 16d6 bludgeoning damage (DC 36 basic Reflex save save) as the sound of the Bone-Shattering Cry shakes and shatters their own bones.\n\nTollvych can't use Bone-Shattering Cry for 1d4 rounds."
    },
