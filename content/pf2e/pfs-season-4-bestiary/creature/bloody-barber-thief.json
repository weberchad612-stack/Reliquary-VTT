      "kind": "ability",
      "name": "Nimble Dodge",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger The thief is targeted with a melee or ranged attack by an attacker it can see.\n\n---\n\nEffect The thief gains a +2 circumstance bonus to AC against the triggering attack.",
