          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Mobility",
      "category": "offensive",
      "text": "When the ambush observer Strides half their Speed or less, that movement does not trigger reactions."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The burglambush observer deals 1d6 extra precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Surprise Attack",
      "category": "offensive",
      "text": "On the first round of combat, if the ambush observer rolls Deception or Stealth for initiative, creatures that haven't acted are Off-Guard to them.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "EphemeralEffect",
            "predicate": [
              "encounter:round:1",
              {
                "lt": [
                  "self:participant:initiative:rank",
                  "target:participant:initiative:rank"
                ]
              },
              {
                "or": [
                  "self:participant:initiative:stat:deception",
                  "self:participant:initiative:stat:stealth"
                ]
              }
            ],
            "selectors": [
              "strike-attack-roll",
              "spell-attack-roll",
              "strike-damage",
              "attack-spell-damage"
            ],
            "uuid": "Compendium.pf2e.conditionitems.Item.Off-Guard"
          }
        }
      ]
    }
  ],
  "text": "Burglars specialize in breaking and entering to rob homes and businesses. These criminals focus on gaining access to secure buildings and bypassing traps and other security measures while remaining undetected all the while.\n\n---\n\nSome criminals are the desperate who have no option but to break the law to survive, while others choose a life of crime for thrills, forming gangs or underworld guilds that specialize in certain illegal ventures.",
  "blurb": "Variant burglar"
}
