    {
      "kind": "ability",
      "name": "Consume Flesh",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements The ghoul antipaladin is adjacent to the corpse of a creature that died within the last hour\n\n---\n\nEffect The ghoul antipaladin devours a chunk of the corpse and regains 4d6 healing Hit Points. It can regain Hit Points from any given corpse only once."
    },
    {
      "kind": "ability",
      "name": "Ghoul Fever",
      "category": "offensive",
      "traits": [
        "disease"
      ],
      "text": "Saving Throw DC 27 Fortitude save\n\n---\n\nStage 1 carrier with no ill effect (1 day)\n\nStage 2 2d6 void damage and regains half as many Hit Points from all healing (1 day)\n\nStage 3 as stage 2 (1 day)\n\nStage 4 2d6 void damage and gains no benefit from healing (1 day)\n\nStage 5 as stage 4 (1 day)\n\nStage 6 dead, and rises as a Ghoul the next midnight."
    },
    {
      "kind": "ability",
      "name": "Paralysis",
      "category": "offensive",
      "traits": [
        "incapacitation",
        "occult"
      ],
      "text": "Any living, non-elf creature hit by a ghoul antipaladin's attack must succeed at a DC 25 Fortitude save save or become Paralyzed. The creature can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
    },
    {
      "kind": "ability",
      "name": "Swift Leap",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "move"
      ],
      "text": "The ghoul antipaladin jumps up to half its Speed. This movement doesn't trigger reactions."
    }
  ],
  "text": "The church of Kabriri selects only the most devoted and deadly ghouls to protect their libraries of secret-filled tomes."
