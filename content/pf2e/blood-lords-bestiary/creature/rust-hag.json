    {
      "kind": "ability",
      "name": "Hagshot",
      "category": "offensive",
      "text": "Any firearm wielded by a rust hag gains the benefits of +1 striking and Ghost Touch runes, and it functions properly no matter how rusty it gets. In addition, when a rust hag critically hits a target with a firearm, the target must succeed at a DC 26 Fortitude save save or be Stunned 1.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "definition": [
