    {
      "kind": "ability",
      "name": "Adamantine Edges",
      "category": "offensive",
      "text": "The ghoul's claws have been dipped in adamantine. The razorclaw treats any object they hit with a claw Strike as if it had half as much Hardness and any creature they hit as if they had half as much physical resistance."
    },
    {
      "kind": "ability",
      "name": "Consume Flesh",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements The ghoul is adjacent to the corpse of a creature that died within the last hour.\n\n---\n\nEffect The ghoul devours a chunk of the corpse and regains 7d6 healing Hit Points.\n\nIt can regain Hit Points from any given corpse only once."
    },
    {
      "kind": "ability",
      "name": "Ghoul Fever",
      "category": "offensive",
      "traits": [
        "disease"
      ],
      "text": "Saving Throw DC 31 Fortitude save\n\n---\n\nStage 1 carrier with no ill effect (1 day)\n\nStage 2 4d6 void damage and regains half as many Hit Points from all healing (1 day)\n\nStage 3 as stage 2 (1 day)\n\nStage 4 4d6 void damage and gains no benefit from healing (1 day)\n\nStage 5 as stage 4 (1 day)\n\nStage 6 dead, and rises as a Ghoul the next midnight."
    },
    {
      "kind": "ability",
      "name": "Paralysis",
      "category": "offensive",
      "traits": [
        "incapacitation",
        "occult"
      ],
      "text": "Any living, non-elf creature hit by a ghoul's attack must succeed at a DC 31 Fortitude save save or become Paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The ghoul razorclaw deals an extra 3d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 3,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Surprise Attacker",
      "category": "offensive",
      "text": "On the first round of combat, creatures that haven't acted yet are Off-Guard to the ghoul razorclaw.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "EphemeralEffect",
            "predicate": [
              "encounter:round:1",
              {
                "lt": [
                  "self:participant:initiative:rank",
                  "target:participant:initiative:rank"
                ]
              }
            ],
            "selectors": [
              "strike-attack-roll",
              "spell-attack-roll",
              "strike-damage",
              "attack-spell-damage"
            ],
            "uuid": "Compendium.pf2e.conditionitems.Item.Off-Guard"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Swift Leap",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "move"
      ],
      "text": "The ghoul razorclaw jumps up to half its Speed. This movement doesn't trigger reactions."
    }
  ],
  "text": "Ghoul assassins who survive dipping their claws in molten adamantine transform into razorclaws."
