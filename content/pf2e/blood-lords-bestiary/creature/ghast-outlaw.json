    {
      "kind": "ability",
      "name": "Consume Flesh",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements The ghast is adjacent to the corpse of a creature that died within the last hour.\n\n---\n\nEffect The ghast devours a chunk of the corpse and regains 6d6 healing Hit Points\n\nIt can regain Hit Points from any given corpse only once."
    },
    {
      "kind": "ability",
      "name": "Ghast Fever",
      "category": "offensive",
      "traits": [
        "disease"
      ],
      "text": "Saving Throw DC 26 Fortitude save\n\n---\n\nStage 1 carrier with no ill effect (1 day)\n\nStage 2 3d8 void damage and regains half as many Hit Points from all healing (1 day)\n\nStage 3 as stage 2 (1 day)\n\nStage 4 3d8 void damage and gains no benefit from healing (1 day)\n\nStage 5 as stage 4 (1 day)\n\nStage 6 dead, and rises as a Ghast the next midnight"
    },
    {
      "kind": "ability",
      "name": "Paralysis",
      "category": "offensive",
      "traits": [
        "incapacitation",
        "occult"
      ],
      "text": "Any living creature hit by a ghast's attack must succeed at a DC 26 Fortitude save save or become Paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The ghast's Strikes deal an additional 2d6 precision damage to Off-Guard creatures.",
