    {
      "kind": "ability",
      "name": "Consume Flesh",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements The ghoul crocodile is adjacent to the corpse of a creature that died within the last hour\n\n---\nEffect The ghoul crocodile devours a chunk of the corpse and regains 2d6 healing Hit Points. It can regain HP from any given corpse only once."
    },
    {
      "kind": "ability",
      "name": "Death Roll",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "attack"
      ],
      "text": "Requirements The ghoul crocodile must have a creature Grabbed\n\n---\n\nEffect The ghoul crocodile tucks its legs and rolls rapidly, twisting its victim. It makes a jaws Strike with a +2 circumstance bonus to the attack roll against the grabbed creature. If it hits, it also knocks the creature Prone. If it fails, it releases the creature.",
      "rules": [
        {
          "key": "roll-option",
          "option": "death-roll",
          "domain": "attack-roll",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "jaws-attack",
          "type": "circumstance",
          "value": 2,
          "when": [
            "death-roll",
            "target:condition:grabbed"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Ghoul Fever",
      "category": "offensive",
      "traits": [
        "disease"
      ],
      "text": "Saving Throw DC 19 Fortitude save\n\n---\n\nStage 1 carrier with no ill effect (1 day)\n\nStage 2 2d6 void damage and regains half as many Hit Points from all healing (1 day)\n\nStage 3 as stage 2 (1 day)\n\nStage 4 2d6 void damage and gains no benefit from healing (1 day)\n\nStage 5 as stage 4 (1 day)\n\nStage 6 dead, and rises as a ghoul the next midnight"
    },
    {
      "kind": "ability",
      "name": "Paralysis",
      "category": "offensive",
      "traits": [
        "incapacitation",
        "occult"
      ],
      "text": "Any living non-elf creature hit by a ghoul crocodile's tail must succeed at a DC 20 Fortitude save save or become Paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
    },
