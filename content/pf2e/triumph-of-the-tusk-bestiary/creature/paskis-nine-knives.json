    },
    {
      "kind": "ability",
      "name": "Lightning Blades",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements Paskis is wielding two knives and targets an Off-Guard creature\n\n---\nEffect Paskis attempts two knife Strikes against the creature; these attacks increase her multiple attack penalty, but the penalty doesn't increase until after both attacks. This counts as a single melee attack for the purposes of Feinting."
    },
    {
      "kind": "ability",
      "name": "Mark for Death",
      "actions": 3,
      "category": "offensive",
      "text": "Requirements Paskis can observe the creature she intends to mark\n\n---\nEffect Paskis designates a single creature as her mark. This lasts until the mark dies or she uses Mark for Death again. She gains a +2 circumstance bonus to Perception checks to Seek the mark and on Deception checks to feint against the mark. In addition, her sneak attacks against her mark deal an additional 2 precision damage.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "option": "mark-for-death",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": [
            "perception",
            "deception"
          ],
          "type": "circumstance",
          "value": 2,
          "when": [
            "mark-for-death",
            {
              "or": [
                "action:seek",
                "action:feint"
              ]
            }
          ]
        },
        {
          "key": "modifier",
          "selector": "strike-damage",
          "type": "untyped",
          "value": 2,
          "when": [
            "mark-for-death",
            "target:condition:off-guard"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Poison Weapon",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Paskis draws a poison and applies it to a weapon. If her next attack with that weapon before the end of her next turn hits and deals damage, it applies the effects of the poison."
