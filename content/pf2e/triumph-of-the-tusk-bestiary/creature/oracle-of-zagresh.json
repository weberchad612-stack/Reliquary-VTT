    {
      "kind": "ability",
      "name": "Curse of the Destroyer's Bloodlust",
      "category": "offensive",
      "text": "After a turn where the oracle of Zagresh doesn't make a Strike, she takes a –2 status penalty to her AC and saving throws until she makes another Strike. During this penalty, she gains a +2 status bonus to her Strikes and fast healing 5.",
      "rules": [
        {
          "key": "roll-option",
          "option": "curse-of-the-destroyers-bloodlust",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": [
            "ac",
            "saving-throw"
          ],
          "type": "status",
          "value": -2,
          "when": [
            "curse-of-the-destroyers-bloodlust"
          ]
        },
        {
          "key": "modifier",
          "selector": "strike-attack-roll",
          "type": "status",
          "value": 2,
          "when": [
            "curse-of-the-destroyers-bloodlust"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "FastHealing",
            "predicate": [
              "curse-of-the-destroyers-bloodlust"
            ],
            "value": 5
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Destructive Touch",
      "actions": 2,
      "category": "offensive",
      "text": "Requirements Zagresh's Gaze is active\n\n---\nEffect The oracle's hands and tusks ooze acid, making a soft sizzling noise and dealing an additional 1d6 acid damage to her unarmed attacks.",
      "rules": [
        {
          "key": "roll-option",
