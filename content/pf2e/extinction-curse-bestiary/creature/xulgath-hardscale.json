    {
      "kind": "ability",
      "name": "Aggressive Block",
      "actions": "free",
      "category": "defensive",
      "text": "Trigger The hardscale uses the Shield Block reaction, and the opponent that triggered Shield Block is adjacent to the hardscale and is not more than one size larger than it\n\n---\n\nEffect The hardscale makes an Athletics check to shove options=aggressive-block the opponent. This shove doesn't increase the hardscale's multiple attack penalty. If they roll a critical failure, they get a failure instead. If they roll a success, they get a critical success instead.",
      "rules": [
        {
          "key": "degree",
          "selector": "athletics",
          "adjust": {
            "critical-failure": "one-degree-better",
            "success": "one-degree-better"
          },
          "when": [
            "action:shove",
            "aggressive-block"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Attack of Opportunity",
      "actions": "reaction",
      "category": "defensive"
    },
    {
      "kind": "ability",
      "name": "Hardscale Shield Stance",
      "category": "defensive",
      "text": "A hardscale always has their shield raised as if they had used the Raise a Shield action, as long as they meet that action's requirements.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "override",
            "path": "system.attributes.shield.raised",
            "predicate": [
              "self:shield:equipped",
              {
                "nor": [
                  "self:shield:broken",
                  "self:shield:destroyed"
                ]
              }
            ],
            "value": true
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Powerful Stench",
      "category": "defensive",
      "traits": [
        "aura",
        "olfactory"
      ],
      "text": "30 feet. A creature that enters the area must attempt a DC 32 Fortitude save save. On a failure, the creature is Sickened 2, and on a critical failure, the creature is also Slowed 1 for as long as it is sickened. While within the aura, the creature takes a -2 circumstance penalty to saves to recover from the sickened condition. A creature that succeeds at its save is temporarily immune to all xulgaths' stenches for 1 minute.",
      "rules": [
        {
          "key": "aura",
          "slug": "powerful-stench",
          "radius": 30,
          "traits": [
            "olfactory"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Shield Block",
      "actions": "reaction",
      "category": "defensive",
      "text": "At the beginning of each of their turns, the hardscale receives an additional reaction that they can use only for Shield Block.\n\n---"
    },
    {
      "kind": "ability",
      "name": "Shield Warden",
      "category": "defensive",
      "text": "If the hardscale has their shield raised, they can Shield Block when an attack is made against an adjacent ally. If they do, the shield prevents that ally from taking damage instead of the hardscale."
    },
    {
      "kind": "ability",
      "name": "Hammer Mastery",
      "category": "offensive",
      "text": "The hardscale deals an extra 1d8 damage with weapons with the shove trait, and weapons with the shove trait gain the deadly 2d8 trait when the hardscale uses them (both the extra weapon damage die and the deadly trait have already been included in the hardscale's warhammer Strike above).",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d8",
          "when": [
            "item:trait:shove"
          ]
        },
        {
          "key": "unsupported",
          "foundry": {
            "itemType": "melee",
            "key": "ItemAlteration",
            "mode": "add",
            "predicate": [
              "item:trait:shove"
            ],
            "property": "traits",
            "value": "deadly-2d8"
          }
        }
      ]
    }
