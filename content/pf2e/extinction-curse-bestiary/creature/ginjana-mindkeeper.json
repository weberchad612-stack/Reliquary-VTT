      "kind": "ability",
      "name": "Deny Advantage",
      "category": "defensive",
      "text": "Ginjana isn't Off-Guard to Hidden, Undetected, or flanking creatures of 11th level or lower, or by creatures of 11th level or lower using surprise attack.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "override",
            "path": "system.attributes.flanking.offGuardable",
            "value": 11
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Evasion",
      "category": "defensive",
      "text": "When Ginjana rolls a success on a Reflex save, she gets a critical success instead.",
      "rules": [
        {
          "key": "note",
          "selector": "reflex",
          "text": "{item|system.description.value}"
        },
        {
          "key": "degree",
          "selector": "reflex",
          "adjust": {
            "success": "one-degree-better"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Sidestep",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger An attack roll to Strike Ginjana fails or critically fails\n\n---\n\nEffect Ginjana redirects the attack to a creature of her choice that is adjacent to her and within reach of the triggering attack. The attacker rerolls the Strike's attack roll against the new target."
    },
    {
      "kind": "ability",
      "name": "Vulnerable to Sunlight",
      "category": "defensive",
      "text": "Ginjana takes 20 untyped damage for every hour she's exposed to sunlight."
    },
    {
      "kind": "ability",
      "name": "Hampering Blow",
      "category": "offensive",
      "text": "When Ginjana critically succeeds at an attack roll, the target of the attack is Clumsy 1 and Off-Guard until the end of Ginjana's next turn."
    },
    {
      "kind": "ability",
      "name": "Light Step",
      "category": "offensive",
      "text": "When Ginjana Strides or Steps, she ignores difficult terrain."
    },
    {
      "kind": "ability",
      "name": "Mobility",
      "category": "offensive",
      "text": "Ginjana's movement doesn't trigger reactions when she Strides to move half her Speed or less."
    },
    {
      "kind": "ability",
      "name": "Shadow Essence",
      "category": "offensive",
      "traits": [
        "poison"
      ],
      "text": "Saving Throw DC 29 Fortitude save\n\nMaximum Duration 6 rounds\n\nStage 1 3d6 void damage and 2d6 poison damage (1 round)\n\nStage 2 3d6 void damage, 2d6 poison damage, and Enfeebled 1 (1 round)\n\nStage 3 3d6 void damage; 2d6 poison damage; and Enfeebled 2 (1 round)"
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "Ginjana deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Surprise Attack",
      "category": "offensive",
      "text": "On the first round of combat, if Ginjana rolls Deception or Stealth for initiative, creatures that haven't acted are Off-Guard to her.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "EphemeralEffect",
            "predicate": [
              "encounter:round:1",
              {
                "lt": [
                  "self:participant:initiative:rank",
                  "target:participant:initiative:rank"
                ]
              },
              {
                "or": [
                  "self:participant:initiative:stat:deception",
                  "self:participant:initiative:stat:stealth"
                ]
              }
            ],
