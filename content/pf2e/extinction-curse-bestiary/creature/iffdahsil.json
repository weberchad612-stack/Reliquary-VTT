    {
      "kind": "ability",
      "name": "Eat Away",
      "category": "offensive",
      "text": "A creature that begins its turn inside Iffdahsil takes 10d6 void damage. Iffdahsil gains temporary HP for 1 minute equal to half the damage dealt."
