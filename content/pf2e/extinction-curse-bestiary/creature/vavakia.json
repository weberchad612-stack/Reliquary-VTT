    {
      "kind": "ability",
      "name": "Restoration Vulnerability",
      "category": "defensive",
      "text": "A vavakia is repulsed by the restoration of souls.\n\nThe demon takes 3d10+10 mental damage the first time each round that a creature within 100 feet of it is restored to life or loses the Doomed condition."
    },
    {
      "kind": "ability",
      "name": "Smoking Wound",
      "category": "offensive",
      "text": "A creature damaged by the vavakia's jaws is Sickened 1 from the rank smell of vapors from the wound."
    },
    {
      "kind": "ability",
      "name": "Soulfire Breath",
      "actions": 2,
      "category": "offensive",
      "traits": [
        "death",
        "divine",
        "void"
      ],
      "text": "The vavakia exhales ghostly green fire in a 60-foot cone.\n\nLiving creatures in the area take 20d6 void damage (DC 42 basic Reflex save save). A good creature that fails this save is becomes Stupefied 2 for 1 minute (Stupefied 4 on a critical failure).\n\nA creature slain by Soulfire Breath can't be resurrected except by powerful magic such as a Wish spell.\n\nThe vavakia can't use Soulfire Breath again for 1d4 rounds."
    },
    {
      "kind": "ability",
      "name": "Soulfire Inhalation",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "divine",
        "healing"
      ],
      "text": "Requirements The vavakia's last action was Soulfire Breath\n\n---\n\nEffect The vavakia inhales and regains 10 healing Hit Points for each creature damaged by its Soulfire Breath. Any excess healing is gained as temporary Hit Points, which remain for 1 minute."
    },
    {
      "kind": "ability",
      "name": "Stunning Tail",
      "category": "offensive",
      "traits": [
        "incapacitation"
      ],
      "text": "If the vavakia critically hits with its tail Strike, the target must succeed at a DC 40 Fortitude save save or be Stunned for 1 round (1d4 rounds on a critical failure)."
    },
    {
      "kind": "ability",
      "name": "Trample",
      "actions": 3,
      "category": "offensive",
      "text": "Large or smaller, claw, DC 40 basic Reflex save\n\n---"
