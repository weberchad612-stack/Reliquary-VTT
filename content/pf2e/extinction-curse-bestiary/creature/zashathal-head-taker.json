      "actions": 1,
      "category": "offensive",
      "traits": [
        "concentrate",
        "rage"
      ],
      "text": "Zashathal gains 12 temporary Hit Points.\n\nEffect: Renewed Vigor"
    },
    {
      "kind": "ability",
