      "name": "Attack of Opportunity (Special)",
      "actions": "reaction",
      "category": "defensive",
      "text": "Ledorick gains an additional reaction at the beginning of each of his turns that he can use only for an Attack of Opportunity.\n\n---"
    },
    {
      "kind": "ability",
      "name": "Dueling Riposte",
      "actions": "reaction",
      "category": "defensive",
      "text": "Requirements Ledorick is using Dueling Parry\n\nTrigger A creature within Ledorick's reach critically fails a Strike against him\n\n---\n\nEffect Ledorick makes a melee Strike against the triggering creature or attempts to Disarm the triggering creature."
    },
    {
      "kind": "ability",
      "name": "Juggernaut",
      "category": "defensive",
      "text": "When Ledorick rolls a success on a Fortitude save, it is a critical success instead.",
      "rules": [
        {
          "key": "note",
          "selector": "fortitude",
          "text": "{item|system.description.value}"
        },
        {
          "key": "degree",
          "selector": "fortitude",
          "adjust": {
            "success": "one-degree-better"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Possessed",
      "category": "defensive",
      "text": "Ledorick is possessed by the dybbuk Lyrt Cozurn, and he is controlled by the dybbuk. However, Ledorick's personality is strong; each time Ledorick takes Hit Point damage, Lyrt takes half of this damage as well (reduced by his Resistances, if applicable)."
    },
    {
      "kind": "ability",
      "name": "Dueling Parry",
      "actions": 1,
      "category": "offensive",
      "text": "Requirements Ledorick has a single one-handed melee weapon in one hand and has his other hand free\n\n---\n\nEffect Ledorick gains a +2 circumstance bonus to AC until the start of his next turn.",
      "rules": [
        {
          "key": "roll-option",
          "option": "dueling-parry",
          "domain": "ac",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "circumstance",
          "value": 2,
          "when": [
            "dueling-parry"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Guiding Finish",
      "actions": 1,
      "category": "offensive",
      "text": "Requirements Ledorick has a single one-handed melee weapon in one hand and has his other hand free\n\n---\n\nEffect Ledorick Strikes with the required weapon. On a hit, he moves the target up to 10 feet into a space he can reach, even moving the target through his own space. On a failed Strike, Ledorick can still move the target 5 feet in this way. This action can be used only if Ledorick has a multiple attack penalty."
    },
    {
      "kind": "ability",
      "name": "Show-Off",
      "category": "offensive",
      "text": "When Ledorick can see and be seen by at least two allies, his attacks deal 3d6 extra precision damage.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "damage",
          "dice": 3,
          "die": "d6",
          "category": "precision",
          "when": [
