    },
    {
      "kind": "ability",
      "name": "Psychogenic Secretions",
      "category": "defensive",
      "traits": [
        "aura",
        "mental"
      ],
      "text": "30 feet. A creature that enters the emanation must attempt a DC 42 Will save save.\n\nOn a failure, the creature is Stupefied 1 for 1 minute (Stupefied 2 and also Paralyzed for 1 round on a critical failure).\n\nA creature that succeeds at its save is temporarily immune to psychogenic secretions for 1 minute.",
      "rules": [
