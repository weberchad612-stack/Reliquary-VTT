        {
          "key": "note",
          "selector": [
            "saving-throw"
          ],
          "text": "{item|system.description.value}",
          "outcome": [
            "criticalSuccess"
          ],
          "when": [
            "item:magical"
          ]
        },
        {
          "key": "modifier",
