    {
      "kind": "ability",
      "name": "Death Stench",
      "category": "defensive",
      "traits": [
        "aura",
        "olfactory"
      ],
      "text": "30 feet. A creature that enters the area must attempt a DC 32 Fortitude save save. On a failure, the creature is Sickened 2 and Doomed 1 for as long as it is sickened; on a critical failure, the creature is instead Doomed 2 for as long as it is sickened. While within the aura, the creature takes a -2 circumstance penalty to saves to recover from the sickened condition. A creature that succeeds at its save is temporarily immune to any creature's death stench for 1 minute.",
      "rules": [
        {
          "key": "aura",
          "slug": "death-stench",
          "radius": 30,
          "traits": [
            "olfactory"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Void Healing",
      "category": "defensive",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "override",
            "path": "system.attributes.hp.negativeHealing",
            "value": true
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Drain Life",
      "category": "offensive",
      "traits": [
        "divine"
      ],
      "text": "When the Raptor Guard wight damages a living creature with a melee Strike, the wight gains 13 temporary Hit Points and the target creature must succeed at a DC 32 Fortitude save save or become Drained 1. Further damage dealt by the wight increases the drained condition by 1 on a failed save, to a maximum of drained 4.\n\nEffect: Drain Life",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "override",
            "path": "flags.system.drainLifeTempHP",
            "value": 13
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hungry Spear",
      "category": "offensive",
      "traits": [
        "divine"
      ],
      "text": "The Raptor Guard wight's ranged spear Strikes apply drain life, but the wight doesn't gain any temporary Hit Points if the attack hits.",
      "rules": [
        {
          "key": "note",
          "selector": "ranged-strike-damage",
          "text": "{item|system.description.value}",
          "outcome": [
            "success",
            "criticalSuccess"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Terror Master",
      "category": "offensive",
      "text": "As long as the Raptor Guard wears its dinosaur-skull helm, its Strikes deal an additional 1d10 void damage, or an additional 2d10 void damage to Frightened creatures.",
      "rules": [
        {
          "key": "roll-option",
          "option": "terror-master",
          "domain": "strike-damage",
          "toggleable": true,
          "label": "PF2E.NPCAbility.RaptorGuardWight.TerrorMaster",
          "default": true
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d10",
          "type": "void",
          "when": [
            "terror-master",
            "target:condition:frightened"
          ]
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 1,
          "die": "d10",
          "type": "void",
          "when": [
            "terror-master",
            {
              "not": "target:condition:frightened"
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Wight Spawn",
      "category": "offensive",
      "traits": [
        "divine"
      ],
      "text": "A living humanoid slain by a Raptor Guard wight's melee Strike rises as a Wight after 1d4 rounds. This wight spawn is under the command of the Raptor Guard that killed it. It doesn't have the drain life or wight spawn abilities and is Clumsy 2. If the creator of the wight spawn dies, the wight spawn becomes a full-fledged, autonomous wight; it regains its free will, gains the drain life and wight spawn abilities, and is no longer clumsy."
    }
  ],
  "blurb": "Variant wight"
