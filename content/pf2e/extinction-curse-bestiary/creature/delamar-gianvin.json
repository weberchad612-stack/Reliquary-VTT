    {
      "kind": "ability",
      "name": "Nimble Opportunist",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger A creature within Delamar's melee reach is hit by a melee attack from one of his allies\n\n---\n\nEffect Delamar makes a Strike against the triggering creature with a -2 penalty to the attack roll. He can't deal sneak attack damage on this Strike. After this Strike, Delamar can Stride without triggering reactions.",
      "rules": [
        {
          "key": "roll-option",
          "option": "nimble-opportunist",
          "domain": "attack-roll",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "attack-roll",
          "type": "untyped",
          "value": -2,
          "when": [
            "nimble-opportunist"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Surprise Attack",
      "category": "defensive",
      "text": "On the first round of combat, if Delamar rolled Deception or Stealth for initiative, creatures that haven't acted are Off-Guard to him.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "EphemeralEffect",
            "predicate": [
              "encounter:round:1",
              {
                "lt": [
                  "self:participant:initiative:rank",
                  "target:participant:initiative:rank"
                ]
              },
              {
                "or": [
                  "self:participant:initiative:stat:deception",
                  "self:participant:initiative:stat:stealth"
                ]
              }
            ],
            "selectors": [
              "strike-attack-roll",
              "spell-attack-roll",
              "strike-damage",
              "attack-spell-damage"
            ],
            "uuid": "Compendium.pf2e.conditionitems.Item.Off-Guard"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Quick Draw",
      "actions": 1,
      "category": "offensive",
      "text": "Delamar draws a weapon with an Interact action, then Strikes with the weapon he just drew."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "Delamar deals an extra 2d6 precision damage precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
