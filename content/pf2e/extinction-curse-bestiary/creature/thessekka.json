    },
    {
      "kind": "ability",
      "name": "Stone Throes",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "earth"
      ],
      "text": "Thessekka turns her own body into solid stone like a statue and immediately becomes Petrified. Any creature grabbed or restrained by her becomes Immobilized; to get free, the creature must damage the statue enough to break it or succeed at a DC 36 Acrobatics check check to Escape. The only action Thessekka can take while petrified is to use Stone Throes again to end the effect."
    },
