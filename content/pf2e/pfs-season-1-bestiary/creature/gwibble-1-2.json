      "kind": "ability",
      "name": "Self-Loathing",
      "category": "interaction",
      "traits": [
        "emotion",
        "mental"
      ],
      "text": "A mitflit's self-loathing makes it easy to influence. It takes a -4 penalty to its Will DC against checks to Coerce, Demoralize, Make an Impression, and Request.",
      "rules": [
        {
          "key": "modifier",
          "selector": "will",
          "type": "untyped",
          "value": -4,
          "when": [
            {
              "or": [
                "action:coerce",
                "action:demoralize",
                "action:make-an-impression",
                "action:request"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Vermin Empathy",
      "category": "interaction",
      "text": "Mitflits can use Diplomacy to make-an-impression on and request things of arthropods (insects, spiders, scorpions, crabs, and similar invertebrate animals). Most arthropods have a starting attitude of Indifferent to mitflits."
    },
    {
      "kind": "ability",
      "name": "Baleful Blade",
      "category": "offensive",
      "text": "Any creature affected by the Bane spell is Off-Guard to Gwibble."
