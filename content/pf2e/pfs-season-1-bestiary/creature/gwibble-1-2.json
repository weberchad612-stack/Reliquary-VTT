    {
      "kind": "ability",
      "name": "Vengeful Anger",
      "category": "offensive",
      "traits": [
        "emotion",
        "mental"
      ],
      "text": "As long as it isn't Frightened, a mitflit gains a +2 status bonus to damage rolls against a creature that has previously damaged or tormented it.",
