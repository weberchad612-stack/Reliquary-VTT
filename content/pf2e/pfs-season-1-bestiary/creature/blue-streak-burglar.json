      "category": "defensive",
      "text": "Trigger The burglar is targeted with a melee or ranged attack by an attacker they can see\n\n---\nEffect The burglar gains a +2 circumstance bonus to AC against the triggering attack.",
      "rules": [
        {
          "key": "roll-option",
          "option": "nimble-dodge",
          "domain": "ac",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "circumstance",
          "value": 2,
          "when": [
