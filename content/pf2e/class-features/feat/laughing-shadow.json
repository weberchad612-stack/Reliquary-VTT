  "system": "pf2e",
  "name": "Laughing Shadow",
  "source": {
    "title": "Pathfinder Impossible Magic",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 1,
  "traits": [
    "magus"
