{
  "kind": "feat",
  "slug": "enhanced-resistance",
  "system": "pf2e",
  "name": "Enhanced Resistance",
  "source": {
    "title": "Pathfinder Guns & Gears",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 7,
  "traits": [
    "inventor"
  ],
  "category": "classfeature",
  "text": "You've improved upon your initial modification's ability to resist damage. The resistance from your initial armor modification adds your full level, instead of half your level (for instance, phlogistonic regulator's resistance would increase to your level). If you have more than one initial modification that gives resistance, choose which one this applies to.",
  "rules": [
    {
      "key": "unsupported",
      "foundry": {
        "adjustName": false,
        "choices": [
          {
            "predicate": [
              "feature:harmonic-oscillator"
            ],
            "value": "Compendium.pf2e.classfeatures.Item.Harmonic Oscillator"
          },
          {
            "predicate": [
              "feature:metallic-reactance"
            ],
            "value": "Compendium.pf2e.classfeatures.Item.Metallic Reactance"
          },
          {
            "predicate": [
              "feature:otherworldly-protection"
            ],
            "value": "Compendium.pf2e.classfeatures.Item.Otherworldly Protection"
          },
          {
            "predicate": [
              "feature:phlogistonic-regulator"
            ],
            "value": "Compendium.pf2e.classfeatures.Item.Phlogistonic Regulator"
          }
        ],
        "key": "ChoiceSet",
        "prompt": "PF2E.SpecificRule.Inventor.Modification.Breakthrough.EnhancedResistancePrompt",
        "rollOption": "enhanced-resistance"
      }
    },
    {
      "key": "resistance",
      "type": "force",
      "value": "@level",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        "enhanced-resistance:harmonic-oscillator"
      ]
    },
    {
      "key": "resistance",
      "type": "force",
      "value": "@level + 2",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        "enhanced-resistance:harmonic-oscillator",
        {
          "or": [
            "self:effect:overdrive-success",
            "self:effect:overdrive-critical-success"
          ]
        }
      ]
    },
    {
      "key": "resistance",
      "type": "acid",
      "value": "@level",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        "enhanced-resistance:metallic-reactance"
      ]
    },
    {
      "key": "resistance",
      "type": "acid",
      "value": "@level + 2",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        "enhanced-resistance:metallic-reactance",
        {
          "or": [
            "self:effect:overdrive-success",
            "self:effect:overdrive-critical-success"
          ]
        }
      ]
    },
    {
      "key": "resistance",
      "type": "vitality",
      "value": "@level + 3",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        "enhanced-resistance:otherworldly-protection",
        "self:negative-healing"
      ]
    },
    {
      "key": "resistance",
      "type": "void",
      "value": "@level + 3",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        "enhanced-resistance:otherworldly-protection",
        {
          "not": "self:negative-healing"
        }
      ]
    },
    {
      "key": "resistance",
      "type": "spirit",
      "value": "@level + 3",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        "enhanced-resistance:otherworldly-protection"
      ]
    },
    {
      "key": "resistance",
      "type": "holy",
      "value": "@level + 3",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        "enhanced-resistance:otherworldly-protection",
