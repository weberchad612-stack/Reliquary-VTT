  "category": "classfeature",
  "text": "You designed your armor to inaudibly thrum at just the right frequency to create interference against force and sound waves. You gain resistance equal to 3 + half your level to force and sonic damage. When under the effects of Overdrive, the resistance increases by 2.",
  "rules": [
    {
      "key": "resistance",
      "type": "force",
      "value": "3 + floor(@level / 2)",
      "when": [
        "armor:id:{actor|flags.system.innovationId}"
      ]
    },
    {
      "key": "resistance",
      "type": "force",
      "value": "5 + floor(@level / 2)",
      "when": [
        "armor:id:{actor|flags.system.innovationId}",
        {
          "or": [
            "self:effect:overdrive-success",
            "self:effect:overdrive-critical-success"
          ]
        }
      ]
    }
  ]
