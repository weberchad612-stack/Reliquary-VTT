{
  "kind": "feat",
  "slug": "stylish-combatant",
  "system": "pf2e",
  "name": "Stylish Combatant",
  "source": {
    "title": "Pathfinder Player Core 2",
    "license": "ORC",
    "remaster": true,
    "from": "foundry-pf2e"
  },
  "level": 1,
  "category": "classfeature",
  "text": "You gain a +1 circumstance bonus to skill checks with the bravado trait while in a combat encounter. While you have panache, you gain a +5-foot status bonus to your Speeds.",
  "rules": [
    {
      "key": "modifier",
      "selector": "skill-check",
      "type": "circumstance",
      "value": 1,
      "slug": "stylish-combatant-skill",
      "when": [
        "item:trait:bravado",
        {
          "or": [
            "encounter",
            "feature:continuous-flair"
          ]
        }
      ]
    },
    {
      "key": "modifier",
      "selector": "speed",
      "type": "status",
      "value": 5,
      "slug": "stylish-combatant-speed",
      "when": [
        {
          "or": [
            "self:effect:panache",
            {
              "and": [
                "feature:vivacious-speed",
                {
                  "not": "self:effect:panache"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
