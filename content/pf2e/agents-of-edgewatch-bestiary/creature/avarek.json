          "foundry": {
            "key": "RollOption",
            "option": "prickly-defense",
            "toggleable": true
          }
        },
        {
          "key": "modifier",
          "selector": [
            "ac",
            "spine-attack"
          ],
          "type": "circumstance",
          "value": 2,
          "when": [
            "prickly-defense"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Rolling Assault",
      "actions": 2,
      "category": "offensive",
      "text": "The avarek curls into a ball and rolls rapidly, impaling enemies with its spines. The avarek Strides twice and makes up to two spine Strikes at any point during its movement, each against a different target within reach.\n\nThese attacks count toward the avarek's multiple attack penalty, but the penalty doesn't increase until after the avarek makes all the attacks."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "The avarek's Strikes deal an additional 2d6 precision damage to Off-Guard creatures.",
