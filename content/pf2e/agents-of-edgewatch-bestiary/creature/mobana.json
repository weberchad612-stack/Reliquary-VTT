    {
      "kind": "ability",
      "name": "Deny Advantage",
      "category": "defensive",
      "text": "Mobana isn't Off-Guard to creatures of 8th level or lower that are Hidden, Undetected, flanking or using Surprise Attack.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "ActiveEffectLike",
            "mode": "override",
            "path": "system.attributes.flanking.offGuardable",
            "value": 8
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Nimble Dodge",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger Mobana is targeted with a melee or ranged attack by an attacker they can see.\n\n---\n\nEffect Mobana gains a +2 circumstance bonus to AC against the triggering attack.",
      "rules": [
        {
          "key": "roll-option",
          "option": "nimble-dodge",
          "domain": "ac",
          "toggleable": true
        },
        {
          "key": "modifier",
          "selector": "ac",
          "type": "circumstance",
          "value": 2,
          "when": [
            "nimble-dodge"
          ]
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Poison Weapon",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "manipulate"
      ],
      "text": "Requirements Mobana is wielding a piercing or slashing weapon and has a free hand.\n\n---\n\nEffect Mobana applies a poison to the weapon."
    },
    {
      "kind": "ability",
      "name": "Quick Draw",
      "actions": 1,
      "category": "offensive",
      "text": "Mobana Interacts to draw a weapon, then Strikes with that weapon."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "Mobana deals an extra 2d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
