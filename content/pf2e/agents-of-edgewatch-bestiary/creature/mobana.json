      "kind": "ability",
      "name": "Supersonic Hearing",
      "category": "interaction",
      "text": "Mobana has spent years in close proximity to the Deafening Music Box in her possession and is immune to its effects. She also gains a +2 circumstance bonus against sonic effects and effects that impose the Deafened condition.",
      "rules": [
        {
          "key": "modifier",
          "selector": "saving-throw",
          "type": "circumstance",
          "value": 2,
          "when": [
            {
              "or": [
                "item:trait:sonic",
                "inflicts:deafened"
              ]
            }
          ]
        }
      ]
    },
