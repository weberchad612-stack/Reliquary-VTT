    {
      "kind": "ability",
      "name": "Warpwave Spell",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "arcane",
        "polymorph"
      ],
      "text": "Il'setsya infuses her next spell with roiling currents of chaos.\n\nIf Il'setsya Casts a Spell before her turn is over and the spell affects a creature, that creature is also subject to a Warpwave.\n\nIf she doesn't Cast a Spell before the beginning of her next turn, this action is wasted."
