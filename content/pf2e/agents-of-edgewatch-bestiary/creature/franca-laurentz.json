    {
      "kind": "ability",
      "name": "Deflective Dodge",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger The attack roll for a Strike targeting Franca fails or critically fails\n\n---\n\nEffect Franca can choose to either Step or redirect the attack to a creature that is adjacent to her and within the reach of the triggering attack.\n\nThe attacker rerolls the Strike's attack roll against the new target."
    },
    {
      "kind": "ability",
      "name": "Bloody Rebel",
      "actions": 2,
      "category": "offensive",
      "text": "Franca quickly slashes at nearby foes, aiming to maim rather than disable. She makes up to three melee Strikes, each against a different creature within reach.\n\nThese Strikes count toward Franca's multiple attack penalty, but the penalty doesn't increase until after all three Strikes are made.\n\nOn a hit, the Strike deals 3 bleed damage instead of its normal damage.\n\nOn a critical hit, the creature is Off-Guard until the beginning of Franca's next turn or until they spend an action to remove the condition, whichever comes first."
    },
    {
      "kind": "ability",
      "name": "Hamstring",
      "actions": 1,
      "category": "offensive",
      "text": "Requirements Franca's last action was a melee Strike that dealt sneak attack damage to an Off-Guard target\n\n---\n\nEffect Franca deals 6 bleed damage to the target creature, and the target is Slowed 1."
    },
    {
      "kind": "ability",
      "name": "Sneak Attack",
      "category": "offensive",
      "text": "Franca's Strikes deal an additional 3d6 precision damage to Off-Guard creatures.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "category": "precision",
            "diceNumber": 3,
            "dieSize": "d6",
            "key": "DamageDice",
            "predicate": [
              "target:condition:off-guard"
            ],
            "selector": "strike-damage"
          }
        },
        {
          "key": "unsupported",
          "foundry": {
            "key": "RollOption",
            "label": "PF2E.SpecificRule.TOTMToggle.OffGuard",
            "option": "target:condition:off-guard",
            "toggleable": "totm"
          }
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Splash Poison",
      "actions": 1,
      "category": "offensive",
      "text": "Franca uncorks and flings a dose of poison at a bleeding foe.\n\nShe retrieves a poison from her inventory, then splashes it at a creature within 10 feet that is currently taking Persistent Bleed Damage.\n\nThe creature must succeed at a DC 32 Reflex save save or be exposed to the poison."
    }
