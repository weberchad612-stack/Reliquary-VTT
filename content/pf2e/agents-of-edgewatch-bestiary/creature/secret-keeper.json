      "kind": "ability",
      "name": "Designate Apostate",
      "actions": 1,
      "category": "offensive",
      "traits": [
        "auditory",
        "concentrate",
        "divine",
        "visual"
      ],
      "text": "Velberi designates one creature she can see within 30 feet as an apostate to the church of Norgorber, regardless of the creature's actual religious leanings. She can have up to four apostates designated at a time; any additional apostate removes another apostate of her choice. Velberi treats all Perception checks made to Sense Motive against an apostate as one degree of success better, and her Strikes deal an additional 2d8 mental damage to apostates.",
      "rules": [
        {
          "key": "roll-option",
          "option": "designate-apostate",
          "toggleable": true
        },
        {
          "key": "degree",
          "selector": "perception",
          "adjust": {
            "all": "one-degree-better"
          },
          "when": [
            "action:sense-motive",
            "designate-apostate"
          ]
        },
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d8",
          "type": "mental",
          "when": [
