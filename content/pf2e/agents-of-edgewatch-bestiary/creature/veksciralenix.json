      "traits": [
        "aura",
        "emotion",
        "mental"
      ],
      "text": "90 feet. A creature that first enters the area must attempt a DC 42 Will save save.\n\nRegardless of the result of the saving throw, the creature is temporarily immune to the Veksciralenix's Alien Presence for 1 minute.\n\n---\n\nCritical Success The creature is unaffected.\n\nSuccess The creature is Slowed 1 for 1 round.\n\nFailure The creature is Slowed 1 for 1d4 rounds.\n\nCritical Failure The creature is Slowed 1 for 1 minute.",
      "rules": [
        {
          "key": "unsupported",
          "foundry": {
            "key": "Aura",
            "radius": 90,
            "slug": "alien-presence",
            "traits": [
              "emotion",
              "mental"
            ]
          }
        }
      ]
    },
