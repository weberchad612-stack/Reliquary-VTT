        "max": 7,
        "per": "day"
      }
    },
    {
      "kind": "ability",
      "name": "Poison Conversion",
      "actions": "free",
      "category": "offensive",
      "text": "Frequency 3 times per day\n\n---\n\nEffect If Grabble's next action is to cast a cantrip or a spell that is 6th rank or lower and deals acid, cold, electricity, or fire damage, the spell deals poison damage rather than its normal damage type and gains the poison trait.",
      "frequency": {
        "max": 3,
        "per": "day"
      },
