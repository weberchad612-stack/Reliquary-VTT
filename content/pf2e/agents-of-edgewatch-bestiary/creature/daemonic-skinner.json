    {
      "kind": "ability",
      "name": "Bloody Chain Aura",
      "category": "defensive",
      "traits": [
        "aura",
        "divine"
      ],
      "text": "20 feet. Chains of blood bind a bleeding creature to the Daemonic Skinner.\n\nCreatures in range that are taking Persistent Bleed Damage can't move out of the aura.\n\nThe Skinner can have only one aura active at a time.\n\nShe can switch her active aura as an Interact action.",
      "rules": [
        {
          "key": "aura",
          "slug": "bloody-chain-aura",
          "radius": 20,
          "traits": [
            "divine"
          ],
          "when": [
            "bloody-chain-aura-active"
          ]
        },
        {
          "key": "roll-option",
          "option": "bloody-chain-aura-active",
          "toggleable": true,
          "default": true
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Spell Choke",
      "actions": "reaction",
      "category": "defensive",
      "text": "Trigger A creature taking Persistent Bleed Damage within 30 feet of the Daemonic Skinner Casts a Spell with a verbal component or speaks\n\n---\n\nEffect The Skinner wills the triggering creature's blood to gush from their mouth and constrict their throat. The target's spell is disrupted.\n\nThe target must succeed at a DC 47 Fortitude save save or become Sickened 2."
    },
    {
      "kind": "ability",
      "name": "Transfusion Aura",
      "category": "defensive",
      "traits": [
        "aura",
        "divine",
        "healing"
      ],
      "text": "30 feet. Any time a creature in the aura takes Persistent Bleed Damage, the Daemonic Skinner regains the same number of Hit Points as the damage dealt.\n\nThe Skinner can have only one aura active at a time.\n\nShe can switch her active aura as an Interact action.",
      "rules": [
        {
          "key": "aura",
          "slug": "transfusion-aura",
          "radius": 30,
          "traits": [
            "divine",
            "healing"
          ],
          "when": [
            "transfusion-aura-active"
          ]
        },
        {
          "key": "roll-option",
          "option": "transfusion-aura-active",
          "toggleable": true
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Bloody Sneak Attack",
      "category": "offensive",
      "text": "Any creature taking Persistent Bleed Damage is Off-Guard against the Daemonic Skinner's attacks. When attacking an off-guard creature, the Skinner deals an additional 2d6 precision damage.",
      "rules": [
        {
          "key": "damage-dice",
          "selector": "strike-damage",
          "dice": 2,
          "die": "d6",
          "category": "precision",
          "when": [
            "target:condition:off-guard"
          ]
        },
        {
          "key": "ephemeral",
          "selector": [
            "strike-attack-roll",
            "spell-attack-roll",
            "strike-damage",
            "attack-spell-damage"
          ],
          "affects": "target",
          "condition": "off-guard",
          "when": [
            "target:condition:persistent-damage:bleed"
          ]
        },
        {
          "key": "roll-option",
          "option": "target:condition:off-guard",
          "toggleable": true,
          "label": "PF2E.SpecificRule.TOTMToggle.OffGuard"
        }
      ]
    },
    {
      "kind": "ability",
      "name": "Hook and Flay",
      "actions": 2,
      "category": "offensive",
      "text": "Requirements The Daemonic Skinner has a creature Grabbed with her blood chain or a creature is affected by her bloody chain aura\n\n---\n\nEffect The Skinner pulls the creature into the nearest open adjacent square and makes a cleaver Strike against the creature."
