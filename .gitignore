# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/

# Dependencies and build output
node_modules/
dist/
build/
*.log

# Local environment and secrets
.env
.env.*
*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# User data: never commit book content or campaign saves.
# Anchored to the repo root so examples/ can hold open-licensed samples.
# Local source PDFs (large, third-party rulebooks)
/pdfsource/
# Text and images extracted from those PDFs
/extracted/
# Private adventure packs built from the user's own books
/packs/
# Campaign saves
/saves/
# Per-user configuration created at setup
/config.local.json

# Scratch folders
_tmp/
tmp/
tmp_view/
.cache/
