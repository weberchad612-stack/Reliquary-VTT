{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "Adventure events and flags (saves/<campaign>/events.json)",
  "description": "Each event of the adventure as defined by the pack (adventure.json events: trigger, stages, actions; engine/events/events.js) with its state in play (status, stage, history, decisions), and the campaign's flags. On the board each event is a record events/<id>; the flags are state/flags. An update from the pack (campaign.mjs --update) replaces the definitions and keeps the state. Subsystems (Victory Points, Influence, Chase, Infiltration, Research; engine/events/subsystem.js) are kept here too, one record subsystems/<id> each.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "trigger",
          "stages"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "combat",
              "social",
              "challenge",
              "timed",
              "location",
              "story"
            ]
          },
          "pages": {
            "type": "string"
          },
          "where": {
            "type": "object",
            "properties": {
              "map": {
                "type": "string"
              },
              "area": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "trigger": {
            "type": "object"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "when": {
                  "type": "object"
                },
                "actions": {
                  "type": "array"
                },
                "branches": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "if",
                      "go"
                    ],
                    "properties": {
                      "if": {
                        "type": "object"
                      },
                      "go": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "next": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "repeat": {
            "type": "object",
            "properties": {
              "cooldown": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "note": {
            "type": "string"
          },
          "status": {
            "enum": [
              "waiting",
              "running",
              "done",
              "cooldown"
            ]
          },
          "stage": {
            "type": "string"
          },
          "started": {
            "type": "number"
          },
          "stage_at": {
            "type": "number"
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "last": {
            "type": "number"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "number"
                },
                "what": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "decisions": {
            "type": "object"
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Other areas the event covers (the area checklist counts it for each)."
          }
        },
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "object",
      "description": "Flags set by events and Claude (a fight ended: 'ended:<group>' with the game time; anything the adventure tracks)."
    },
    "subsystems": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "kind",
          "status",
          "tracks",
          "scoring"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "pages": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "status": {
            "enum": [
              "waiting",
              "active",
              "success",
              "failure",
              "done"
            ]
          },
          "shown": {
            "type": "boolean",
            "description": "Shown to the players (their card)."
          },
          "tracks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "goal": {
                  "type": "number"
                },
                "hidden": {
                  "type": "boolean"
                },
                "thresholds": {
                  "$ref": "#/$defs/thresholds"
                }
              },
              "additionalProperties": false
            }
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "revealed": {
                  "type": "boolean"
                },
                "goal": {
                  "type": "number"
                },
                "value": {
                  "type": "number"
                },
                "individual": {
                  "type": "boolean"
                },
                "per": {
                  "type": "object"
                },
                "done": {
                  "type": "boolean"
                },
                "thresholds": {
                  "$ref": "#/$defs/thresholds"
                },
                "scoring": {
                  "type": "object"
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "skill"
                    ],
                    "properties": {
                      "skill": {
                        "type": "string"
                      },
                      "dc": {
                        "type": "number"
                      },
                      "revealed": {
                        "type": "boolean"
                      },
                      "note": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "revealed": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "scoring": {
            "type": "object",
            "properties": {
              "criticalSuccess": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "success": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "failure": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "criticalFailure": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            },
            "additionalProperties": false
          },
          "rounds": {
            "type": "object",
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "limit": {
                "type": "integer",
                "minimum": 1
              },
              "each": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            },
            "additionalProperties": false
          },
          "log": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "id"
        ],
        "properties": {
          "at": {
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "revealed": {
            "type": "boolean"
          },
          "reached": {
            "type": "number"
          },
          "dc": {
            "type": "number"
          },
          "end": {
            "enum": [
              "success",
              "failure"
            ]
          },
          "flag": {
            "type": "string"
          },
          "falling": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
