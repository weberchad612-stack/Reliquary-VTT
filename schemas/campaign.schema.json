{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weberchad612-stack/Reliquary-VTT/schemas/campaign.schema.json",
  "title": "Campaign",
  "description": "A campaign save's own record (campaign.json in the save folder): which pack and ruleset it plays, and the table's settings. Per-map state is in maps/<id>.json. See docs/design/board.md.",
  "type": "object",
  "required": [
    "v",
    "id",
    "pack",
    "ruleset"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 48
    },
    "title": {
      "type": "string"
    },
    "pack": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "ruleset": {
      "type": "string"
    },
    "clock": {
      "type": "object",
      "description": "The game clock (tools/clock.mjs): seconds since the start of year 1 of the ruleset's calendar. `start` is when the adventure began (Day 1).",
      "required": ["now"],
      "additionalProperties": false,
      "properties": {
        "now": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0 }
      }
    },
    "encounter": {
      "type": "object",
      "description": "The encounter under way (tools/encounter.mjs; engine/time/encounter.js): round, the index of the creature acting, and the combatants in initiative order.",
      "required": ["round", "combatants"],
      "additionalProperties": false,
      "properties": {
        "round": { "type": "integer", "minimum": 0 },
        "turn": { "type": ["integer", "null"], "minimum": 0 },
        "started": { "type": "integer", "minimum": 0 },
        "ended": { "type": "integer", "minimum": 0 },
        "combatants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["token"],
            "additionalProperties": false,
            "properties": {
              "token": { "type": "string", "pattern": "^tok-[0-9a-z]{8}$" },
              "side": { "enum": ["pc", "foe", "npc"] },
              "initiative": { "type": "number" },
              "delayed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "current_map": {
      "type": "string",
      "description": "The map the table is on."
    },
    "discovered": {
      "type": "array",
      "description": "Maps the party has discovered (listed in the player view's map menu). Set by Claude, never automatically.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "sky_light": {
      "enum": [
        "bright",
        "dim",
        "dark"
      ]
    },
    "light_colour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "boolean"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "light_animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "object",
      "description": "Free text for the board's side panel (a test campaign's tips).",
      "properties": {
        "subtitle": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "tips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "saved_at": {
      "type": "string",
      "description": "When this save was last written from the board."
    }
  }
}
