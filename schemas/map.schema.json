{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weberchad612-stack/Reliquary-VTT/schemas/map.schema.json",
  "title": "Map record",
  "description": "One map in an adventure pack. A battle map (the default) has an image, grid calibration, wall file and links to other maps; an area map (kind \"area\": a town, a region) has an image and places, and no grid; a landing page (kind \"landing\") is only a picture, such as the adventure's cover, where the party waits as players join. See docs/design/maps.md section 3.",
  "type": "object",
  "required": [
    "id",
    "name",
    "image"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "battle",
        "area",
        "landing"
      ],
      "default": "battle",
      "description": "battle: a grid map with walls, tokens and fog. area: a picture with places (a town), shown fitted to the window; travel and requests only. landing: a picture only (the adventure's cover), shown fitted to the window, where the party waits while players join; only the GM moves the party on and off it."
    },
    "image": {
      "type": "object",
      "required": [
        "file",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.(png|jpe?g|webp)$"
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "cell_px",
        "origin_px",
        "cols",
        "rows",
        "feet_per_cell"
      ],
      "additionalProperties": false,
      "properties": {
        "cell_px": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Size of one grid cell in image pixels."
        },
        "origin_px": {
          "$ref": "#/$defs/point",
          "description": "Pixel position of the top-left corner of cell (0,0); may be negative."
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "feet_per_cell": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "outdoor": {
      "type": "boolean",
      "default": false,
      "description": "Outdoor map: lit by the sky (bright by day; the save's sky_light can make it dim or dark)."
    },
    "base_light": {
      "enum": [
        "bright",
        "dim",
        "dark"
      ],
      "description": "Light level of an indoor map away from regions and lights. Default: bright when no lighting is given, else dark."
    },
    "lighting": {
      "description": "Lighting file name (regions and static lights); see lighting.schema.json. Optional.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.json$"
    },
    "terrain": {
      "description": "Terrain file name (difficult terrain, water, slopes); see terrain.schema.json. Optional.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.json$"
    },
    "walls": {
      "description": "Wall file name, or several files for a large map.",
      "oneOf": [
        {
          "$ref": "#/$defs/jsonFile"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonFile"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "at",
          "to_map",
          "arrive"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cell"
            },
            "minItems": 1
          },
          "to_map": {
            "$ref": "#/$defs/id"
          },
          "to_link": {
            "$ref": "#/$defs/id",
            "description": "The entrance on to_map this one arrives at (its partner, which leads back here)."
          },
          "arrive": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cell"
            },
            "minItems": 1
          },
          "found": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "start": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      },
      "minItems": 1,
      "description": "Battle maps: the starting area, where the party is placed when it travels here without an entrance (from the map menu or an area map), in order; more PCs overflow onto the nearest free squares that can be walked to."
    },
    "note": {
      "type": "string",
      "description": "GM-only note."
    },
    "hidden_areas": {
      "description": "Parts of the image that are not this map (insets of other maps, legends). The board always covers them; sight and fog ignore them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cells"
        ],
        "additionalProperties": false,
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "places": {
      "description": "Area maps: the places shown as pins. Players see public places and those found in play (places_found in the map's state); the GM sees all.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "string",
            "description": "The location number printed on the map image, if any (\"14\", \"A3\"): shown before the name. The pin is a ring around it and never covers it."
          },
          "type": {
            "type": "string",
            "description": "What kind of place it is (\"Tavern and inn\")."
          },
          "address": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "A short description players may read."
          },
          "gm_note": {
            "type": "string",
            "description": "GM-only note."
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "The pin's centre, in image pixels."
          },
          "shape": {
            "enum": [
              "round",
              "wide"
            ],
            "default": "round"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "The pin's width in image pixels (default: 4.5% of the image width; a wide pin is 5.5 times as wide as it is tall)."
          },
          "public": {
            "type": "boolean",
            "default": true,
            "description": "false: GM-only until found in play."
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 64
    },
    "jsonFile": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.json$"
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "cell": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "landing"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "grid": false,
          "walls": false,
          "links": false,
          "terrain": false,
          "lighting": false,
          "start": false,
          "places": false,
          "hidden_areas": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "area"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "places"
        ],
        "properties": {
          "grid": false,
          "walls": false,
          "links": false,
          "terrain": false,
          "lighting": false,
          "start": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "area",
              "landing"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {},
      "else": {
        "required": [
          "grid",
          "walls"
        ],
        "properties": {
          "places": false
        }
      }
    }
  ]
}
