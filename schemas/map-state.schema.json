{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weberchad612-stack/Reliquary-VTT/schemas/map-state.schema.json",
  "title": "Map state",
  "description": "What has changed on one map during play, stored in the campaign save. See docs/design/maps.md section 7.",
  "type": "object",
  "required": ["map"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "map": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "doors": {
      "description": "Only doors that differ from their initial state, plus found secret doors. Keyed by door id.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "state": { "enum": ["closed", "open", "locked"] },
          "found": { "type": "boolean" }
        }
      }
    },
    "terrain": {
      "description": "Temporary terrain added during play (a spell, an ability), with source and until.",
      "type": "array",
      "items": { "$ref": "https://github.com/weberchad612-stack/Reliquary-VTT/schemas/terrain.schema.json#/$defs/area" }
    },
    "terrain_on": {
      "description": "Ids of pack terrain areas that start switched off (active: false) and now apply (the bridge has collapsed).",
      "type": "array", "items": { "type": "string" }, "uniqueItems": true
    },
    "terrain_off": {
      "description": "Ids of pack terrain areas that no longer apply (rubble cleared, water drained).",
      "type": "array", "items": { "type": "string" }, "uniqueItems": true
    },
    "locked_known": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "links_found": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "explored": {
      "type": "object",
      "required": ["v", "polys"],
      "additionalProperties": false,
      "properties": {
        "v": { "type": "integer", "minimum": 0, "description": "Increases on every change." },
        "polys": {
          "description": "Closed rings in cell coordinates at 1/8 cell precision. Outer rings and holes use opposite winding.",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "sky_light": {
      "enum": ["bright", "dim", "dark"],
      "description": "Current sky light (outdoor maps and sky regions): bright by day, dim at dusk, dark at night. Default bright."
    },
    "lights": {
      "description": "Changes to the map's static lights in play, by id (missing: as the pack gives them): on/off, colour and intensity.",
      "type": "object",
      "additionalProperties": {
        "type": "object", "minProperties": 1, "additionalProperties": false,
        "properties": { "on": { "type": "boolean" }, "colour": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|none)$", "description": "Colour for drawing, #rrggbb, or none (uncoloured)." }, "intensity": { "type": "number", "minimum": 0, "maximum": 100, "description": "Intensity for drawing, 0-100 % (default 100)." }, "animation": {
      "type": "object", "additionalProperties": false,
      "description": "How the light moves on the board (drawing only; the rules never change). Presets bring a natural default.",
      "properties": {
        "type": { "enum": ["none", "torch", "flicker", "pulse", "ghostly", "chroma"] },
        "speed": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5, "description": "How strong the effect is." },
        "reverse": { "type": "boolean", "default": false, "description": "Reverse direction (chroma: the hues turn the other way)." }
      }
    } }
      }
    },
    "regions_off": {
      "description": "Ids of lighting regions that no longer apply (a magical light dispelled).",
      "type": "array", "items": { "type": "string" }, "uniqueItems": true
    },
    "regions": {
      "description": "Colour and intensity of lighting regions changed in play, by id (missing: as the pack gives them).",
      "type": "object",
      "additionalProperties": {
        "type": "object", "minProperties": 1, "additionalProperties": false,
        "properties": { "colour": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|none)$", "description": "Colour for drawing, #rrggbb, or none (uncoloured)." }, "intensity": { "type": "number", "minimum": 0, "maximum": 100, "description": "Intensity for drawing, 0-100 % (default 100)." } }
      }
    },
    "light_animation": {
      "type": "object", "additionalProperties": false,
      "description": "Light animation on the board for the whole table (drawing only).",
      "properties": { "on": { "type": "boolean", "default": true, "description": "The GM's switch for animated lights." } }
    },
    "light_colour": {
      "type": "object", "additionalProperties": false,
      "description": "Coloured light on the board for the whole table (drawing only).",
      "properties": {
        "on": { "type": "boolean", "default": true, "description": "The GM's switch for coloured light." },
        "strength": { "type": "number", "minimum": 0, "maximum": 100, "default": 25, "description": "Strongest tint, % of full colour (subtle by default)." }
      }
    },
    "tokens": {
      "description": "Token positions on this map. The token schema is defined separately; positions, carried lights and senses are checked here.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "light": {
            "description": "A light the token carries (always a circle). Presets come from the ruleset.",
            "type": "object", "additionalProperties": false,
            "anyOf": [{ "required": ["preset"] }, { "required": ["bright"] }, { "required": ["dim"] }],
            "properties": {
              "preset": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
              "bright": { "type": "number", "minimum": 0 },
              "dim": { "type": "number", "minimum": 0 },
              "on": { "type": "boolean", "default": true },
              "colour": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|none)$", "description": "Colour for drawing, #rrggbb, or none (uncoloured)." },
              "intensity": { "type": "number", "minimum": 0, "maximum": 100, "description": "Intensity for drawing, 0-100 % (default 100)." },
              "animation": {
      "type": "object", "additionalProperties": false,
      "description": "How the light moves on the board (drawing only; the rules never change). Presets bring a natural default.",
      "properties": {
        "type": { "enum": ["none", "torch", "flicker", "pulse", "ghostly", "chroma"] },
        "speed": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5, "description": "How strong the effect is." },
        "reverse": { "type": "boolean", "default": false, "description": "Reverse direction (chroma: the hues turn the other way)." }
      }
    },
              "label": { "type": "string" }
            }
          },
          "senses": {
            "description": "Senses beyond normal vision as the ruleset names them (low-light, darkvision, greater-darkvision), optionally with a range in feet; a temporary one (a spell) gives its source.",
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^[a-z][a-z-]*$" },
                { "type": "object", "required": ["type"], "additionalProperties": false,
                  "properties": { "type": { "type": "string", "pattern": "^[a-z][a-z-]*$" }, "range": { "type": "number", "minimum": 0 }, "source": { "type": "string" } } }
              ]
            }
          }
        }
      }
    }
  }
}
