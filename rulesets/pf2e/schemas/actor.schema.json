{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weberchad612-stack/Reliquary-VTT/schemas/rulesets/pf2e/actor.schema.json",
  "title": "PF2E actor",
  "description": "A Pathfinder 2E creature: a character's build, or an NPC (a stat block reference with differences, or a whole stat block).",
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z-]*$"
        },
        "selector": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "type": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "slug": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "when": {},
        "except": {
          "type": "string"
        },
        "range": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "acuity": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "outcome": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "damageType": {
          "type": "string"
        },
        "foundry": {
          "type": "object",
          "description": "An imported rule this ruleset does not support yet, kept as it was."
        },
        "option": {
          "type": "string"
        },
        "toggleable": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "domain": {
          "type": "string"
        },
        "add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dice": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "die": {
          "type": "string",
          "pattern": "^d(4|6|8|10|12|20)$"
        },
        "category": {
          "type": "string"
        },
        "critical": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "add",
            "remove"
          ]
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "adjust": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "keep": {
          "enum": [
            "higher",
            "lower"
          ]
        },
        "affects": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "onCreate": {
          "type": "boolean"
        },
        "onTurnStart": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "fast-healing",
            "regeneration"
          ]
        },
        "deactivatedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "radius": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "affects"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "affects": {
                "enum": [
                  "enemies",
                  "allies",
                  "all"
                ]
              },
              "save": {
                "type": "object"
              },
              "includesSelf": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "bright": {
          "type": "number"
        },
        "dim": {
          "type": "number"
        },
        "colour": {
          "type": "string"
        },
        "size": {
          "enum": [
            "tiny",
            "small",
            "medium",
            "large",
            "huge",
            "gargantuan"
          ]
        }
      },
      "additionalProperties": false,
      "description": "A rule element: the engine's keys (modifier, resistance, weakness, immunity, speed, sense, note) and PF2E's own (rulesets/pf2e/rule-keys.js), or an imported rule not supported yet (foundry)."
    },
    "character": {
      "type": "object",
      "required": [
        "system",
        "kind",
        "name",
        "level",
        "ancestry",
        "class",
        "attributes",
        "proficiencies"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "system": {
          "const": "pf2e"
        },
        "kind": {
          "const": "character"
        },
        "name": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "ancestry": {
          "type": "object",
          "required": [
            "name",
            "hp",
            "speed"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "hp": {
              "type": "integer",
              "minimum": 0
            },
            "size": {
              "enum": [
                "tiny",
                "small",
                "medium",
                "large",
                "huge",
                "gargantuan"
              ]
            },
            "speed": {
              "type": "integer",
              "minimum": 0
            },
            "traits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "senses": {
              "type": "array"
            }
          }
        },
        "heritage": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "class": {
          "type": "object",
          "required": [
            "name",
            "hp",
            "keyAttribute"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "hp": {
              "type": "integer",
              "minimum": 0
            },
            "keyAttribute": {
              "enum": [
                "str",
                "dex",
                "con",
                "int",
                "wis",
                "cha"
              ]
            }
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "str": {
              "type": "integer",
              "minimum": -5,
              "maximum": 10
            },
            "dex": {
              "type": "integer",
              "minimum": -5,
              "maximum": 10
            },
            "con": {
              "type": "integer",
              "minimum": -5,
              "maximum": 10
            },
            "int": {
              "type": "integer",
              "minimum": -5,
              "maximum": 10
            },
            "wis": {
              "type": "integer",
              "minimum": -5,
              "maximum": 10
            },
            "cha": {
              "type": "integer",
              "minimum": -5,
              "maximum": 10
            }
          }
        },
        "proficiencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "perception": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "fortitude": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "reflex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "will": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "classDC": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "armor": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "weapons": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "skills": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "lore": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "spellcasting": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "definitions": {
              "description": "Proficiencies a feature defines for weapons that match a Foundry item predicate (Fighter Weapon Mastery's group, Monastic Weaponry): {slug: {when, sameAs?, max?}}. The rank is weapons[slug], or with sameAs the rank of weapons[sameAs] up to max.",
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "when"
                ],
                "additionalProperties": false,
                "properties": {
                  "when": {
                    "type": "array"
                  },
                  "sameAs": {
                    "type": "string"
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  }
                }
              }
            }
          }
        },
        "spellcasting": {
          "type": "object",
          "required": [
            "tradition",
            "attribute"
          ],
          "properties": {
            "tradition": {
              "enum": [
                "arcane",
                "divine",
                "occult",
                "primal"
              ]
            },
            "attribute": {
              "enum": [
                "str",
                "dex",
                "con",
                "int",
                "wis",
                "cha"
              ]
            },
            "kind": {
              "enum": [
                "prepared",
                "spontaneous",
                "innate"
              ]
            }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string"
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/rule"
                    }
                  },
                  "text": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "level": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "feats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "rules": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/rule"
                }
              },
              "text": {
                "type": "string"
              },
              "ref": {
                "type": "string",
                "description": "The feat's content key (a built character's)."
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20,
                "description": "The level it was taken at."
              },
              "slot": {
                "type": "string",
                "description": "Which slot it fills: ancestry, class, general, skill, background, or a feature's grant."
              },
              "from": {
                "type": "string",
                "description": "For a granted feat: what granted it (Versatile Human, a class feature)."
              }
            },
            "additionalProperties": false
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^(?:[a-z0-9][a-z0-9-]*:)?item/[a-z0-9][a-z0-9-]*$"
              },
              "equipped": {
                "type": "boolean"
              },
              "runes": {
                "type": "object"
              },
              "name": {
                "type": "string"
              },
              "rules": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/rule"
                }
              },
              "qty": {
                "type": "integer",
                "minimum": 2,
                "description": "how many (missing: 1)"
              },
              "carry": {
                "enum": [
                  "held",
                  "worn",
                  "stowed"
                ],
                "description": "how it is carried (missing: in use, as before Party loot). Stowed items are not in use; armor works worn; an invested item worn and invested (rulesets/pf2e/loot.js inUse)"
              },
              "invested": {
                "type": "boolean",
                "description": "false: a worn invested item not invested (missing: invested)"
              },
              "identified": {
                "type": "boolean"
              },
              "misidentified": {
                "type": "object"
              },
              "mystery": {
                "type": "string"
              },
              "appraised": {
                "type": "boolean"
              },
              "found": {
                "type": "object",
                "description": "where it was found (board/loot.js)"
              },
              "text": {
                "type": "string"
              },
              "price": {
                "type": "object"
              },
              "bulk": {
                "type": "number",
                "minimum": 0
              },
              "kind": {
                "type": "string"
              },
              "traits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rarity": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              },
              "usage": {
                "type": "string"
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "max": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "note": {
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "granted": {
          "type": "array",
          "description": "Other things the build's rules grant (actions, effects): name, kind, content ref and what granted them.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "from": {
                "type": "string"
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The languages the character knows (slugs)."
        }
      }
    },
    "npc": {
      "type": "object",
      "required": [
        "system",
        "kind"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "system": {
          "const": "pf2e"
        },
        "kind": {
          "const": "npc"
        },
        "base": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "usesDying": {
          "type": "boolean",
          "description": "Knocked out and dying at 0 HP, as a character, rather than dead."
        },
        "level": {
          "type": "integer"
        },
        "stats": {
          "type": "object"
        },
        "items": {
          "type": "array"
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "build": {
      "type": "object",
      "description": "The player's choices that make this character (rulesets/pf2e/build.js; docs/design/game-data.md section 9): the character's numbers are worked out from them.",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "ancestry": {
          "type": "string"
        },
        "heritage": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "keyAttribute": {
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha"
          ]
        },
        "boosts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ancestry": {
              "type": "array",
              "items": {
                "enum": [
                  "str",
                  "dex",
                  "con",
                  "int",
                  "wis",
                  "cha",
                  null
                ]
              }
            },
            "background": {
              "type": "array",
              "items": {
                "enum": [
                  "str",
                  "dex",
                  "con",
                  "int",
                  "wis",
                  "cha",
                  null
                ]
              }
            },
            "free": {
              "type": "array",
              "items": {
                "enum": [
                  "str",
                  "dex",
                  "con",
                  "int",
                  "wis",
                  "cha"
                ]
              },
              "maxItems": 4
            }
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trained": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lore": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "levels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([1-9]|1[0-9]|20)$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "feats": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "boosts": {
                "type": "array",
                "items": {
                  "enum": [
                    "str",
                    "dex",
                    "con",
                    "int",
                    "wis",
                    "cha"
                  ]
                },
                "maxItems": 4
              },
              "skillIncrease": {
                "type": "string"
              },
              "trained": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "selections": {
                "type": "object"
              },
              "spells": {
                "type": "object"
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Languages an Intelligence increase at this level adds."
              }
            }
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "what",
              "by"
            ],
            "properties": {
              "what": {
                "type": "string"
              },
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        },
        "name": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "selections": {
          "type": "object",
          "description": "The answers to the content's own \"pick one\" rules, by \"<item slug>.<flag>\": a value, or a content key for a choice of item (docs/design/game-data.md 9.6).",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "deity": {
          "type": "string",
          "description": "The deity, a content key (deities:deity/<slug>)."
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Languages chosen at 1st level (rulesets/pf2e/languages.js)."
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/character"
    },
    {
      "$ref": "#/$defs/npc"
    }
  ]
}
