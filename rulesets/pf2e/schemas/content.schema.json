{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weberchad612-stack/Reliquary-VTT/schemas/rulesets/pf2e/content.schema.json",
  "title": "PF2E content",
  "description": "A piece of PF2E game content (content/pf2e/<source>/<folder>/<slug>.json, or a pack's content/<folder>/<slug>.json): a creature, hazard or vehicle stat block; an item; a feat or class feature, action, effect, condition or spell; an ancestry, heritage, background, class or deity; or a campaign feature. Physical items are kept under item/, every other kind in a folder of its own name (rulesets/pf2e/content.js). See docs/design/game-data.md.",
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z-]*$"
        },
        "selector": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "type": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "slug": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "when": {},
        "except": {
          "type": "string"
        },
        "range": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "acuity": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "outcome": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "damageType": {
          "type": "string"
        },
        "foundry": {
          "type": "object",
          "description": "An imported rule this ruleset does not support yet, kept as it was."
        },
        "option": {
          "type": "string"
        },
        "toggleable": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "domain": {
          "type": "string"
        },
        "add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dice": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "die": {
          "type": "string",
          "pattern": "^d(4|6|8|10|12|20)$"
        },
        "category": {
          "type": "string"
        },
        "critical": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "add",
            "remove"
          ]
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "adjust": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "keep": {
          "enum": [
            "higher",
            "lower"
          ]
        },
        "affects": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "onCreate": {
          "type": "boolean"
        },
        "onTurnStart": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "fast-healing",
            "regeneration"
          ]
        },
        "deactivatedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "radius": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "affects"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "affects": {
                "enum": [
                  "enemies",
                  "allies",
                  "all"
                ]
              },
              "save": {
                "type": "object"
              },
              "includesSelf": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "bright": {
          "type": "number"
        },
        "dim": {
          "type": "number"
        },
        "colour": {
          "type": "string"
        },
        "size": {
          "enum": [
            "tiny",
            "small",
            "medium",
            "large",
            "huge",
            "gargantuan"
          ]
        }
      },
      "additionalProperties": false,
      "description": "A rule element: the engine's keys (modifier, resistance, weakness, immunity, speed, sense, note) and PF2E's own (rulesets/pf2e/rule-keys.js), or an imported rule not supported yet (foundry)."
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "license"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "remaster": {
          "type": "boolean"
        }
      }
    },
    "creature": {
      "type": "object",
      "required": [
        "kind",
        "slug",
        "system",
        "name",
        "level",
        "stats",
        "source"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "const": "creature"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "system": {
          "const": "pf2e"
        },
        "name": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": -1,
          "maximum": 30
        },
        "size": {
          "enum": [
            "tiny",
            "small",
            "medium",
            "large",
            "huge",
            "gargantuan"
          ]
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "unique"
          ]
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "note": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "stats": {
          "type": "object",
          "required": [
            "ac",
            "hp"
          ],
          "properties": {
            "ac": {
              "type": "integer"
            },
            "hp": {
              "type": "integer",
              "minimum": 1
            },
            "perception": {
              "type": "integer"
            },
            "saves": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "str": {
                  "type": "integer"
                },
                "dex": {
                  "type": "integer"
                },
                "con": {
                  "type": "integer"
                },
                "int": {
                  "type": "integer"
                },
                "wis": {
                  "type": "integer"
                },
                "cha": {
                  "type": "integer"
                }
              }
            },
            "skills": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "object",
                    "required": [
                      "value"
                    ]
                  }
                ]
              }
            },
            "speeds": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "senses": {
              "type": "array"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "iwr": {
              "type": "object",
              "properties": {
                "immunities": {
                  "type": "array"
                },
                "weaknesses": {
                  "type": "array"
                },
                "resistances": {
                  "type": "array"
                }
              }
            },
            "notes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "items": {
          "$ref": "#/$defs/statBlockItems"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "retired": {
          "$ref": "#/$defs/retired"
        },
        "blurb": {
          "type": "string"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "kind",
        "slug",
        "system",
        "name",
        "source"
      ],
      "properties": {
        "$schema": {
          "type": "string"
