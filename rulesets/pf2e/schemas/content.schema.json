        "checkPenalty": {
          "type": "integer",
          "maximum": 0
        },
        "speedPenalty": {
          "type": "integer",
          "maximum": 0
        },
        "strength": {
          "type": [
            "integer",
            "null"
          ]
        },
        "hardness": {
          "type": "integer"
        },
        "hp": {
          "type": "integer"
        },
        "brokenAt": {
          "type": "integer"
        },
        "damage": {
          "type": "object",
          "properties": {
            "die": {
              "type": "string",
              "pattern": "^d(4|6|8|10|12)$"
            },
            "type": {
              "type": "string"
            },
            "dice": {
              "type": "integer"
            }
          }
        },
        "hands": {
          "type": [
            "integer",
            "string"
          ]
        },
        "range": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bulk": {
          "type": "number"
        },
        "price": {
          "type": "object"
        },
        "runes": {
          "type": "object"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "retired": {
          "$ref": "#/$defs/retired"
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "unique"
          ]
        },
        "reload": {
          "type": [
            "string",
            "integer"
          ]
        },
        "splash": {
          "type": "integer"
        },
        "bonusDamage": {
          "type": "integer"
        },
        "baseItem": {
          "type": "string"
        },
        "uses": {
          "type": "object"
        },
        "spell": {
          "$ref": "#/$defs/link"
        },
        "capacity": {
          "type": "number"
        },
        "ignored": {
          "type": "number"
        },
        "contents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "usage": {
          "type": "string"
        },
        "material": {
          "type": "object"
        },
        "durability": {
          "type": "object",
          "properties": {
            "hardness": {
              "type": "integer"
            },
            "hp": {
              "type": "integer"
            }
          }
        }
      }
    },
    "retired": {
      "type": "object",
      "description": "Foundry no longer has this document (removed, or renamed: replacedBy). Kept so saves that use it still load.",
      "required": [
        "since"
      ],
      "properties": {
        "since": {
          "type": "string"
        },
        "replacedBy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "description": "Another document: its name, and its content key when it was imported (<source>:<folder>/<slug>).",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "pattern": "^(?:[a-z0-9][a-z0-9-]*:)?[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
        },
        "level": {
          "type": "integer"
        },
        "rank": {
          "type": "integer"
        },
        "quantity": {
          "type": "integer"
        },
        "contents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "actions": {
      "description": "Actions to use: 1-3, reaction, free, or none (passive).",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        {
          "enum": [
            "reaction",
            "free",
            "passive"
          ]
        },
        {
          "type": "null"
        }
      ]
