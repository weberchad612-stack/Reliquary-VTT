        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "group": {
          "type": [
            "string",
